# build output (next build; out/ is the exported site)
.next/
out/
next-env.d.ts
*.tsbuildinfo
# images resized at build time by src/lib/images.ts
public/_img/

# test artifacts
playwright-report/
test-results/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables (Next.js also loads .env.local and
# .env.<mode>.local, and inlines NEXT_PUBLIC_* values into the export)
.env
.env.production
.env*.local

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# garden notes synced from the private Obsidian vault (pnpm garden:sync)
src/content/garden/
src/assets/garden/
.vault/
