---
// Built as dist/404.html, which GitHub Pages serves for unknown paths, so
// every URL here must be root-relative.
import BaseHead from "@components/BaseHead.astro";
import SiteHeader from "@components/SiteHeader.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Page not found - PePoDev"
      description="This page does not exist on pepo.dev. Head back to the desktop, the blog, or the resume."
      noindex
    />
    <style>
      /* The message fills whatever height the header leaves. */
      body {
        min-height: 100dvh;
        display: grid;
        grid-template-rows: auto 1fr;
      }

      .not-found {
        display: grid;
        place-items: center;
        padding: 48px 16px 64px;
        background: radial-gradient(
          circle at 15% 0%,
          color-mix(in srgb, var(--accent-primary) 14%, transparent),
          transparent 32rem
        );
      }

      .not-found-content {
        width: min(100%, 640px);
      }

      .not-found-eyebrow {
        margin-bottom: 14px;
        color: var(--accent-primary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        color: var(--text-primary);
        font-size: clamp(2.25rem, 6vw, 3.5rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
      }

      .not-found-lead {
        margin-top: 16px;
        color: var(--text-secondary);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .not-found-terminal {
        margin-top: 24px;
        padding: 14px 16px;
        overflow-x: auto;
        border: 1px solid var(--glass-border);
        border-radius: 10px;
        background: color-mix(in srgb, var(--bg-secondary) 70%, transparent);
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.8125rem;
        line-height: 1.7;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
      }

      .not-found-terminal .prompt {
        color: var(--accent-primary);
      }

      .not-found-terminal .error {
        color: var(--accent-red);
      }

      .not-found-links {
        display: flex;
        flex-wrap: wrap;
        gap: 10px 12px;
        margin-top: 28px;
      }

      .not-found-links a {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        padding: 0 18px;
        border: 1px solid var(--glass-border);
        border-radius: 999px;
        color: var(--text-primary);
        font-weight: 600;
        text-decoration: none;
      }

      .not-found-links a:first-child {
        border-color: var(--accent-primary);
        background: var(--accent-primary);
        color: #07110a;
      }

      .not-found-links a:hover {
        border-color: var(--accent-secondary);
      }

      .not-found-links a:focus-visible {
        outline: 3px solid var(--accent-secondary);
        outline-offset: 3px;
      }
    </style>
  </head>
  <body>
    <SiteHeader />
    <main class="not-found">
      <div class="not-found-content">
        <p class="not-found-eyebrow">HTTP 404</p>
        <h1>Page not found</h1>
        <p class="not-found-lead">
          There is nothing at this address. The page may have moved, or the
          link may have a typo.
        </p>
        <pre class="not-found-terminal"><span class="prompt">$</span> kubectl get page <span data-not-found-path>this-page</span>
<span class="error">Error from server (NotFound): page not found</span></pre>
        <nav class="not-found-links" aria-label="Pages on this site">
          <a href="/">Go to the home page</a>
          <a href="/blog/">Read the blog</a>
          <a href="/resume/">View the resume</a>
        </nav>
      </div>
    </main>
    <script>
      const path = document.querySelector("[data-not-found-path]");
      if (path) {
        let requested = location.pathname;
        try {
          requested = decodeURIComponent(requested);
        } catch {
          // Malformed escapes: show the path as requested.
        }
        path.textContent = requested;
      }
    </script>
  </body>
</html>
