---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";
import { getPostHeroImage, getPublishedPosts } from "@utils/blog";

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
      main {
        width: min(960px, 100% - 32px);
        margin: 0 auto;
        padding: 32px 0 64px;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(50% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li:first-child {
        width: 100%;
        margin-bottom: 1rem;
        text-align: center;
      }
      ul li:first-child .title {
        font-size: 2.369rem;
      }
      ul li img {
        display: block;
        width: 100%;
        height: auto;
        margin-bottom: 0.5rem;
        border-radius: 12px;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: var(--text-primary);
        line-height: 1.3;
      }
      .date {
        margin: 0;
        color: var(--text-secondary);
      }
      ul li a:hover h4,
      ul li a:hover .date {
        color: var(--accent-cyan);
      }
      ul a:hover img {
        box-shadow: var(--window-shadow);
      }
      @media (max-width: 720px) {
        ul {
          gap: 0.5em;
        }
        ul li {
          width: 100%;
          text-align: center;
        }
        ul li:first-child {
          margin-bottom: 0;
        }
        ul li:first-child .title {
          font-size: 1.563em;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <section>
        <ul>
          {
            posts.map((post, index) => {
              const { title, pubDate } = post.data;
              const heroImage = getPostHeroImage(post);
              return (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {heroImage && (
                      <Image
                        width={720}
                        height={360}
                        src={heroImage}
                        alt={`Cover image for ${title}`}
                        sizes={
                          index === 0
                            ? "(min-width: 992px) 960px, 100vw"
                            : "(min-width: 992px) 464px, (min-width: 721px) 50vw, 100vw"
                        }
                        loading="lazy"
                      />
                    )}
                    <h4 class="title">{title}</h4>
                    <p class="date">
                      <FormattedDate date={pubDate} />
                    </p>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>
  </body>
</html>
