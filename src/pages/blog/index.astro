---
import { Image } from "astro:assets";
import BaseHead from "../../components/BaseHead.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { BLOG_DESCRIPTION, BLOG_TITLE } from "../../consts";
import {
  getPostDescription,
  getPostHeroImage,
  getPostLanguage,
  getPublishedPosts,
} from "@utils/blog";

const posts = await getPublishedPosts();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={BLOG_TITLE} description={BLOG_DESCRIPTION} />
    <style>
      main {
        width: min(960px, 100% - 32px);
        margin: 0 auto;
        padding: 32px 0 64px;
      }
      .intro {
        margin-bottom: 2.5rem;
        text-align: center;
      }
      .intro h1 {
        color: var(--text-primary);
        font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
        line-height: 1.2;
      }
      .intro p {
        max-width: 640px;
        margin: 0.75rem auto 0;
        color: var(--text-secondary);
        line-height: 1.6;
      }
      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        list-style-type: none;
        margin: 0;
        padding: 0;
      }
      ul li {
        width: calc(50% - 1rem);
      }
      ul li * {
        text-decoration: none;
        transition: 0.2s ease;
      }
      ul li:first-child {
        width: 100%;
        margin-bottom: 1rem;
        text-align: center;
      }
      ul li:first-child .title {
        font-size: 2.369rem;
      }
      ul li img {
        display: block;
        width: 100%;
        height: auto;
        margin-bottom: 0.5rem;
        border-radius: 12px;
      }
      ul li a {
        display: block;
      }
      .title {
        margin: 0;
        color: var(--text-primary);
        font-size: 1.25rem;
        line-height: 1.3;
      }
      .description {
        margin: 0.35rem 0 0;
        color: var(--text-secondary);
        line-height: 1.5;
      }
      .date {
        margin: 0.35rem 0 0;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.875rem;
      }
      ul li a:hover .title,
      ul li a:hover .date {
        color: var(--accent-cyan);
      }
      ul a:hover img {
        box-shadow: var(--window-shadow);
      }
      ul a:focus-visible {
        outline: 3px solid var(--accent-secondary);
        outline-offset: 4px;
        border-radius: 12px;
      }
      @media (max-width: 720px) {
        ul {
          gap: 1.5rem;
        }
        ul li {
          width: 100%;
          text-align: center;
        }
        ul li:first-child {
          margin-bottom: 0;
        }
        ul li:first-child .title {
          font-size: 1.563em;
        }
      }
    </style>
  </head>
  <body>
    <SiteHeader width={960} />
    <main>
      <header class="intro">
        <h1>Engineering Blog</h1>
        <p>{BLOG_DESCRIPTION}</p>
      </header>
      <section aria-label="Posts">
        <ul>
          {
            posts.map((post, index) => {
              const { title, pubDate } = post.data;
              const description = getPostDescription(post);
              const lang = getPostLanguage(post);
              const heroImage = getPostHeroImage(post);
              return (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {/* Decorative: the title below names the link. */}
                    {heroImage && (
                      <Image
                        width={720}
                        height={360}
                        src={heroImage}
                        alt=""
                        sizes={
                          index === 0
                            ? "(min-width: 992px) 960px, 100vw"
                            : "(min-width: 992px) 464px, (min-width: 721px) 50vw, 100vw"
                        }
                        loading="lazy"
                      />
                    )}
                    <h2 class="title" lang={lang}>
                      {title}
                    </h2>
                    {description && (
                      <p class="description" lang={lang}>
                        {description}
                      </p>
                    )}
                    <p class="date">
                      <FormattedDate date={pubDate} />
                    </p>
                  </a>
                </li>
              );
            })
          }
        </ul>
      </section>
    </main>
  </body>
</html>
