---
import experiences from "../data/experiences.json";
import skills from "../data/skills.json";

const certifications = [
  "AWS Certified Solutions Architect - Associate",
  "HashiCorp Certified: Terraform Associate (002)",
  "Google Cloud Digital Leader",
  "Associate Cloud Engineer",
  "Professional Cloud Architect",
  "Certified Kubernetes Administrator (CKA)",
];

const resumePdfData = {
  name: "Thiwanon Chomcharoen (PePo)",
  title: "Site Reliability Engineer",
  contact: [
    "Bangkok, Thailand",
    "pepo@pepo.dev",
    "github.com/pepodev",
    "linkedin.com/in/pepodev",
  ],
  summary:
    "Site Reliability Engineer specializing in cloud infrastructure, Kubernetes platforms, observability, infrastructure as code, GitOps delivery, and reliability practices for production systems.",
  education: [
    "Bachelor Degrees, Computer Science",
    "King Mongkut's Institute of Technology Ladkrabang",
    "2016 - 2020",
  ],
  experiences,
  skills: skills.map((skill) => `${skill.name} - ${skill.level}%`),
  certifications,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Downloading Resume - PePoDev</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: linear-gradient(135deg, #0a0e27 0%, #1a1f3a 100%);
        color: #e5e7eb;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .container {
        text-align: center;
        padding: 2rem;
      }
      h1 {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: #64d2ff;
      }
      p {
        font-size: 1.125rem;
        opacity: 0.8;
        margin-bottom: 2rem;
      }
      .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid rgba(100, 210, 255, 0.2);
        border-top-color: #64d2ff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 2rem;
      }
      @keyframes spin {
        to {
          transform: rotate(360deg);
        }
      }
      a {
        color: #64d2ff;
        text-decoration: none;
        padding: 0.75rem 1.5rem;
        border: 1px solid #64d2ff;
        border-radius: 8px;
        display: inline-block;
        transition: all 0.2s;
      }
      a:hover {
        background: #64d2ff;
        color: #0a0e27;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="spinner"></div>
      <h1>Generating Resume...</h1>
      <p>Your download should start automatically.</p>
      <a href="/">← Back to Home</a>
    </div>

    <script define:vars={{ resumePdfData }} is:inline>
      // @ts-nocheck
      document.addEventListener("DOMContentLoaded", () => {
        try {
          const pdf = createResumePdf(resumePdfData);
          const url = URL.createObjectURL(
            new Blob([pdf], { type: "application/pdf" }),
          );
          const link = document.createElement("a");
          link.href = url;
          link.download = "pepo-resume.pdf";
          document.body.appendChild(link);
          link.click();
          link.remove();
          URL.revokeObjectURL(url);

          document.querySelector("h1").textContent = "Download Started!";
          document.querySelector("p").textContent =
            "Closing this page automatically...";

          // Auto-close after a short delay to ensure download starts
          setTimeout(() => {
            // Try to close the window (works if opened via window.open)
            window.close();

            // If close didn't work (most cases), navigate back
            setTimeout(() => {
              if (!document.hidden) {
                window.history.back();
              }
            }, 100);
          }, 1000);
        } catch (error) {
          document.querySelector("h1").textContent = "Download Failed";
          document.querySelector("p").textContent =
            "An error occurred while generating the PDF. Please try again.";
          console.error("PDF generation error:", error);
        }
      });

      function createResumePdf(data) {
        const width = 595;
        const height = 842;
        const marginX = 46;
        const bottomMargin = 46;
        const contentWidth = width - marginX * 2;
        const pages = [];
        let commands = [];
        let y = 792;

        function addPage() {
          if (commands.length) pages.push(commands.join("\n"));
          commands = [];
          y = 792;
        }

        function ensureSpace(requiredHeight) {
          if (y - requiredHeight < bottomMargin) addPage();
        }

        function drawText(text, x, textY, options = {}) {
          const size = options.size || 10;
          const font = options.bold ? "F2" : "F1";
          const color = options.color || "0.16 0.17 0.2";
          let textX = x;

          if (options.align === "center") {
            textX = x - getTextWidth(text, size, options.bold) / 2;
          } else if (options.align === "right") {
            textX = x - getTextWidth(text, size, options.bold);
          }

          commands.push(
            "BT",
            `/${font} ${size} Tf`,
            `${color} rg`,
            `${formatNumber(textX)} ${formatNumber(textY)} Td`,
            `(${escapePdfText(text)}) Tj`,
            "ET",
          );
        }

        function drawLine(x1, y1, x2, y2, shade = "0.86") {
          commands.push(
            `${shade} G`,
            "0.6 w",
            `${formatNumber(x1)} ${formatNumber(y1)} m`,
            `${formatNumber(x2)} ${formatNumber(y2)} l`,
            "S",
          );
        }

        function drawRect(
          x,
          rectY,
          rectWidth,
          rectHeight,
          fill = "0.96 0.97 0.98",
        ) {
          commands.push(
            `${fill} rg`,
            `${formatNumber(x)} ${formatNumber(rectY)} ${formatNumber(rectWidth)} ${formatNumber(rectHeight)} re`,
            "f",
          );
        }

        function drawSection(title) {
          ensureSpace(34);
          y -= 8;
          drawRect(marginX, y - 14, contentWidth, 18);
          drawText(title.toUpperCase(), width / 2, y - 9, {
            size: 10,
            align: "center",
            color: "0.18 0.19 0.22",
          });
          y -= 30;
        }

        function drawParagraph(text) {
          const lines = wrapPdfLine(text, contentWidth, 10);
          ensureSpace(lines.length * 12 + 6);
          lines.forEach((line) => {
            drawText(line, marginX, y, { size: 10 });
            y -= 12;
          });
          y -= 6;
        }

        function drawBulletList(items, maxItems) {
          items.slice(0, maxItems).forEach((item) => {
            const lines = wrapPdfLine(item, contentWidth - 22, 9.3);
            ensureSpace(lines.length * 11 + 2);
            drawText("-", marginX + 10, y, { size: 9.5 });
            lines.forEach((line, index) => {
              drawText(line, marginX + 24, y - index * 11, { size: 9.3 });
            });
            y -= lines.length * 11 + 2;
          });
        }

        drawText(data.name, width / 2, y, {
          size: 24,
          align: "center",
          color: "0.1 0.11 0.14",
        });
        y -= 17;
        drawText(data.title.toUpperCase(), width / 2, y, {
          size: 11,
          align: "center",
          color: "0.23 0.24 0.28",
        });
        y -= 11;
        drawLine(marginX, y, width - marginX, y, "0.88");
        y -= 14;
        drawText(data.contact.join(" - "), width / 2, y, {
          size: 8.5,
          align: "center",
          color: "0.3 0.31 0.35",
        });
        y -= 24;

        drawSection("Summary");
        drawParagraph(data.summary);

        drawSection("Experience");
        data.experiences.forEach((experience, index) => {
          ensureSpace(72);
          drawText(experience.role, marginX, y, { size: 10.2, bold: true });
          drawText(experience.period, width - marginX, y, {
            size: 9.3,
            align: "right",
          });
          y -= 12;
          drawText(experience.company, marginX, y, {
            size: 9.4,
            color: "0.32 0.33 0.37",
          });
          y -= 14;
          drawBulletList(experience.details, index === 0 ? 5 : 4);
          y -= 5;
        });

        drawSection("Technical Skills");
        const skillLines = splitIntoColumns(
          data.skills.map((skill) => skill.replace(/\s-\s\d+%$/, "")),
          2,
        );
        skillLines.forEach((row) => {
          ensureSpace(14);
          row.forEach((skill, index) => {
            drawText(skill, marginX + index * (contentWidth / 2), y, {
              size: 9.5,
            });
          });
          y -= 13;
        });
        y -= 8;

        drawSection("Education");
        ensureSpace(42);
        drawText(data.education[0], marginX, y, { size: 10.2, bold: true });
        drawText(data.education[2], width - marginX, y, {
          size: 9.3,
          align: "right",
        });
        y -= 12;
        drawText(data.education[1], marginX, y, {
          size: 9.4,
          color: "0.32 0.33 0.37",
        });
        y -= 24;

        drawSection("Certifications");
        drawBulletList(data.certifications, data.certifications.length);
        if (commands.length) pages.push(commands.join("\n"));

        const objects = [];
        const addObject = (body) => {
          objects.push(body);
          return objects.length;
        };

        const catalogId = addObject("<< /Type /Catalog /Pages 2 0 R >>");
        const pagesId = addObject("");
        const fontId = addObject(
          "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
        );
        const boldFontId = addObject(
          "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>",
        );
        const pageIds = [];

        pages.forEach((content) => {
          const contentId = addObject(
            `<< /Length ${content.length} >>\nstream\n${content}\nendstream`,
          );
          const pageId = addObject(
            [
              "<< /Type /Page",
              "/Parent 2 0 R",
              `/MediaBox [0 0 ${width} ${height}]`,
              `/Resources << /Font << /F1 ${fontId} 0 R /F2 ${boldFontId} 0 R >> >>`,
              `/Contents ${contentId} 0 R`,
              ">>",
            ].join("\n"),
          );
          pageIds.push(pageId);
        });

        objects[pagesId - 1] =
          `<< /Type /Pages /Kids [${pageIds.map((id) => `${id} 0 R`).join(" ")}] /Count ${pageIds.length} >>`;

        let pdf = "%PDF-1.4\n";
        const offsets = [0];
        objects.forEach((body, index) => {
          offsets.push(pdf.length);
          pdf += `${index + 1} 0 obj\n${body}\nendobj\n`;
        });

        const xrefOffset = pdf.length;
        pdf += `xref\n0 ${objects.length + 1}\n`;
        pdf += "0000000000 65535 f \n";
        offsets.slice(1).forEach((offset) => {
          pdf += `${String(offset).padStart(10, "0")} 00000 n \n`;
        });
        pdf += [
          "trailer",
          `<< /Size ${objects.length + 1} /Root ${catalogId} 0 R >>`,
          "startxref",
          String(xrefOffset),
          "%%EOF",
        ].join("\n");

        return pdf;
      }

      function wrapPdfLine(line, maxWidth = 503, fontSize = 10) {
        const normalized = normalizePdfText(line);
        if (getTextWidth(normalized, fontSize) <= maxWidth) return [normalized];
        const wrapped = [];
        const words = normalized.split(/\s+/);
        let current = "";

        words.forEach((word) => {
          const next = current ? `${current} ${word}` : word;
          if (current && getTextWidth(next, fontSize) > maxWidth) {
            wrapped.push(current);
            current = word;
          } else {
            current = next;
          }
        });

        if (current) wrapped.push(current);
        return wrapped;
      }

      function splitIntoColumns(items, columns) {
        const rows = [];
        for (let i = 0; i < items.length; i += columns) {
          rows.push(items.slice(i, i + columns));
        }
        return rows;
      }

      function getTextWidth(text, fontSize, bold = false) {
        return normalizePdfText(text).length * fontSize * (bold ? 0.56 : 0.51);
      }

      function formatNumber(value) {
        return Number(value)
          .toFixed(2)
          .replace(/\.?0+$/, "");
      }

      function normalizePdfText(value) {
        return String(value)
          .replace(/\u2122/g, "")
          .replace(/\u2022/g, "-")
          .replace(/[\u2013\u2014]/g, "-")
          .replace(/[^\x20-\x7e]/g, "");
      }

      function escapePdfText(value) {
        return normalizePdfText(value)
          .replace(/\\/g, "\\\\")
          .replace(/\(/g, "\\(")
          .replace(/\)/g, "\\)");
      }
    </script>
  </body>
</html>
