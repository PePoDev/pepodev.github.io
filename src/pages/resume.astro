---
import BaseHead from "@components/BaseHead.astro";
import certifications from "@data/certifications.json";
import experiences from "@data/experiences.json";
import skills from "@data/skills.json";
import "@styles/website-mode.css";

const contactLinks = [
  { label: "Bangkok, Thailand" },
  { label: "pepo@pepo.dev", href: "mailto:pepo@pepo.dev" },
  { label: "github.com/pepodev", href: "https://github.com/pepodev" },
  { label: "linkedin.com/in/pepodev", href: "https://linkedin.com/in/pepodev" },
];

// Listed as earned history so lapsed certifications never read as current.
const earnedCertifications = certifications.map((certification) => ({
  ...certification,
  earnedYear: certification.issueDate.slice(0, 4),
}));

const resumePdfData = {
  name: "Thiwanon Chomcharoen (PePo)",
  title: "Site Reliability Engineer",
  contact: contactLinks.map(({ label }) => label),
  summary:
    "Site Reliability Engineer specializing in cloud infrastructure, Kubernetes platforms, observability, infrastructure as code, GitOps delivery, and reliability practices for production systems.",
  education: [
    "Bachelor Degrees, Computer Science",
    "King Mongkut's Institute of Technology Ladkrabang",
    "2016 - 2020",
  ],
  experiences,
  skills: skills.map((skill) => `${skill.name} - ${skill.level}%`),
  certifications: earnedCertifications.map(
    ({ name, earnedYear }) => `${name}, earned ${earnedYear}`,
  ),
};

const [degree, school, educationPeriod] = resumePdfData.education;
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="resume-document">
  <head>
    <BaseHead
      title={`Resume - ${resumePdfData.name}`}
      description="Resume of Thiwanon Chomcharoen (PePo), a Site Reliability Engineer in Bangkok: experience, technical skills, education, and certifications, with a PDF download."
    />
    <style>
      .resume-page {
        --website-content-width: 920px;
      }

      .resume-main {
        width: min(calc(100% - 32px), var(--website-content-width));
        margin-inline: auto;
        padding-block: clamp(40px, 7vw, 72px);
      }

      .resume-intro {
        padding-bottom: 40px;
      }

      .resume-intro h1 {
        font-size: clamp(2.25rem, 6vw, 3.75rem);
        line-height: 1.04;
        letter-spacing: -0.04em;
      }

      .resume-title {
        margin-top: 10px;
        color: var(--accent-secondary);
        font-size: clamp(1.1rem, 2.4vw, 1.4rem);
        font-weight: 700;
      }

      .resume-contact {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 18px;
        margin-top: 18px;
        list-style: none;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.85rem;
      }

      .resume-page a {
        text-underline-offset: 3px;
      }

      .resume-contact a,
      .resume-certifications a {
        color: var(--text-primary);
      }

      .resume-summary {
        max-width: 720px;
        margin-top: 22px;
        color: var(--text-secondary);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .resume-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 16px;
        margin-top: 28px;
      }

      .resume-download {
        cursor: pointer;
        font-family: inherit;
        font-size: 1rem;
      }

      .resume-download-status {
        color: var(--text-secondary);
        font-size: 0.9rem;
      }

      .resume-section {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 32px;
        padding-block: 32px;
        border-top: 1px solid var(--glass-border);
      }

      .resume-section h2 {
        color: var(--accent-primary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        line-height: 1.9;
        text-transform: uppercase;
      }

      .resume-entries {
        display: grid;
        gap: 28px;
      }

      .resume-entry-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 4px 16px;
      }

      .resume-entry h3 {
        font-size: 1.15rem;
      }

      .resume-period,
      .resume-provider {
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }

      .resume-org {
        margin-top: 4px;
        color: var(--text-secondary);
        font-weight: 700;
      }

      .resume-entry ul {
        display: grid;
        gap: 7px;
        margin-top: 14px;
        padding-left: 20px;
        color: var(--text-secondary);
        line-height: 1.55;
      }

      .resume-certifications {
        display: grid;
        gap: 14px;
        list-style: none;
        line-height: 1.5;
      }

      .resume-certifications a {
        font-weight: 700;
      }

      .resume-earned {
        color: var(--text-secondary);
      }

      .resume-download[hidden] {
        display: none;
      }

      .resume-provider {
        display: block;
      }

      @media (max-width: 720px) {
        .resume-section {
          grid-template-columns: 1fr;
          gap: 16px;
        }
      }

      @media print {
        :global(html.resume-document) {
          --bg-primary: #fff;
          --text-primary: #111;
          --text-secondary: #444;
          --accent-primary: #111;
          --accent-secondary: #333;
          --glass-border: #ccc;
        }

        .resume-page {
          background: none;
        }

        .website-header,
        .resume-actions,
        .website-footer {
          display: none;
        }

        .resume-main {
          width: auto;
          padding: 0;
        }

        .resume-page a {
          text-decoration: none;
        }

        .resume-entry,
        .resume-certifications li {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <div class="website-shell resume-page">
      <a class="website-skip-link" href="#resume-main">Skip to content</a>

      <header class="website-header">
        <div class="website-header-inner">
          <a class="website-brand" href="/">PePoDev</a>
        </div>
      </header>

      <main id="resume-main" class="resume-main">
        <header class="resume-intro">
          <p class="website-eyebrow">Resume</p>
          <h1>{resumePdfData.name}</h1>
          <p class="resume-title">{resumePdfData.title}</p>
          <ul class="resume-contact" aria-label="Contact">
            {
              contactLinks.map(({ label, href }) => (
                <li>{href ? <a href={href}>{label}</a> : label}</li>
              ))
            }
          </ul>
          <p class="resume-summary">{resumePdfData.summary}</p>
          <div class="resume-actions">
            <button
              type="button"
              class="website-button website-button--primary resume-download"
              data-resume-download
              hidden
            >
              Download PDF
            </button>
            <p
              class="resume-download-status"
              role="status"
              data-resume-download-status
            >
            </p>
          </div>
        </header>

        <section class="resume-section" aria-labelledby="resume-experience">
          <h2 id="resume-experience">Experience</h2>
          <div class="resume-entries">
            {
              experiences.map((experience) => (
                <article class="resume-entry">
                  <div class="resume-entry-heading">
                    <h3>{experience.role}</h3>
                    <p class="resume-period">{experience.period}</p>
                  </div>
                  <p class="resume-org">{experience.company}</p>
                  <ul>
                    {experience.details.map((detail) => (
                      <li>{detail}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </section>

        <section class="resume-section" aria-labelledby="resume-skills">
          <h2 id="resume-skills">Technical Skills</h2>
          <ul class="website-skills">
            {skills.map((skill) => <li>{skill.name}</li>)}
          </ul>
        </section>

        <section class="resume-section" aria-labelledby="resume-education">
          <h2 id="resume-education">Education</h2>
          <div class="resume-entry">
            <div class="resume-entry-heading">
              <h3>{degree}</h3>
              <p class="resume-period">{educationPeriod}</p>
            </div>
            <p class="resume-org">{school}</p>
          </div>
        </section>

        <section class="resume-section" aria-labelledby="resume-certifications">
          <h2 id="resume-certifications">Certifications</h2>
          <ul class="resume-certifications">
            {
              earnedCertifications.map((certification) => (
                <li>
                  <a
                    href={certification.credlyUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >{certification.name}</a><span class="resume-earned"
                    >, earned {certification.earnedYear}</span
                  >
                  <span class="resume-provider">{certification.provider}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </main>

      <footer class="website-footer">
        <p>© {currentYear} PePoDev. Built as a static Astro site.</p>
      </footer>
    </div>

    <script define:vars={{ resumePdfData }} is:inline>
      // @ts-nocheck
      const downloadButton = document.querySelector("[data-resume-download]");
      const downloadStatus = document.querySelector(
        "[data-resume-download-status]",
      );
      // The PDF is generated client-side, so only offer it once JS runs.
      downloadButton.hidden = false;

      downloadButton.addEventListener("click", () => {
        try {
          const pdf = createResumePdf(resumePdfData);
          const url = URL.createObjectURL(
            new Blob([pdf], { type: "application/pdf" }),
          );
          const link = document.createElement("a");
          link.href = url;
          link.download = "pepo-resume.pdf";
          document.body.appendChild(link);
          link.click();
          link.remove();
          // Revoking right after click() can cancel the download in some browsers.
          setTimeout(() => URL.revokeObjectURL(url), 60000);

          downloadStatus.textContent = "Download started.";
        } catch (error) {
          downloadStatus.textContent =
            "Could not generate the PDF. Please try again.";
          console.error("PDF generation error:", error);
        }
      });

      function createResumePdf(data) {
        const width = 595;
        const height = 842;
        const marginX = 46;
        const bottomMargin = 46;
        const contentWidth = width - marginX * 2;
        const pages = [];
        let commands = [];
        let y = 792;

        function addPage() {
          if (commands.length) pages.push(commands.join("\n"));
          commands = [];
          y = 792;
        }

        function ensureSpace(requiredHeight) {
          if (y - requiredHeight < bottomMargin) addPage();
        }

        function drawText(text, x, textY, options = {}) {
          const size = options.size || 10;
          const font = options.bold ? "F2" : "F1";
          const color = options.color || "0.16 0.17 0.2";
          let textX = x;

          if (options.align === "center") {
            textX = x - getTextWidth(text, size, options.bold) / 2;
          } else if (options.align === "right") {
            textX = x - getTextWidth(text, size, options.bold);
          }

          commands.push(
            "BT",
            `/${font} ${size} Tf`,
            `${color} rg`,
            `${formatNumber(textX)} ${formatNumber(textY)} Td`,
            `(${escapePdfText(text)}) Tj`,
            "ET",
          );
        }

        function drawLine(x1, y1, x2, y2, shade = "0.86") {
          commands.push(
            `${shade} G`,
            "0.6 w",
            `${formatNumber(x1)} ${formatNumber(y1)} m`,
            `${formatNumber(x2)} ${formatNumber(y2)} l`,
            "S",
          );
        }

        function drawRect(
          x,
          rectY,
          rectWidth,
          rectHeight,
          fill = "0.96 0.97 0.98",
        ) {
          commands.push(
            `${fill} rg`,
            `${formatNumber(x)} ${formatNumber(rectY)} ${formatNumber(rectWidth)} ${formatNumber(rectHeight)} re`,
            "f",
          );
        }

        function drawSection(title) {
          ensureSpace(34);
          y -= 8;
          drawRect(marginX, y - 14, contentWidth, 18);
          drawText(title.toUpperCase(), width / 2, y - 9, {
            size: 10,
            align: "center",
            color: "0.18 0.19 0.22",
          });
          y -= 30;
        }

        function drawParagraph(text) {
          const lines = wrapPdfLine(text, contentWidth, 10);
          ensureSpace(lines.length * 12 + 6);
          lines.forEach((line) => {
            drawText(line, marginX, y, { size: 10 });
            y -= 12;
          });
          y -= 6;
        }

        function drawBulletList(items, maxItems) {
          items.slice(0, maxItems).forEach((item) => {
            const lines = wrapPdfLine(item, contentWidth - 22, 9.3);
            ensureSpace(lines.length * 11 + 2);
            drawText("-", marginX + 10, y, { size: 9.5 });
            lines.forEach((line, index) => {
              drawText(line, marginX + 24, y - index * 11, { size: 9.3 });
            });
            y -= lines.length * 11 + 2;
          });
        }

        drawText(data.name, width / 2, y, {
          size: 24,
          align: "center",
          color: "0.1 0.11 0.14",
        });
        y -= 17;
        drawText(data.title.toUpperCase(), width / 2, y, {
          size: 11,
          align: "center",
          color: "0.23 0.24 0.28",
        });
        y -= 11;
        drawLine(marginX, y, width - marginX, y, "0.88");
        y -= 14;
        drawText(data.contact.join(" - "), width / 2, y, {
          size: 8.5,
          align: "center",
          color: "0.3 0.31 0.35",
        });
        y -= 24;

        drawSection("Summary");
        drawParagraph(data.summary);

        drawSection("Experience");
        data.experiences.forEach((experience, index) => {
          ensureSpace(72);
          drawText(experience.role, marginX, y, { size: 10.2, bold: true });
          drawText(experience.period, width - marginX, y, {
            size: 9.3,
            align: "right",
          });
          y -= 12;
          drawText(experience.company, marginX, y, {
            size: 9.4,
            color: "0.32 0.33 0.37",
          });
          y -= 14;
          drawBulletList(experience.details, index === 0 ? 5 : 4);
          y -= 5;
        });

        drawSection("Technical Skills");
        const skillLines = splitIntoColumns(
          data.skills.map((skill) => skill.replace(/\s-\s\d+%$/, "")),
          2,
        );
        skillLines.forEach((row) => {
          ensureSpace(14);
          row.forEach((skill, index) => {
            drawText(skill, marginX + index * (contentWidth / 2), y, {
              size: 9.5,
            });
          });
          y -= 13;
        });
        y -= 8;

        drawSection("Education");
        ensureSpace(42);
        drawText(data.education[0], marginX, y, { size: 10.2, bold: true });
        drawText(data.education[2], width - marginX, y, {
          size: 9.3,
          align: "right",
        });
        y -= 12;
        drawText(data.education[1], marginX, y, {
          size: 9.4,
          color: "0.32 0.33 0.37",
        });
        y -= 24;

        drawSection("Certifications");
        drawBulletList(data.certifications, data.certifications.length);
        if (commands.length) pages.push(commands.join("\n"));

        const objects = [];
        const addObject = (body) => {
          objects.push(body);
          return objects.length;
        };

        const catalogId = addObject("<< /Type /Catalog /Pages 2 0 R >>");
        const pagesId = addObject("");
        const fontId = addObject(
          "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>",
        );
        const boldFontId = addObject(
          "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold >>",
        );
        const pageIds = [];

        pages.forEach((content) => {
          const contentId = addObject(
            `<< /Length ${content.length} >>\nstream\n${content}\nendstream`,
          );
          const pageId = addObject(
            [
              "<< /Type /Page",
              "/Parent 2 0 R",
              `/MediaBox [0 0 ${width} ${height}]`,
              `/Resources << /Font << /F1 ${fontId} 0 R /F2 ${boldFontId} 0 R >> >>`,
              `/Contents ${contentId} 0 R`,
              ">>",
            ].join("\n"),
          );
          pageIds.push(pageId);
        });

        objects[pagesId - 1] =
          `<< /Type /Pages /Kids [${pageIds.map((id) => `${id} 0 R`).join(" ")}] /Count ${pageIds.length} >>`;

        let pdf = "%PDF-1.4\n";
        const offsets = [0];
        objects.forEach((body, index) => {
          offsets.push(pdf.length);
          pdf += `${index + 1} 0 obj\n${body}\nendobj\n`;
        });

        const xrefOffset = pdf.length;
        pdf += `xref\n0 ${objects.length + 1}\n`;
        pdf += "0000000000 65535 f \n";
        offsets.slice(1).forEach((offset) => {
          pdf += `${String(offset).padStart(10, "0")} 00000 n \n`;
        });
        pdf += [
          "trailer",
          `<< /Size ${objects.length + 1} /Root ${catalogId} 0 R >>`,
          "startxref",
          String(xrefOffset),
          "%%EOF",
        ].join("\n");

        return pdf;
      }

      function wrapPdfLine(line, maxWidth = 503, fontSize = 10) {
        const normalized = normalizePdfText(line);
        if (getTextWidth(normalized, fontSize) <= maxWidth) return [normalized];
        const wrapped = [];
        const words = normalized.split(/\s+/);
        let current = "";

        words.forEach((word) => {
          const next = current ? `${current} ${word}` : word;
          if (current && getTextWidth(next, fontSize) > maxWidth) {
            wrapped.push(current);
            current = word;
          } else {
            current = next;
          }
        });

        if (current) wrapped.push(current);
        return wrapped;
      }

      function splitIntoColumns(items, columns) {
        const rows = [];
        for (let i = 0; i < items.length; i += columns) {
          rows.push(items.slice(i, i + columns));
        }
        return rows;
      }

      function getTextWidth(text, fontSize, bold = false) {
        return normalizePdfText(text).length * fontSize * (bold ? 0.56 : 0.51);
      }

      function formatNumber(value) {
        return Number(value)
          .toFixed(2)
          .replace(/\.?0+$/, "");
      }

      function normalizePdfText(value) {
        return String(value)
          .replace(/\u2122/g, "")
          .replace(/\u2022/g, "-")
          .replace(/[\u2013\u2014]/g, "-")
          .replace(/[^\x20-\x7e]/g, "");
      }

      function escapePdfText(value) {
        return normalizePdfText(value)
          .replace(/\\/g, "\\\\")
          .replace(/\(/g, "\\(")
          .replace(/\)/g, "\\)");
      }
    </script>
  </body>
</html>
