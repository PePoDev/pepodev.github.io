---
import AboutApp from "../components/apps/AboutApp.astro";
import BlogApp from "../components/apps/BlogApp.astro";
import CalculatorApp from "../components/apps/CalculatorApp.astro";
import CertificationsWalletApp from "../components/apps/CertificationsWalletApp.astro";
import GalleryApp from "../components/apps/GalleryApp.astro";
import MusicPlayerApp from "../components/apps/MusicPlayerApp.astro";
import ProjectsApp from "../components/apps/ProjectsApp.astro";
import SettingsApp from "../components/apps/SettingsApp.astro";
import SnakeApp from "../components/apps/SnakeApp.astro";
import SreGameApp from "../components/apps/SreGameApp.astro";
import TerminalApp from "../components/apps/TerminalApp.astro";
import TrashBinApp from "../components/apps/TrashBinApp.astro";
import WelcomeApp from "../components/apps/WelcomeApp.astro";
import WhiteNoiseApp from "../components/apps/WhiteNoiseApp.astro";
import WorkApp from "../components/apps/WorkApp.astro";
import DesktopIcon from "../components/desktop/DesktopIcon.astro";
import ExternalLinkIcon from "../components/desktop/ExternalLinkIcon.astro";
import CommandPalette from "../components/desktop/CommandPalette.astro";
import StartMenu from "../components/desktop/StartMenu.astro";
import Taskbar from "../components/desktop/Taskbar.astro";
import Window from "../components/desktop/Window.astro";
import BaseHead from "../components/BaseHead.astro";
import SiteModeController from "../components/SiteModeController.astro";
import WebsiteMode from "../components/WebsiteMode.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import socialLinks from "../data/social-links.json";
---

<!doctype html>
<html lang="en" data-site-mode="desktop">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <SiteModeController />
  </head>
  <body>
    <div
      id="desktop"
      data-site-mode-panel="desktop"
      aria-hidden="false"
    >
      <canvas id="bg-canvas"></canvas>

      <div id="desktop-icons">
        <DesktopIcon
          appId="me"
          label="About Me"
          data-default-col="0"
          data-default-row="0"
        />
        <DesktopIcon
          appId="blog"
          label="Blog"
          data-default-col="1"
          data-default-row="0"
        />
        <DesktopIcon
          appId="work"
          label="Work"
          data-default-col="2"
          data-default-row="0"
        />
        <DesktopIcon
          appId="project"
          label="Projects"
          data-default-col="3"
          data-default-row="0"
        />
        <DesktopIcon
          appId="certs"
          label="Certs"
          data-default-col="4"
          data-default-row="0"
        />
        <DesktopIcon
          appId="welcome"
          label="Welcome"
          data-default-col="center"
          data-default-row="0"
        />
        <DesktopIcon
          appId="sregame"
          label="SRE Game"
          data-default-col="0"
          data-default-row="4"
          data-layout-group="left-mid"
          data-layout-index="0"
        />
        <DesktopIcon
          appId="snake"
          label="Snake"
          data-default-col="0"
          data-default-row="5"
          data-layout-group="left-mid"
          data-layout-index="1"
        />
        <DesktopIcon
          appId="gallery"
          label="Gallery"
          data-default-col="3"
          data-default-row="bottom"
        />
        <DesktopIcon
          appId="music"
          label="Music"
          data-default-col="0"
          data-default-row="bottom"
        />
        <DesktopIcon
          appId="whitenoise"
          label="Noise"
          data-default-col="4"
          data-default-row="bottom"
        />
        <DesktopIcon
          appId="calculator"
          label="Calculator"
          data-default-col="1"
          data-default-row="bottom"
        />
        <DesktopIcon
          appId="trash"
          label="Trash"
          data-default-col="2"
          data-default-row="bottom"
        />
        <DesktopIcon
          appId="terminal"
          label="Terminal"
          data-default-col="center"
          data-default-row="bottom"
        />
        <DesktopIcon
          appId="settings"
          label="Settings"
          data-default-col="right"
          data-default-row="bottom"
        />
      </div>

      <!-- External Link Shortcuts -->
      <div id="desktop-links" aria-label="External shortcuts">
        {
          socialLinks.map((link, index) => (
            <ExternalLinkIcon
              id={`link-${link.icon}`}
              iconName={link.icon}
              label={link.label.split(" - ")[0]}
              href={link.href}
              data-shortcut-index={link.icon === "webring" ? 0 : index + 1}
            />
          ))
        }
      </div>

      <div id="windows-container">
        <Window
          appId="welcome"
          title="Welcome - Login"
          width={680}
          height={600}
        >
          <WelcomeApp />
        </Window>
        <Window appId="blog" title="Blog - Articles" width={700} height={520}>
          <BlogApp />
        </Window>
        <Window
          appId="project"
          title="Projects - Showcase"
          width={700}
          height={500}
        >
          <ProjectsApp />
        </Window>
        <Window appId="work" title="Work - Experience" width={680} height={540}>
          <WorkApp />
        </Window>
        <Window appId="me" title="About Me" width={600} height={560}>
          <AboutApp />
        </Window>
        <Window
          appId="sregame"
          title="SRE Game - Taming Chaos"
          width={800}
          height={600}
        >
          <SreGameApp />
        </Window>
        <Window appId="snake" title="Snake" width={560} height={680}>
          <SnakeApp />
        </Window>
        <Window appId="music" title="Music Player" width={560} height={490}>
          <MusicPlayerApp />
        </Window>
        <Window appId="whitenoise" title="White Noise" width={480} height={540}>
          <WhiteNoiseApp />
        </Window>
        <Window appId="calculator" title="Calculator" width={360} height={520}>
          <CalculatorApp />
        </Window>
        <Window appId="settings" title="Settings" width={620} height={560}>
          <SettingsApp />
        </Window>
        <Window appId="terminal" title="Terminal" width={720} height={480}>
          <TerminalApp />
        </Window>
        <Window appId="certs" title="Certifications" width={700} height={520}>
          <CertificationsWalletApp />
        </Window>
        <Window appId="gallery" title="Gallery" width={680} height={560}>
          <GalleryApp />
        </Window>
        <Window appId="trash" title="Trash Bin" width={680} height={520}>
          <TrashBinApp />
        </Window>
      </div>

      <StartMenu />
      <Taskbar />
      <CommandPalette />

      <!-- Toast Notification -->
      <div id="toast-container" aria-live="polite" aria-atomic="true"></div>
    </div>

    <WebsiteMode />

    <script is:inline>
      // @ts-nocheck
      // Initialize theme immediately to prevent flash
      (function () {
        let savedPrefs = {};
        try {
          savedPrefs = JSON.parse(
            localStorage.getItem("pepodev.desktopPrefs") || "{}",
          );
        } catch {
          savedPrefs = {};
        }
        const savedTheme =
          savedPrefs.theme || localStorage.getItem("pepodev.theme") || "dark";
        const accentMap = {
          green: { primary: "#30d158", secondary: "#64d2ff" },
          cyan: { primary: "#64d2ff", secondary: "#30d158" },
          purple: { primary: "#bf5af2", secondary: "#64d2ff" },
          amber: { primary: "#ff9f0a", secondary: "#64d2ff" },
        };
        const backgroundMap = {
          network: {
            bg: "#0a0e17",
            primary: "34, 197, 94",
            secondary: "6, 182, 212",
          },
          aurora: {
            bg: "#07111f",
            primary: "20, 184, 166",
            secondary: "168, 85, 247",
          },
          midnight: {
            bg: "#101018",
            primary: "99, 102, 241",
            secondary: "14, 165, 233",
          },
          ember: {
            bg: "#170d0a",
            primary: "245, 158, 11",
            secondary: "239, 68, 68",
          },
          ocean: {
            bg: "#0a1420",
            primary: "0, 191, 255",
            secondary: "64, 224, 208",
          },
          glacier: {
            bg: "#0f1419",
            primary: "176, 224, 230",
            secondary: "127, 255, 212",
          },
          void: {
            bg: "#0d0d0f",
            primary: "147, 112, 219",
            secondary: "100, 149, 237",
          },
          neon: {
            bg: "#1a0b2e",
            primary: "255, 20, 147",
            secondary: "0, 255, 255",
          },
          plasma: {
            bg: "#0e0520",
            primary: "138, 43, 226",
            secondary: "30, 144, 255",
          },
          storm: {
            bg: "#1c1c24",
            primary: "224, 255, 255",
            secondary: "70, 130, 180",
          },
          matrix: {
            bg: "#0d0208",
            primary: "0, 255, 65",
            secondary: "50, 205, 50",
          },
          sakura: {
            bg: "#1a0f1f",
            primary: "255, 183, 197",
            secondary: "221, 160, 221",
          },
          forest: {
            bg: "#0a1409",
            primary: "34, 139, 34",
            secondary: "124, 252, 0",
          },
          sunset: {
            bg: "#1f1108",
            primary: "255, 140, 0",
            secondary: "255, 105, 180",
          },
          copper: {
            bg: "#18100d",
            primary: "184, 115, 51",
            secondary: "205, 127, 50",
          },
          // Light theme backgrounds
          cloud: {
            bg: "#f0f4f8",
            primary: "100, 149, 237",
            secondary: "135, 206, 235",
          },
          daylight: {
            bg: "#fef9e7",
            primary: "255, 193, 7",
            secondary: "255, 152, 0",
          },
          mint: {
            bg: "#f0fdf4",
            primary: "52, 211, 153",
            secondary: "16, 185, 129",
          },
          peach: {
            bg: "#fff5f0",
            primary: "255, 159, 64",
            secondary: "255, 127, 80",
          },
          sky: {
            bg: "#e0f2fe",
            primary: "14, 165, 233",
            secondary: "56, 189, 248",
          },
          lavender: {
            bg: "#f5f3ff",
            primary: "167, 139, 250",
            secondary: "196, 181, 253",
          },
          cream: {
            bg: "#fefce8",
            primary: "234, 179, 8",
            secondary: "250, 204, 21",
          },
          rose: {
            bg: "#fff1f2",
            primary: "251, 113, 133",
            secondary: "244, 63, 94",
          },
          sage: {
            bg: "#f0fdf4",
            primary: "74, 222, 128",
            secondary: "134, 239, 172",
          },
          coral: {
            bg: "#fff7ed",
            primary: "251, 146, 60",
            secondary: "249, 115, 22",
          },
          powder: {
            bg: "#ecfeff",
            primary: "6, 182, 212",
            secondary: "34, 211, 238",
          },
          lemon: {
            bg: "#fefce8",
            primary: "250, 204, 21",
            secondary: "253, 224, 71",
          },
          blush: {
            bg: "#fce7f3",
            primary: "236, 72, 153",
            secondary: "244, 114, 182",
          },
          seafoam: {
            bg: "#ecfdf5",
            primary: "16, 185, 129",
            secondary: "52, 211, 153",
          },
          sand: {
            bg: "#fef3c7",
            primary: "217, 119, 6",
            secondary: "245, 158, 11",
          },
        };
        const accent = accentMap[savedPrefs.accent] || accentMap.green;
        const defaultBg =
          savedTheme === "light" ? backgroundMap.cloud : backgroundMap.network;
        const background = backgroundMap[savedPrefs.background] || defaultBg;
        document.documentElement.setAttribute("data-theme", savedTheme);
        document.documentElement.style.setProperty(
          "--accent-primary",
          accent.primary,
        );
        document.documentElement.style.setProperty(
          "--accent-secondary",
          accent.secondary,
        );
        document.documentElement.style.setProperty(
          "--accent-green",
          accent.primary,
        );
        document.documentElement.style.setProperty(
          "--accent-cyan",
          accent.secondary,
        );
        document.documentElement.style.setProperty(
          "--window-radius",
          (savedPrefs.radius || 12) + "px",
        );
        document.documentElement.style.setProperty(
          "--glass-bg",
          "rgba(" +
            (savedTheme === "light" ? "255, 255, 255" : "44, 44, 46") +
            ", " +
            (savedPrefs.glass || 72) / 100 +
            ")",
        );
        document.documentElement.style.setProperty(
          "--desktop-bg-color",
          background.bg,
        );
        document.documentElement.style.setProperty(
          "--particle-primary-rgb",
          background.primary,
        );
        document.documentElement.style.setProperty(
          "--particle-secondary-rgb",
          background.secondary,
        );
        document.documentElement.setAttribute(
          "data-background-effect",
          savedPrefs.backgroundEffect === false ? "off" : "on",
        );
        document.documentElement.setAttribute(
          "data-window-glass",
          savedPrefs.windowGlass === false ? "off" : "on",
        );
      })();

      document.addEventListener("DOMContentLoaded", () => {
        function initParticleNetwork() {
          const canvas = document.getElementById("bg-canvas");
          if (!canvas) return;
          const ctx = canvas.getContext("2d");
          const connectionDist = 180;
          const particles = [];
          const pulses = [];
          const audioRings = [];
          const ambientBlobs = [];
          const count = 70;
          let desktopPrefs = {};
          let musicAudio = {
            playing: false,
            low: 0,
            mid: 0,
            high: 0,
            energy: 0,
          };
          let smoothedAudio = { low: 0, mid: 0, high: 0, energy: 0 };
          let lastAudioRingAt = 0;
          let backgroundEffectEnabled = true;
          let animationId = 0;
          let siteMode =
            document.documentElement.dataset.siteMode === "website"
              ? "website"
              : "desktop";

          function getCssVar(name, fallback) {
            return (
              getComputedStyle(document.documentElement)
                .getPropertyValue(name)
                .trim() || fallback
            );
          }

          function readDesktopPrefs() {
            desktopPrefs = {
              bg: getCssVar("--desktop-bg-color", "#0a0e17"),
              primary: getCssVar("--particle-primary-rgb", "34, 197, 94"),
              secondary: getCssVar("--particle-secondary-rgb", "6, 182, 212"),
            };
          }

          function readBackgroundEffectPref() {
            try {
              const prefs = JSON.parse(
                localStorage.getItem("pepodev.desktopPrefs") || "{}",
              );
              backgroundEffectEnabled = prefs.backgroundEffect !== false;
            } catch {
              backgroundEffectEnabled = true;
            }
            document.documentElement.setAttribute(
              "data-background-effect",
              backgroundEffectEnabled ? "on" : "off",
            );
          }

          function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
          }

          resize();
          readDesktopPrefs();
          readBackgroundEffectPref();
          window.addEventListener("resize", resize);
          document.addEventListener("desktop:preferences", (event) => {
            readDesktopPrefs();
            backgroundEffectEnabled = event.detail?.backgroundEffect !== false;
            document.documentElement.setAttribute(
              "data-background-effect",
              backgroundEffectEnabled ? "on" : "off",
            );
            syncAnimation();
          });
          document.addEventListener("site:mode-change", (event) => {
            siteMode =
              event.detail?.mode === "website" ? "website" : "desktop";
            if (siteMode === "desktop") resize();
            syncAnimation();
          });
          document.addEventListener("visibilitychange", syncAnimation);
          document.addEventListener("desktop:music-audio-frame", (event) => {
            const detail = event.detail || {};
            musicAudio = {
              playing: Boolean(detail.playing),
              low: Math.max(0, Math.min(1, detail.low || 0)),
              mid: Math.max(0, Math.min(1, detail.mid || 0)),
              high: Math.max(0, Math.min(1, detail.high || 0)),
              energy: Math.max(0, Math.min(1, detail.energy || 0)),
            };
          });

          for (let i = 0; i < 4; i++) {
            ambientBlobs.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              r: 150 + Math.random() * 200,
              vx: (Math.random() - 0.5) * 0.15,
              vy: (Math.random() - 0.5) * 0.15,
              color: Math.random() < 0.3 ? "cyan" : "green",
              alpha: 0.015 + Math.random() * 0.02,
            });
          }

          for (let i = 0; i < count; i++) {
            const isHub = Math.random() < 0.1;
            particles.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              vx: (Math.random() - 0.5) * (isHub ? 0.2 : 0.4),
              vy: (Math.random() - 0.5) * (isHub ? 0.2 : 0.4),
              r: isHub ? 3 + Math.random() * 2 : Math.random() * 2 + 1,
              isHub,
              color: Math.random() < 0.15 ? "cyan" : "green",
              pulseTimer: Math.random() * 300,
              glowPhase: Math.random() * Math.PI * 2,
              glowSpeed: 0.01 + Math.random() * 0.02,
            });
          }

          let time = 0;

          function draw() {
            ctx.fillStyle = desktopPrefs.bg;
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            time += 0.016;
            smoothedAudio.low += (musicAudio.low - smoothedAudio.low) * 0.16;
            smoothedAudio.mid += (musicAudio.mid - smoothedAudio.mid) * 0.12;
            smoothedAudio.high += (musicAudio.high - smoothedAudio.high) * 0.18;
            smoothedAudio.energy +=
              (musicAudio.energy - smoothedAudio.energy) * 0.14;
            const audioEnergy = musicAudio.playing ? smoothedAudio.energy : 0;
            const lowEnergy = musicAudio.playing ? smoothedAudio.low : 0;
            const midEnergy = musicAudio.playing ? smoothedAudio.mid : 0;
            const highEnergy = musicAudio.playing ? smoothedAudio.high : 0;
            const reactiveConnectionDist = connectionDist + audioEnergy * 95;

            ambientBlobs.forEach((blob) => {
              blob.x += blob.vx * (1 + midEnergy * 2.4);
              blob.y += blob.vy * (1 + midEnergy * 2.4);
              if (blob.x < -blob.r) blob.x = canvas.width + blob.r;
              if (blob.x > canvas.width + blob.r) blob.x = -blob.r;
              if (blob.y < -blob.r) blob.y = canvas.height + blob.r;
              if (blob.y > canvas.height + blob.r) blob.y = -blob.r;

              const grad = ctx.createRadialGradient(
                blob.x,
                blob.y,
                0,
                blob.x,
                blob.y,
                blob.r,
              );
              const color =
                blob.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              grad.addColorStop(
                0,
                "rgba(" +
                  color +
                  ", " +
                  (blob.alpha + audioEnergy * 0.045) +
                  ")",
              );
              grad.addColorStop(1, "rgba(" + color + ", 0)");
              ctx.fillStyle = grad;
              ctx.fillRect(
                blob.x - blob.r,
                blob.y - blob.r,
                blob.r * 2,
                blob.r * 2,
              );
            });

            particles.forEach((particle) => {
              const audioDrift =
                musicAudio.playing && particle.isHub
                  ? Math.sin(time * 2 + particle.glowPhase) * lowEnergy * 0.35
                  : 0;
              particle.x += particle.vx * (1 + highEnergy * 3.8) + audioDrift;
              particle.y +=
                particle.vy * (1 + highEnergy * 3.8) + audioDrift * 0.45;
              if (particle.x < 0) particle.x = canvas.width;
              if (particle.x > canvas.width) particle.x = 0;
              if (particle.y < 0) particle.y = canvas.height;
              if (particle.y > canvas.height) particle.y = 0;

              particle.pulseTimer -= 1 + audioEnergy * 3.5;
              if (particle.pulseTimer <= 0) {
                particle.pulseTimer = particle.isHub
                  ? 30 + Math.random() * 80
                  : 100 + Math.random() * 400 - audioEnergy * 120;
                let nearest = null;
                let nearestDist = Infinity;

                particles.forEach((other) => {
                  if (other === particle) return;
                  const distance = Math.hypot(
                    other.x - particle.x,
                    other.y - particle.y,
                  );
                  if (
                    distance < reactiveConnectionDist &&
                    distance < nearestDist
                  ) {
                    nearest = other;
                    nearestDist = distance;
                  }
                });

                if (nearest) {
                  pulses.push({
                    x: particle.x,
                    y: particle.y,
                    tx: nearest.x,
                    ty: nearest.y,
                    progress: 0,
                    speed: 0.02 + Math.random() * 0.03 + audioEnergy * 0.035,
                    color: particle.color,
                    audioBoost: audioEnergy,
                    trail: [],
                  });
                }
              }
            });

            if (
              musicAudio.playing &&
              lowEnergy > 0.42 &&
              time - lastAudioRingAt > 0.18
            ) {
              lastAudioRingAt = time;
              const source =
                particles[Math.floor(Math.random() * particles.length)];
              if (source) {
                audioRings.push({
                  x: source.x,
                  y: source.y,
                  radius: 8,
                  alpha: 0.22 + lowEnergy * 0.45,
                  speed: 3.5 + lowEnergy * 8,
                  color: source.color,
                });
              }
            }

            for (let i = 0; i < particles.length; i++) {
              for (let j = i + 1; j < particles.length; j++) {
                const distance = Math.hypot(
                  particles[i].x - particles[j].x,
                  particles[i].y - particles[j].y,
                );
                if (distance < reactiveConnectionDist) {
                  const alpha =
                    (1 - distance / reactiveConnectionDist) *
                    (0.22 + audioEnergy * 0.42);
                  ctx.strokeStyle =
                    "rgba(" + desktopPrefs.primary + ", " + alpha + ")";
                  ctx.lineWidth = 1 + audioEnergy * 1.4;
                  ctx.beginPath();
                  ctx.moveTo(particles[i].x, particles[i].y);
                  ctx.lineTo(particles[j].x, particles[j].y);
                  ctx.stroke();
                }
              }
            }

            for (let i = pulses.length - 1; i >= 0; i--) {
              const pulse = pulses[i];
              pulse.progress += pulse.speed;
              if (pulse.progress >= 1) {
                pulses.splice(i, 1);
                continue;
              }

              const px = pulse.x + (pulse.tx - pulse.x) * pulse.progress;
              const py = pulse.y + (pulse.ty - pulse.y) * pulse.progress;
              pulse.trail.push({ x: px, y: py });
              if (pulse.trail.length > 8) pulse.trail.shift();

              for (let t = 0; t < pulse.trail.length; t++) {
                const trailAlpha = (t / pulse.trail.length) * 0.8;
                const trailR =
                  1 + (t / pulse.trail.length) * (2 + pulse.audioBoost * 5);
                const baseColor =
                  pulse.color === "cyan"
                    ? desktopPrefs.secondary
                    : desktopPrefs.primary;
                ctx.beginPath();
                ctx.arc(
                  pulse.trail[t].x,
                  pulse.trail[t].y,
                  trailR,
                  0,
                  Math.PI * 2,
                );
                ctx.fillStyle =
                  "rgba(" +
                  baseColor +
                  ", " +
                  trailAlpha *
                    (1 - pulse.progress * 0.5) *
                    (1 + pulse.audioBoost) +
                  ")";
                ctx.fill();
              }

              const baseColor =
                pulse.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              const glowGrad = ctx.createRadialGradient(px, py, 0, px, py, 12);
              glowGrad.addColorStop(
                0,
                "rgba(" +
                  baseColor +
                  ", " +
                  (0.6 + pulse.audioBoost * 0.35) * (1 - pulse.progress) +
                  ")",
              );
              glowGrad.addColorStop(1, "rgba(" + baseColor + ", 0)");
              ctx.fillStyle = glowGrad;
              ctx.beginPath();
              ctx.arc(px, py, 12, 0, Math.PI * 2);
              ctx.fill();
            }

            for (let i = audioRings.length - 1; i >= 0; i--) {
              const ring = audioRings[i];
              ring.radius += ring.speed;
              ring.alpha *= 0.94;
              if (ring.alpha < 0.015 || ring.radius > 220) {
                audioRings.splice(i, 1);
                continue;
              }
              const baseColor =
                ring.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              ctx.beginPath();
              ctx.arc(ring.x, ring.y, ring.radius, 0, Math.PI * 2);
              ctx.strokeStyle = "rgba(" + baseColor + ", " + ring.alpha + ")";
              ctx.lineWidth = 1.5 + lowEnergy * 3;
              ctx.stroke();
            }

            particles.forEach((particle) => {
              const glowPulse =
                Math.sin(time * particle.glowSpeed * 60 + particle.glowPhase) *
                  0.3 +
                0.7;
              const baseColor =
                particle.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              const glowR =
                (particle.isHub ? 20 : 10) *
                (1 + audioEnergy * (particle.isHub ? 2.1 : 1.25));
              const glowGrad = ctx.createRadialGradient(
                particle.x,
                particle.y,
                0,
                particle.x,
                particle.y,
                glowR,
              );
              glowGrad.addColorStop(
                0,
                "rgba(" +
                  baseColor +
                  ", " +
                  (0.3 * glowPulse + audioEnergy * 0.28) +
                  ")",
              );
              glowGrad.addColorStop(1, "rgba(" + baseColor + ", 0)");
              ctx.fillStyle = glowGrad;
              ctx.beginPath();
              ctx.arc(particle.x, particle.y, glowR, 0, Math.PI * 2);
              ctx.fill();
              ctx.beginPath();
              ctx.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
              ctx.fillStyle =
                "rgba(" +
                baseColor +
                ", " +
                (0.6 * glowPulse + 0.2 + highEnergy * 0.38) +
                ")";
              ctx.fill();
            });

            const vignetteGrad = ctx.createRadialGradient(
              canvas.width / 2,
              canvas.height / 2,
              canvas.height * 0.3,
              canvas.width / 2,
              canvas.height / 2,
              canvas.height * 0.9,
            );
            vignetteGrad.addColorStop(0, "rgba(10, 14, 23, 0)");
            vignetteGrad.addColorStop(1, "rgba(10, 14, 23, 0.7)");
            ctx.fillStyle = vignetteGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            animationId = requestAnimationFrame(draw);
          }

          function shouldAnimate() {
            return (
              backgroundEffectEnabled &&
              siteMode === "desktop" &&
              !document.hidden
            );
          }

          function startAnimation() {
            if (animationId || !shouldAnimate()) return;
            draw();
          }

          function pauseAnimation() {
            if (!animationId) return;
            cancelAnimationFrame(animationId);
            animationId = 0;
          }

          function syncAnimation() {
            if (shouldAnimate()) {
              startAnimation();
            } else {
              pauseAnimation();
            }
          }

          syncAnimation();
        }

        initParticleNetwork();
      });
    </script>

    <script is:inline>
      // @ts-nocheck
      // Toast Notification System
      document.addEventListener("DOMContentLoaded", () => {
        const toastContainer = document.getElementById("toast-container");
        if (!toastContainer) return;

        function showToast(message, duration = 5000) {
          const toast = document.createElement("div");
          toast.className = "toast";
          toast.innerHTML = `
            <div class="toast-content">
              <span class="toast-icon">💡</span>
              <span class="toast-message">${message}</span>
            </div>
            <button class="toast-close" aria-label="Close notification">✕</button>
          `;

          toastContainer.appendChild(toast);

          // Trigger animation
          setTimeout(() => toast.classList.add("toast-show"), 10);

          // Close button handler
          const closeBtn = toast.querySelector(".toast-close");
          closeBtn.addEventListener("click", () => dismissToast(toast));

          // Auto-dismiss after duration (if duration is set)
          if (duration && duration > 0) {
            const timeoutId = setTimeout(() => dismissToast(toast), duration);
            // Store timeout ID for manual dismissal
            toast.dataset.timeoutId = timeoutId;
          }
        }

        function dismissToast(toast) {
          if (toast.dataset.timeoutId) {
            clearTimeout(Number(toast.dataset.timeoutId));
          }
          toast.classList.remove("toast-show");
          toast.classList.add("toast-hide");
          setTimeout(() => toast.remove(), 300);
        }

        // Listen for custom toast events
        document.addEventListener("desktop:show-toast", (event) => {
          const { message, duration } = event.detail || {};
          showToast(message, duration);
        });

        // Show command palette hint on first visit or periodically
        const hintKey = "pepodev.commandPaletteHintShown";
        let hintTimerId = 0;

        function scheduleCommandPaletteHint() {
          const isMobile = window.matchMedia("(max-width: 768px)").matches;
          const isDesktopMode =
            document.documentElement.dataset.siteMode === "desktop";
          if (isMobile || !isDesktopMode || hintTimerId) return;

          const lastShown = localStorage.getItem(hintKey);
          const now = Date.now();
          const daysSinceLastShown = lastShown
            ? (now - Number(lastShown)) / (1000 * 60 * 60 * 24)
            : Infinity;
          if (lastShown && daysSinceLastShown <= 7) return;

          hintTimerId = window.setTimeout(() => {
            hintTimerId = 0;
            if (document.documentElement.dataset.siteMode !== "desktop") return;

            const isMac = navigator.platform.toUpperCase().includes("MAC");
            const key = isMac ? "Cmd" : "Ctrl";
            showToast(
              `Quick tip: Press <kbd>${key} + K</kbd> to open the command palette`,
              0,
            );
            localStorage.setItem(hintKey, String(Date.now()));
          }, 3000);
        }

        scheduleCommandPaletteHint();
        document.addEventListener("site:mode-change", (event) => {
          if (event.detail?.mode === "desktop") {
            scheduleCommandPaletteHint();
            return;
          }

          if (hintTimerId) {
            clearTimeout(hintTimerId);
            hintTimerId = 0;
          }
        });

        // URL Deep Linking - Handle blog post URLs
        const urlParams = new URLSearchParams(window.location.search);
        const blogSlug = (urlParams.get("blog") || "").trim();

        if (blogSlug) {
          const openBlogDeepLink = () => {
            const blogWindow = document.querySelector('[data-app-id="blog"]');
            if (!blogWindow) {
              console.warn("Blog window not found for deep link");
              return;
            }

            let warnedMissingPost = false;
            let warnedMissingHandler = false;

            const maximizeBlogWindow = () => {
              if (blogWindow.classList.contains("maximized")) return;

              const maximizeBtn = blogWindow.querySelector(".max-btn");
              if (maximizeBtn) {
                maximizeBtn.click();
              }
            };

            const openArticle = () => {
              if (typeof window.__pepodevBlogOpenSlug !== "function") {
                return false;
              }

              const opened = window.__pepodevBlogOpenSlug(blogSlug);
              if (!opened && !warnedMissingPost) {
                console.warn(`Blog post with slug "${blogSlug}" not found`);
                warnedMissingPost = true;
              }

              return opened;
            };

            document.dispatchEvent(
              new CustomEvent("desktop:open-app", {
                detail: { appId: "blog" },
              }),
            );

            const startedAt = Date.now();
            const retryOpenArticle = () => {
              if (blogWindow.getAttribute("aria-hidden") === "false") {
                maximizeBlogWindow();
              }

              if (openArticle()) return;

              if (Date.now() - startedAt < 5000) {
                setTimeout(retryOpenArticle, 100);
                return;
              }

              if (
                typeof window.__pepodevBlogOpenSlug !== "function" &&
                !warnedMissingHandler
              ) {
                console.error("Blog open function not available");
                warnedMissingHandler = true;
              }
            };

            retryOpenArticle();
          };

          // Wait for window manager to be ready
          const checkWindowManager = setInterval(() => {
            if (window.__pepodevWindowManagerReady) {
              clearInterval(checkWindowManager);
              openBlogDeepLink();
            }
          }, 50);

          // Safety timeout - clear interval after 5 seconds
          setTimeout(() => clearInterval(checkWindowManager), 5000);
        }
      });
    </script>
  </body>
</html>
