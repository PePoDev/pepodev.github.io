---
import AboutApp from "../components/apps/AboutApp.astro";
import ArchitectureViewerApp from "../components/apps/ArchitectureViewerApp.astro";
import BlogApp from "../components/apps/BlogApp.astro";
import CalculatorApp from "../components/apps/CalculatorApp.astro";
import CertificationsWalletApp from "../components/apps/CertificationsWalletApp.astro";
import DeploySimulatorApp from "../components/apps/DeploySimulatorApp.astro";
import IncidentTimelineApp from "../components/apps/IncidentTimelineApp.astro";
import MetricsDashboardApp from "../components/apps/MetricsDashboardApp.astro";
import MusicPlayerApp from "../components/apps/MusicPlayerApp.astro";
import ProjectsApp from "../components/apps/ProjectsApp.astro";
import ResumeApp from "../components/apps/ResumeApp.astro";
import RunbookApp from "../components/apps/RunbookApp.astro";
import SettingsApp from "../components/apps/SettingsApp.astro";
import SreGameApp from "../components/apps/SreGameApp.astro";
import SystemMonitorApp from "../components/apps/SystemMonitorApp.astro";
import TerminalApp from "../components/apps/TerminalApp.astro";
import WelcomeApp from "../components/apps/WelcomeApp.astro";
import WorkApp from "../components/apps/WorkApp.astro";
import DesktopIcon from "../components/desktop/DesktopIcon.astro";
import ExternalLinkIcon from "../components/desktop/ExternalLinkIcon.astro";
import CommandPalette from "../components/desktop/CommandPalette.astro";
import StartMenu from "../components/desktop/StartMenu.astro";
import Taskbar from "../components/desktop/Taskbar.astro";
import Window from "../components/desktop/Window.astro";
import BaseHead from "../components/BaseHead.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import socialLinks from "../data/social-links.json";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <div id="desktop">
      <canvas id="bg-canvas"></canvas>

      <div id="desktop-icons">
        <DesktopIcon appId="welcome" label="Welcome" />
        <DesktopIcon appId="blog" label="Blog" />
        <DesktopIcon appId="resume" label="Resume" />
        <DesktopIcon appId="project" label="Projects" />
        <DesktopIcon appId="work" label="Work" />
        <DesktopIcon appId="me" label="About Me" />
        <DesktopIcon appId="sregame" label="SRE Game" />
        <DesktopIcon appId="music" label="Music" />
        <DesktopIcon appId="calculator" label="Calculator" />
        <DesktopIcon appId="settings" label="Settings" />
        <DesktopIcon appId="terminal" label="Terminal" />
        <DesktopIcon appId="incidents" label="Incidents" />
        <DesktopIcon appId="metrics" label="Metrics" />
        <DesktopIcon appId="architecture" label="Architecture" />
        <DesktopIcon appId="runbook" label="Runbook" />
        <DesktopIcon appId="certs" label="Certs" />
        <DesktopIcon appId="deploysim" label="Deploy Sim" />
        <DesktopIcon appId="monitor" label="Monitor" />
      </div>

      <!-- External Link Shortcuts -->
      {
        socialLinks.map((link, index) => (
          <ExternalLinkIcon
            id={`link-${link.icon}`}
            iconName={link.icon}
            label={link.label.split(" - ")[0]}
            href={link.href}
            data-shortcut-index={index}
          />
        ))
      }

      <div id="windows-container">
        <Window
          appId="welcome"
          title="Welcome - Login"
          width={680}
          height={600}
        >
          <WelcomeApp />
        </Window>
        <Window appId="blog" title="Blog - Articles" width={700} height={520}>
          <BlogApp />
        </Window>
        <Window appId="resume" title="Resume - CV" width={650} height={580}>
          <ResumeApp />
        </Window>
        <Window
          appId="project"
          title="Projects - Showcase"
          width={700}
          height={500}
        >
          <ProjectsApp />
        </Window>
        <Window appId="work" title="Work - Experience" width={680} height={540}>
          <WorkApp />
        </Window>
        <Window appId="me" title="About Me" width={600} height={560}>
          <AboutApp />
        </Window>
        <Window
          appId="sregame"
          title="SRE Game - Taming Chaos"
          width={800}
          height={600}
        >
          <SreGameApp />
        </Window>
        <Window appId="music" title="Music Player" width={460} height={520}>
          <MusicPlayerApp />
        </Window>
        <Window appId="calculator" title="Calculator" width={360} height={520}>
          <CalculatorApp />
        </Window>
        <Window appId="settings" title="Settings" width={620} height={560}>
          <SettingsApp />
        </Window>
        <Window appId="terminal" title="Terminal" width={720} height={480}>
          <TerminalApp />
        </Window>
        <Window appId="incidents" title="Incident Timeline" width={720} height={560}>
          <IncidentTimelineApp />
        </Window>
        <Window appId="metrics" title="Metrics Dashboard" width={760} height={560}>
          <MetricsDashboardApp />
        </Window>
        <Window appId="architecture" title="Architecture Viewer" width={760} height={560}>
          <ArchitectureViewerApp />
        </Window>
        <Window appId="runbook" title="Runbook" width={700} height={560}>
          <RunbookApp />
        </Window>
        <Window appId="certs" title="Certifications Wallet" width={700} height={520}>
          <CertificationsWalletApp />
        </Window>
        <Window appId="deploysim" title="Deploy Simulator" width={700} height={500}>
          <DeploySimulatorApp />
        </Window>
        <Window appId="monitor" title="System Monitor" width={620} height={500}>
          <SystemMonitorApp />
        </Window>
      </div>

      <StartMenu />
      <Taskbar />
      <CommandPalette />
    </div>

    <script is:inline>
      // @ts-nocheck
      // Initialize theme immediately to prevent flash
      (function () {
        let savedPrefs = {};
        try {
          savedPrefs = JSON.parse(
            localStorage.getItem("pepodev.desktopPrefs") || "{}",
          );
        } catch {
          savedPrefs = {};
        }
        const savedTheme =
          savedPrefs.theme || localStorage.getItem("pepodev.theme") || "dark";
        const accentMap = {
          green: { primary: "#30d158", secondary: "#64d2ff" },
          cyan: { primary: "#64d2ff", secondary: "#30d158" },
          purple: { primary: "#bf5af2", secondary: "#64d2ff" },
          amber: { primary: "#ff9f0a", secondary: "#64d2ff" },
        };
        const backgroundMap = {
          network: {
            bg: "#0a0e17",
            primary: "34, 197, 94",
            secondary: "6, 182, 212",
          },
          aurora: {
            bg: "#07111f",
            primary: "20, 184, 166",
            secondary: "168, 85, 247",
          },
          midnight: {
            bg: "#101018",
            primary: "99, 102, 241",
            secondary: "14, 165, 233",
          },
          ember: {
            bg: "#170d0a",
            primary: "245, 158, 11",
            secondary: "239, 68, 68",
          },
        };
        const accent = accentMap[savedPrefs.accent] || accentMap.green;
        const background =
          backgroundMap[savedPrefs.background] || backgroundMap.network;
        document.documentElement.setAttribute("data-theme", savedTheme);
        document.documentElement.style.setProperty(
          "--accent-green",
          accent.primary,
        );
        document.documentElement.style.setProperty(
          "--accent-cyan",
          accent.secondary,
        );
        document.documentElement.style.setProperty(
          "--window-radius",
          (savedPrefs.radius || 12) + "px",
        );
        document.documentElement.style.setProperty(
          "--glass-bg",
          "rgba(" +
            (savedTheme === "light" ? "255, 255, 255" : "44, 44, 46") +
            ", " +
            (savedPrefs.glass || 72) / 100 +
            ")",
        );
        document.documentElement.style.setProperty(
          "--desktop-bg-color",
          background.bg,
        );
        document.documentElement.style.setProperty(
          "--particle-primary-rgb",
          background.primary,
        );
        document.documentElement.style.setProperty(
          "--particle-secondary-rgb",
          background.secondary,
        );
      })();

      document.addEventListener("DOMContentLoaded", () => {
        function initParticleNetwork() {
          const canvas = document.getElementById("bg-canvas");
          if (!canvas) return;
          const ctx = canvas.getContext("2d");
          const connectionDist = 180;
          const particles = [];
          const pulses = [];
          const ambientBlobs = [];
          const count = 70;
          let desktopPrefs = {};

          function getCssVar(name, fallback) {
            return (
              getComputedStyle(document.documentElement)
                .getPropertyValue(name)
                .trim() || fallback
            );
          }

          function readDesktopPrefs() {
            desktopPrefs = {
              bg: getCssVar("--desktop-bg-color", "#0a0e17"),
              primary: getCssVar("--particle-primary-rgb", "34, 197, 94"),
              secondary: getCssVar("--particle-secondary-rgb", "6, 182, 212"),
            };
          }

          function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
          }

          resize();
          readDesktopPrefs();
          window.addEventListener("resize", resize);
          document.addEventListener("desktop:preferences", readDesktopPrefs);

          for (let i = 0; i < 4; i++) {
            ambientBlobs.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              r: 150 + Math.random() * 200,
              vx: (Math.random() - 0.5) * 0.15,
              vy: (Math.random() - 0.5) * 0.15,
              color: Math.random() < 0.3 ? "cyan" : "green",
              alpha: 0.015 + Math.random() * 0.02,
            });
          }

          for (let i = 0; i < count; i++) {
            const isHub = Math.random() < 0.1;
            particles.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              vx: (Math.random() - 0.5) * (isHub ? 0.2 : 0.4),
              vy: (Math.random() - 0.5) * (isHub ? 0.2 : 0.4),
              r: isHub ? 3 + Math.random() * 2 : Math.random() * 2 + 1,
              isHub,
              color: Math.random() < 0.15 ? "cyan" : "green",
              pulseTimer: Math.random() * 300,
              glowPhase: Math.random() * Math.PI * 2,
              glowSpeed: 0.01 + Math.random() * 0.02,
            });
          }

          let time = 0;

          function draw() {
            ctx.fillStyle = desktopPrefs.bg;
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            time += 0.016;

            ambientBlobs.forEach((blob) => {
              blob.x += blob.vx;
              blob.y += blob.vy;
              if (blob.x < -blob.r) blob.x = canvas.width + blob.r;
              if (blob.x > canvas.width + blob.r) blob.x = -blob.r;
              if (blob.y < -blob.r) blob.y = canvas.height + blob.r;
              if (blob.y > canvas.height + blob.r) blob.y = -blob.r;

              const grad = ctx.createRadialGradient(
                blob.x,
                blob.y,
                0,
                blob.x,
                blob.y,
                blob.r,
              );
              const color =
                blob.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              grad.addColorStop(0, "rgba(" + color + ", " + blob.alpha + ")");
              grad.addColorStop(1, "rgba(" + color + ", 0)");
              ctx.fillStyle = grad;
              ctx.fillRect(
                blob.x - blob.r,
                blob.y - blob.r,
                blob.r * 2,
                blob.r * 2,
              );
            });

            particles.forEach((particle) => {
              particle.x += particle.vx;
              particle.y += particle.vy;
              if (particle.x < 0) particle.x = canvas.width;
              if (particle.x > canvas.width) particle.x = 0;
              if (particle.y < 0) particle.y = canvas.height;
              if (particle.y > canvas.height) particle.y = 0;

              particle.pulseTimer--;
              if (particle.pulseTimer <= 0) {
                particle.pulseTimer = particle.isHub
                  ? 30 + Math.random() * 80
                  : 100 + Math.random() * 400;
                let nearest = null;
                let nearestDist = Infinity;

                particles.forEach((other) => {
                  if (other === particle) return;
                  const distance = Math.hypot(
                    other.x - particle.x,
                    other.y - particle.y,
                  );
                  if (distance < connectionDist && distance < nearestDist) {
                    nearest = other;
                    nearestDist = distance;
                  }
                });

                if (nearest) {
                  pulses.push({
                    x: particle.x,
                    y: particle.y,
                    tx: nearest.x,
                    ty: nearest.y,
                    progress: 0,
                    speed: 0.02 + Math.random() * 0.03,
                    color: particle.color,
                    trail: [],
                  });
                }
              }
            });

            for (let i = 0; i < particles.length; i++) {
              for (let j = i + 1; j < particles.length; j++) {
                const distance = Math.hypot(
                  particles[i].x - particles[j].x,
                  particles[i].y - particles[j].y,
                );
                if (distance < connectionDist) {
                  const alpha = (1 - distance / connectionDist) * 0.3;
                  ctx.strokeStyle =
                    "rgba(" + desktopPrefs.primary + ", " + alpha + ")";
                  ctx.lineWidth = 1;
                  ctx.beginPath();
                  ctx.moveTo(particles[i].x, particles[i].y);
                  ctx.lineTo(particles[j].x, particles[j].y);
                  ctx.stroke();
                }
              }
            }

            for (let i = pulses.length - 1; i >= 0; i--) {
              const pulse = pulses[i];
              pulse.progress += pulse.speed;
              if (pulse.progress >= 1) {
                pulses.splice(i, 1);
                continue;
              }

              const px = pulse.x + (pulse.tx - pulse.x) * pulse.progress;
              const py = pulse.y + (pulse.ty - pulse.y) * pulse.progress;
              pulse.trail.push({ x: px, y: py });
              if (pulse.trail.length > 8) pulse.trail.shift();

              for (let t = 0; t < pulse.trail.length; t++) {
                const trailAlpha = (t / pulse.trail.length) * 0.8;
                const trailR = 1 + (t / pulse.trail.length) * 2;
                const baseColor =
                  pulse.color === "cyan"
                    ? desktopPrefs.secondary
                    : desktopPrefs.primary;
                ctx.beginPath();
                ctx.arc(
                  pulse.trail[t].x,
                  pulse.trail[t].y,
                  trailR,
                  0,
                  Math.PI * 2,
                );
                ctx.fillStyle =
                  "rgba(" +
                  baseColor +
                  ", " +
                  trailAlpha * (1 - pulse.progress * 0.5) +
                  ")";
                ctx.fill();
              }

              const baseColor =
                pulse.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              const glowGrad = ctx.createRadialGradient(px, py, 0, px, py, 12);
              glowGrad.addColorStop(
                0,
                "rgba(" + baseColor + ", " + 0.6 * (1 - pulse.progress) + ")",
              );
              glowGrad.addColorStop(1, "rgba(" + baseColor + ", 0)");
              ctx.fillStyle = glowGrad;
              ctx.beginPath();
              ctx.arc(px, py, 12, 0, Math.PI * 2);
              ctx.fill();
            }

            particles.forEach((particle) => {
              const glowPulse =
                Math.sin(time * particle.glowSpeed * 60 + particle.glowPhase) *
                  0.3 +
                0.7;
              const baseColor =
                particle.color === "cyan"
                  ? desktopPrefs.secondary
                  : desktopPrefs.primary;
              const glowR = particle.isHub ? 20 : 10;
              const glowGrad = ctx.createRadialGradient(
                particle.x,
                particle.y,
                0,
                particle.x,
                particle.y,
                glowR,
              );
              glowGrad.addColorStop(
                0,
                "rgba(" + baseColor + ", " + 0.3 * glowPulse + ")",
              );
              glowGrad.addColorStop(1, "rgba(" + baseColor + ", 0)");
              ctx.fillStyle = glowGrad;
              ctx.beginPath();
              ctx.arc(particle.x, particle.y, glowR, 0, Math.PI * 2);
              ctx.fill();
              ctx.beginPath();
              ctx.arc(particle.x, particle.y, particle.r, 0, Math.PI * 2);
              ctx.fillStyle =
                "rgba(" + baseColor + ", " + (0.6 * glowPulse + 0.2) + ")";
              ctx.fill();
            });

            const vignetteGrad = ctx.createRadialGradient(
              canvas.width / 2,
              canvas.height / 2,
              canvas.height * 0.3,
              canvas.width / 2,
              canvas.height / 2,
              canvas.height * 0.9,
            );
            vignetteGrad.addColorStop(0, "rgba(10, 14, 23, 0)");
            vignetteGrad.addColorStop(1, "rgba(10, 14, 23, 0.7)");
            ctx.fillStyle = vignetteGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            requestAnimationFrame(draw);
          }

          draw();
        }

        initParticleNetwork();
      });
    </script>
  </body>
</html>
