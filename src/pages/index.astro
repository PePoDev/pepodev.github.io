---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { blogPosts, projects, experiences, skills } from '../content/apps';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <script define:vars={{ blogPosts, projects, experiences, skills }}>
      window.__APP_DATA__ = { blogPosts, projects, experiences, skills };
    </script>
    <div id="desktop">
      <canvas id="bg-canvas"></canvas>

      <div id="desktop-icons">
        <div class="desktop-icon" data-app="blog">
          <svg viewBox="0 0 40 40" fill="none">
            <rect x="4" y="2" width="32" height="36" rx="3" fill="#1e293b" stroke="#22c55e" stroke-width="1.5"/>
            <line x1="10" y1="10" x2="30" y2="10" stroke="#22c55e" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="10" y1="15" x2="26" y2="15" stroke="#4ade80" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
            <line x1="10" y1="19" x2="28" y2="19" stroke="#4ade80" stroke-width="1" stroke-linecap="round" opacity="0.4"/>
            <line x1="10" y1="23" x2="22" y2="23" stroke="#4ade80" stroke-width="1" stroke-linecap="round" opacity="0.3"/>
            <rect x="10" y="28" width="8" height="6" rx="1" fill="#22c55e" opacity="0.3"/>
          </svg>
          <span>Blog</span>
        </div>
        <div class="desktop-icon" data-app="resume">
          <svg viewBox="0 0 40 40" fill="none">
            <rect x="8" y="2" width="24" height="36" rx="2" fill="#1e293b" stroke="#06b6d4" stroke-width="1.5"/>
            <circle cx="20" cy="12" r="4" stroke="#06b6d4" stroke-width="1.2"/>
            <line x1="14" y1="22" x2="26" y2="22" stroke="#06b6d4" stroke-width="1" stroke-linecap="round" opacity="0.6"/>
            <line x1="14" y1="26" x2="24" y2="26" stroke="#06b6d4" stroke-width="1" stroke-linecap="round" opacity="0.4"/>
            <line x1="14" y1="30" x2="22" y2="30" stroke="#06b6d4" stroke-width="1" stroke-linecap="round" opacity="0.3"/>
          </svg>
          <span>Resume</span>
        </div>
        <div class="desktop-icon" data-app="project">
          <svg viewBox="0 0 40 40" fill="none">
            <path d="M20 4L34 12V28L20 36L6 28V12L20 4Z" fill="#1e293b" stroke="#a855f7" stroke-width="1.5"/>
            <path d="M20 4V36" stroke="#a855f7" stroke-width="0.8" opacity="0.4"/>
            <path d="M6 12L34 28" stroke="#a855f7" stroke-width="0.8" opacity="0.4"/>
            <path d="M34 12L6 28" stroke="#a855f7" stroke-width="0.8" opacity="0.4"/>
            <circle cx="20" cy="20" r="4" fill="#a855f7" opacity="0.3"/>
          </svg>
          <span>Projects</span>
        </div>
        <div class="desktop-icon" data-app="work">
          <svg viewBox="0 0 40 40" fill="none">
            <rect x="6" y="14" width="28" height="22" rx="2" fill="#1e293b" stroke="#f59e0b" stroke-width="1.5"/>
            <path d="M14 14V10C14 6 16 4 20 4C24 4 26 6 26 10V14" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/>
            <rect x="12" y="20" width="16" height="3" rx="1" fill="#f59e0b" opacity="0.4"/>
            <rect x="12" y="26" width="10" height="3" rx="1" fill="#f59e0b" opacity="0.3"/>
          </svg>
          <span>Work</span>
        </div>
        <div class="desktop-icon" data-app="me">
          <svg viewBox="0 0 40 40" fill="none">
            <circle cx="20" cy="14" r="7" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5"/>
            <path d="M8 34C8 26 13 22 20 22C27 22 32 26 32 34" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="20" cy="14" r="3" fill="#3b82f6" opacity="0.3"/>
          </svg>
          <span>About Me</span>
        </div>
      </div>

      <div id="desktop-social-icon" class="desktop-icon" data-app="connect">
        <svg viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="16" fill="#1e293b" stroke="#22c55e" stroke-width="1.5"/>
          <circle cx="14" cy="16" r="2.5" fill="#22c55e" opacity="0.7"/>
          <circle cx="26" cy="16" r="2.5" fill="#06b6d4" opacity="0.7"/>
          <circle cx="20" cy="26" r="2.5" fill="#a855f7" opacity="0.7"/>
          <path d="M14 16L20 26L26 16" stroke="rgba(255,255,255,0.15)" stroke-width="1.2" stroke-linecap="round"/>
        </svg>
        <span>Connect</span>
      </div>

      <div id="windows-container"></div>

      <div id="start-menu">
        <div id="start-menu-header">
          <h3>Quick Access</h3>
          <input type="text" id="start-menu-search" placeholder="Search apps..." />
        </div>
        <div id="start-menu-apps">
          <button class="start-menu-app" data-app="blog">
            <svg viewBox="0 0 40 40" fill="none"><rect x="4" y="2" width="32" height="36" rx="3" fill="#1e293b" stroke="#22c55e" stroke-width="1.5"/><line x1="10" y1="10" x2="30" y2="10" stroke="#22c55e" stroke-width="1.5" stroke-linecap="round"/></svg>
            <div class="start-menu-app-text"><strong>Blog</strong><small>Read articles &amp; write-ups</small></div>
          </button>
          <button class="start-menu-app" data-app="resume">
            <svg viewBox="0 0 40 40" fill="none"><rect x="8" y="2" width="24" height="36" rx="2" fill="#1e293b" stroke="#06b6d4" stroke-width="1.5"/><circle cx="20" cy="12" r="4" stroke="#06b6d4" stroke-width="1.2"/></svg>
            <div class="start-menu-app-text"><strong>Resume</strong><small>View &amp; download CV</small></div>
          </button>
          <button class="start-menu-app" data-app="project">
            <svg viewBox="0 0 40 40" fill="none"><path d="M20 4L34 12V28L20 36L6 28V12L20 4Z" fill="#1e293b" stroke="#a855f7" stroke-width="1.5"/><circle cx="20" cy="20" r="4" fill="#a855f7" opacity="0.3"/></svg>
            <div class="start-menu-app-text"><strong>Projects</strong><small>Showcase of work</small></div>
          </button>
          <button class="start-menu-app" data-app="work">
            <svg viewBox="0 0 40 40" fill="none"><rect x="6" y="14" width="28" height="22" rx="2" fill="#1e293b" stroke="#f59e0b" stroke-width="1.5"/><path d="M14 14V10C14 6 16 4 20 4C24 4 26 6 26 10V14" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/></svg>
            <div class="start-menu-app-text"><strong>Work</strong><small>Experience &amp; career</small></div>
          </button>
          <button class="start-menu-app" data-app="me">
            <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="14" r="7" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5"/><path d="M8 34C8 26 13 22 20 22C27 22 32 26 32 34" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round"/></svg>
            <div class="start-menu-app-text"><strong>About Me</strong><small>Contact &amp; personal info</small></div>
          </button>
          <button class="start-menu-app" data-app="connect">
            <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="16" fill="#1e293b" stroke="#22c55e" stroke-width="1.5"/><circle cx="14" cy="16" r="2.5" fill="#22c55e" opacity="0.7"/><circle cx="26" cy="16" r="2.5" fill="#06b6d4" opacity="0.7"/><circle cx="20" cy="26" r="2.5" fill="#a855f7" opacity="0.7"/></svg>
            <div class="start-menu-app-text"><strong>Connect</strong><small>Social links &amp; online presence</small></div>
          </button>
        </div>
        <div id="start-menu-footer">
          <span>system status: nominal</span>
          <span id="start-menu-uptime">uptime: --</span>
        </div>
      </div>

      <div id="taskbar">
        <button id="taskbar-start">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 3h8v8H3V3zm10 0h8v8h-8V3zM3 13h8v8H3v-8zm10 0h8v8h-8v-8z"/>
          </svg>
        </button>
        <div id="taskbar-apps"></div>
        <div id="taskbar-tray">
          <span id="taskbar-clock"></span>
        </div>
      </div>
    </div>

    <script>
// @ts-nocheck
document.addEventListener('DOMContentLoaded', () => {
  const { blogPosts, projects, experiences, skills } = window.__APP_DATA__;
  // ===== App Definitions =====
  const appIcons = {
    blog: '<svg viewBox="0 0 40 40" fill="none"><rect x="4" y="2" width="32" height="36" rx="3" fill="#1e293b" stroke="#22c55e" stroke-width="1.5"/><line x1="10" y1="10" x2="30" y2="10" stroke="#22c55e" stroke-width="1.5" stroke-linecap="round"/></svg>',
    resume: '<svg viewBox="0 0 40 40" fill="none"><rect x="8" y="2" width="24" height="36" rx="2" fill="#1e293b" stroke="#06b6d4" stroke-width="1.5"/><circle cx="20" cy="12" r="4" stroke="#06b6d4" stroke-width="1.2"/></svg>',
    project: '<svg viewBox="0 0 40 40" fill="none"><path d="M20 4L34 12V28L20 36L6 28V12L20 4Z" fill="#1e293b" stroke="#a855f7" stroke-width="1.5"/><circle cx="20" cy="20" r="4" fill="#a855f7" opacity="0.3"/></svg>',
    work: '<svg viewBox="0 0 40 40" fill="none"><rect x="6" y="14" width="28" height="22" rx="2" fill="#1e293b" stroke="#f59e0b" stroke-width="1.5"/><path d="M14 14V10C14 6 16 4 20 4C24 4 26 6 26 10V14" stroke="#f59e0b" stroke-width="1.5" stroke-linecap="round"/></svg>',
    me: '<svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="14" r="7" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5"/><path d="M8 34C8 26 13 22 20 22C27 22 32 26 32 34" fill="#1e293b" stroke="#3b82f6" stroke-width="1.5" stroke-linecap="round"/></svg>',
    connect: '<svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="16" fill="#1e293b" stroke="#22c55e" stroke-width="1.5"/><circle cx="14" cy="16" r="2.5" fill="#22c55e" opacity="0.7"/><circle cx="26" cy="16" r="2.5" fill="#06b6d4" opacity="0.7"/><circle cx="20" cy="26" r="2.5" fill="#a855f7" opacity="0.7"/></svg>'
  };

  const appMeta = {
    blog: { title: 'Blog — Articles', size: [700, 520] },
    resume: { title: 'Resume — CV', size: [650, 580] },
    project: { title: 'Projects — Showcase', size: [700, 500] },
    work: { title: 'Work — Experience', size: [680, 540] },
    me: { title: 'About Me', size: [600, 560] },
    connect: { title: 'Connect — Social Links', size: [480, 420] }
  };

  // ===== Window Manager =====
  let windowIdCounter = 0;
  let topZ = 100;
  const windows = new Map();

  const container = document.getElementById('windows-container');
  const taskbarApps = document.getElementById('taskbar-apps');

  function getAppContent(appId) {
    const postsHtml = blogPosts.map((p, i) => `
      <div class="blog-item" data-blog-index="${i}">
        <div class="blog-item-title">${p.title}</div>
        <div class="blog-item-meta">${p.date}</div>
        <div class="blog-item-desc">${p.description}</div>
      </div>
    `).join('');

    const projectsHtml = projects.map(p => `
      <div class="project-card">
        <div class="project-card-name">${p.name}</div>
        <div class="project-card-desc">${p.description}</div>
        <div class="project-tags">${p.tags.map(t => `<span class="project-tag">${t}</span>`).join('')}</div>
      </div>
    `).join('');

    const expHtml = experiences.map(e => `
      <div class="timeline-item">
        <div class="timeline-date">${e.period}</div>
        <div class="timeline-title">${e.role}</div>
        <div class="timeline-company">${e.company}</div>
        <div class="timeline-desc">${e.details.map(d => '<li>' + d + '</li>').join('')}</div>
      </div>
    `).join('');

    const skillsHtml = skills.map(s => `
      <div class="skill-item">
        <div class="skill-item-label"><span>${s.name}</span><span>${s.level}%</span></div>
        <div class="skill-bar"><div class="skill-bar-fill" style="width: 0%" data-level="${s.level}"></div></div>
      </div>
    `).join('');

    const resumeExpHtml = experiences.map(e => `
      <div class="resume-entry">
        <div class="resume-entry-header">
          <span class="resume-entry-title">${e.role}</span>
          <span class="resume-entry-date">${e.period}</span>
        </div>
        <div class="resume-entry-subtitle">${e.company}</div>
        <div class="resume-entry-details"><ul>${e.details.map(d => '<li>' + d + '</li>').join('')}</ul></div>
      </div>
    `).join('');

    const resumeSkillsHtml = skills.map(s => `
      <div class="skill-item">
        <div class="skill-item-label"><span>${s.name}</span><span>${s.level}%</span></div>
        <div class="skill-bar"><div class="skill-bar-fill" style="width: 0%" data-level="${s.level}"></div></div>
      </div>
    `).join('');

    const contentMap = {
      blog: `
        <div class="app-content">
          <div class="terminal-heading"><span class="prompt">~/blog $</span> ls articles/</div>
          <div id="blog-list-view">
            <h2>Latest Articles</h2>
            <p class="app-subtitle">Postmortems, write-ups, and lessons from the trenches</p>
            <div class="blog-list">${postsHtml}</div>
          </div>
          <div class="blog-reader" id="blog-reader">
            <div class="blog-reader-header">
              <button class="blog-reader-back" id="blog-back-btn">&#8592; Back to articles</button>
              <h2 class="blog-reader-title" id="blog-reader-title"></h2>
              <div class="blog-reader-date" id="blog-reader-date"></div>
            </div>
            <div class="blog-reader-body" id="blog-reader-body"></div>
          </div>
        </div>`,

      resume: `
        <div class="app-content">
          <div class="terminal-heading"><span class="prompt">~/resume $</span> cat cv.tex</div>
          <a class="download-btn" href="#" id="resume-download">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download PDF
          </a>
          <div class="resume-section">
            <div class="resume-section-title">\\section{Education}</div>
            <div class="resume-entry">
              <div class="resume-entry-header">
                <span class="resume-entry-title">B.S. Computer Science</span>
                <span class="resume-entry-date">2015 — 2019</span>
              </div>
              <div class="resume-entry-subtitle">University of Technology</div>
              <div class="resume-entry-details"><ul><li>GPA: 3.7/4.0 — Dean's List</li><li>Focus: Distributed Systems, Networks</li><li>Capstone: Cluster management simulator</li></ul></div>
            </div>
          </div>
          <div class="resume-section">
            <div class="resume-section-title">\\section{Experience}</div>
            ${resumeExpHtml}
          </div>
          <div class="resume-section">
            <div class="resume-section-title">\\section{Technical Skills}</div>
            <div class="skill-list">${resumeSkillsHtml}</div>
          </div>
          <div class="resume-section">
            <div class="resume-section-title">\\section{Certifications}</div>
            <div class="resume-entry">
              <div class="resume-entry-details"><ul>
                <li>AWS Certified Solutions Architect — Associate</li>
                <li>Certified Kubernetes Administrator (CKA)</li>
                <li>HashiCorp Terraform Associate</li>
                <li>Google Cloud Professional DevOps Engineer</li>
              </ul></div>
            </div>
          </div>
        </div>`,

      project: `
        <div class="app-content">
          <div class="terminal-heading"><span class="prompt">~/projects $</span> gh repo list --limit 10</div>
          <h2>Project Showcase</h2>
          <p class="app-subtitle">Tools, systems, and side projects I've built</p>
          <div class="project-grid">${projectsHtml}</div>
        </div>`,

      work: `
        <div class="app-content">
          <div class="terminal-heading"><span class="prompt">~/work $</span> cat career_history.md</div>
          <h2>Career Timeline</h2>
          <p class="app-subtitle">My journey through infrastructure and reliability</p>
          <div class="work-metrics">
            <div class="work-metric"><div class="work-metric-value">99.99%</div><div class="work-metric-label">Uptime SLA</div></div>
            <div class="work-metric"><div class="work-metric-value">50+</div><div class="work-metric-label">Incidents Led</div></div>
            <div class="work-metric"><div class="work-metric-value">6yr</div><div class="work-metric-label">Experience</div></div>
          </div>
          <div class="timeline">${expHtml}</div>
        </div>`,

      me: `
        <div class="app-content">
          <div class="terminal-heading"><span class="prompt">~/about $</span> whoami</div>
          <div class="profile-header">
            <div class="profile-avatar">P</div>
            <div class="profile-info">
              <h2>PePoDev</h2>
              <div class="profile-role">Senior Site Reliability Engineer</div>
              <div class="profile-location">Remote | Asia-Pacific</div>
              <div style="margin-top:8px"><span class="status-badge online">Available for opportunities</span></div>
            </div>
          </div>
          <h3>Who Am I</h3>
          <p>I'm an SRE who lives at the intersection of software engineering and operations. I believe systems should be designed to fail gracefully, and that every outage is a learning opportunity. When I'm not keeping production green, I'm building tools to make it stay that way.</p>
          <div class="section-divider"></div>
          <h3>Skills & Expertise</h3>
          <div class="skill-list">${skillsHtml}</div>
          <div class="section-divider"></div>
          <h3>Get in Touch</h3>
          <div class="contact-links">
            <a href="mailto:hello@pepodev.com" class="contact-link">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              hello@pepodev.com
            </a>
            <a href="https://github.com/pepodev" class="contact-link" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.88-.015 3.285 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
            <a href="https://linkedin.com/in/pepodev" class="contact-link" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.791 0 0 .774 0 1.729v20.542C0 23.227.791 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="https://twitter.com/pepodev" class="contact-link" target="_blank">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              X (Twitter)
            </a>
          </div>
        </div>`,

      connect: `
        <div class="app-content">
          <div class="terminal-heading"><span class="prompt">~/connect $</span> cat social_links.yaml</div>
          <h2>Find Me Online</h2>
          <p class="app-subtitle">Click to visit my profiles on external platforms</p>
          <div class="contact-links">
            <a href="https://facebook.com/pepodev" class="contact-link" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook — @pepodev
            </a>
            <a href="https://github.com/pepodev" class="contact-link" target="_blank" rel="noopener noreferrer">
