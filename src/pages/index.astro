        }

        function createWindow(appId) {
          // Check if already open — bring to front
          for (const [wid, w] of windows) {
            if (w.appId === appId && !w.minimized) {
              focusWindow(wid);
              return;
            }
            if (w.appId === appId && w.minimized) {
              restoreWindow(wid);
              return;
            }
          }

          const id = "win-" + ++windowIdCounter;
          const meta = appMeta[appId];
          const [w, h] = meta.size;

          // Center the window
          const x = Math.max(
            40,
            (window.innerWidth - w) / 2 + (Math.random() * 40 - 20),
          );
          const y = Math.max(
            20,
            (window.innerHeight - h - 48) / 2 + (Math.random() * 30 - 15),
          );

          const win = document.createElement("div");
          win.className = "window opening focused";
          win.id = id;
          win.dataset.appId = appId;
          win.style.cssText = `width:${w}px;height:${h}px;left:${x}px;top:${y}px;z-index:${++topZ}`;

          win.innerHTML = `
      <div class="window-titlebar">
        <div class="window-titlebar-icon">${appIcons[appId]}</div>
        <span class="window-title">${meta.title}</span>
        <div class="window-status-dot"></div>
        <div class="window-controls">
          <button class="min-btn" title="Minimize">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="2" y1="6" x2="10" y2="6"/></svg>
          </button>
          <button class="max-btn" title="Maximize">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="8" height="8" rx="1"/></svg>
          </button>
          <button class="close-btn" title="Close">
            <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="2" y1="2" x2="10" y2="10"/><line x1="10" y1="2" x2="2" y2="10"/></svg>
          </button>
        </div>
      </div>
      <div class="window-content">${getAppContent(appId)}</div>
      <div class="window-resize-handle"></div>
    `;

          container.appendChild(win);

          // Remove opening animation class after it completes
          setTimeout(() => win.classList.remove("opening"), 300);

          // Store window state
          windows.set(id, {
            id,
            appId,
            element: win,
            minimized: false,
            maximized: false,
            prevBounds: null,
          });

          focusWindow(id);
          updateTaskbar();
          setupWindowEvents(win, id);
          setupAppSpecificEvents(win, appId, id);
          animateSkillBars(win);

          return id;
        }

        function setupWindowEvents(win, id) {
          const titlebar = win.querySelector(".window-titlebar");

          // Focus on click
          win.addEventListener("mousedown", () => focusWindow(id));

          // Close
          win
            .querySelector(".close-btn")
            .addEventListener("click", () => closeWindow(id));

          // Minimize
          win
            .querySelector(".min-btn")
            .addEventListener("click", () => minimizeWindow(id));

          // Maximize
          win
            .querySelector(".max-btn")
            .addEventListener("click", () => toggleMaximize(id));

          // Drag
          let isDragging = false;
          let dragStartX, dragStartY, winStartX, winStartY;

          titlebar.addEventListener("mousedown", (e) => {
            if (e.target.closest(".window-controls")) return;
            const wState = windows.get(id);
            if (wState && wState.maximized) return;
            isDragging = true;
            dragStartX = e.clientX;
            dragStartY = e.clientY;
            winStartX = win.offsetLeft;
            winStartY = win.offsetTop;
            document.body.style.userSelect = "none";
          });

          titlebar.addEventListener("dblclick", (e) => {
            if (e.target.closest(".window-controls")) return;
            toggleMaximize(id);
          });

          document.addEventListener("mousemove", (e) => {
            if (!isDragging) return;
            win.style.left = winStartX + e.clientX - dragStartX + "px";
            win.style.top =
              Math.max(0, winStartY + e.clientY - dragStartY) + "px";
          });

          document.addEventListener("mouseup", () => {
            if (isDragging) {
              isDragging = false;
              document.body.style.userSelect = "";
            }
          });

          // Resize
          const resizeHandle = win.querySelector(".window-resize-handle");
          let isResizing = false;
          let resizeStartX, resizeStartY, resizeStartW, resizeStartH;

          resizeHandle.addEventListener("mousedown", (e) => {
            e.stopPropagation();
            const wState = windows.get(id);
            if (wState && wState.maximized) return;
            isResizing = true;
            resizeStartX = e.clientX;
            resizeStartY = e.clientY;
            resizeStartW = win.offsetWidth;
            resizeStartH = win.offsetHeight;
            document.body.style.userSelect = "none";
          });

          document.addEventListener("mousemove", (e) => {
            if (!isResizing) return;
            const newW = Math.max(
              320,
              resizeStartW + (e.clientX - resizeStartX),
            );
            const newH = Math.max(
              200,
              resizeStartH + (e.clientY - resizeStartY),
            );
            win.style.width = newW + "px";
            win.style.height = newH + "px";
          });

          document.addEventListener("mouseup", () => {
            if (isResizing) {
              isResizing = false;
              document.body.style.userSelect = "";
            }
          });
        }

        function setupAppSpecificEvents(win, appId, winId) {
          if (appId === "blog") {
            const blogList = win.querySelector("#blog-list-view");
            const blogReader = win.querySelector("#blog-reader");
            const backBtn = win.querySelector("#blog-back-btn");

            win.querySelectorAll(".blog-item").forEach((item) => {
              item.addEventListener("click", () => {
                const idx = parseInt(item.dataset.blogIndex);
                const post = blogPosts[idx];
                if (!post) return;
                document.getElementById("blog-reader-title").textContent =
                  post.title;
                document.getElementById("blog-reader-date").textContent =
                  post.date;
                document.getElementById("blog-reader-body").innerHTML =
                  post.body;
                if (blogList) blogList.style.display = "none";
                if (blogReader) blogReader.classList.add("active");
              });
            });

            if (backBtn) {
              backBtn.addEventListener("click", () => {
                if (blogList) blogList.style.display = "";
                if (blogReader) blogReader.classList.remove("active");
              });
            }
          }

          if (appId === "sregame") {
            initSreGame(win);
          }
        }

        function animateSkillBars(win) {
          setTimeout(() => {
            win.querySelectorAll(".skill-bar-fill").forEach((bar) => {
              bar.style.width = bar.dataset.level + "%";
            });
          }, 300);
        }

        function focusWindow(id) {
          windows.forEach((w, wid) => {
            w.element.classList.toggle("focused", wid === id);
            if (wid === id) w.element.style.zIndex = ++topZ;
          });
          updateTaskbar();
        }

        function closeWindow(id) {
          const w = windows.get(id);
          if (!w) return;
          // Clean up game timers if closing an SRE Game window
          if (w.appId === "sregame" && w.alertTimer) {
            clearInterval(w.alertTimer);
          }
          w.element.classList.add("closing");
          setTimeout(() => {
            w.element.remove();
            windows.delete(id);
            updateTaskbar();
          }, 200);
        }

        function minimizeWindow(id) {
          const w = windows.get(id);
          if (!w) return;
          w.minimized = true;
          w.element.classList.add("minimized");
          updateTaskbar();
        }

        function restoreWindow(id) {
          const w = windows.get(id);
          if (!w) return;
          w.minimized = false;
          w.element.classList.remove("minimized");
          focusWindow(id);
          updateTaskbar();
        }

        function toggleMaximize(id) {
          const w = windows.get(id);
          if (!w) return;
          if (!w.maximized) {
            w.prevBounds = {
              left: w.element.style.left,
              top: w.element.style.top,
              width: w.element.style.width,
              height: w.element.style.height,
            };
            w.element.style.cssText = `left:0;top:0;width:100%;height:calc(100vh - 48px);z-index:${++topZ}`;
            w.maximized = true;
          } else {
            Object.assign(w.element.style, w.prevBounds);
            w.element.style.zIndex = ++topZ;
            w.maximized = false;
          }
          focusWindow(id);
        }

        function updateTaskbar() {
          taskbarApps.innerHTML = "";
          windows.forEach((w) => {
            const btn = document.createElement("button");
            btn.className =
              "taskbar-app" + (w.minimized ? " active" : " focused");
            btn.innerHTML =
              appIcons[w.appId] +
              "<span>" +
              appMeta[w.appId].title.split("—")[0].trim() +
              "</span>";
            btn.addEventListener("click", () => {
              if (w.minimized) {
                restoreWindow(w.id);
              } else if (w.element.classList.contains("focused")) {
                minimizeWindow(w.id);
              } else {
                focusWindow(w.id);
              }
            });
            taskbarApps.appendChild(btn);
          });
        }

        // ===== Desktop Icon Click =====
        document.querySelectorAll(".desktop-icon").forEach((icon) => {
          icon.addEventListener("dblclick", () => {
            createWindow(icon.dataset.app);
          });
        });

        // ===== Start Menu =====
        const startMenu = document.getElementById("start-menu");
        const startBtn = document.getElementById("taskbar-start");
        let startMenuOpen = false;

        startBtn.addEventListener("click", (e) => {
          e.stopPropagation();
          startMenuOpen = !startMenuOpen;
          startMenu.classList.toggle("visible", startMenuOpen);
        });

        document.addEventListener("click", (e) => {
          if (
            startMenuOpen &&
            !startMenu.contains(e.target) &&
            e.target !== startBtn &&
            !startBtn.contains(e.target)
          ) {
            startMenuOpen = false;
            startMenu.classList.remove("visible");
          }
        });

        startMenu.addEventListener("click", (e) => e.stopPropagation());

        document.querySelectorAll(".start-menu-app").forEach((btn) => {
          btn.addEventListener("click", () => {
            createWindow(btn.dataset.app);
            startMenuOpen = false;
            startMenu.classList.remove("visible");
          });
        });

        // Start menu search
        document
          .getElementById("start-menu-search")
          .addEventListener("input", (e) => {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll(".start-menu-app").forEach((app) => {
              const text = app.textContent.toLowerCase();
              app.style.display = text.includes(q) ? "" : "none";
            });
          });

        // ===== Clock =====
        function updateClock() {
          const now = new Date();
          const h = now.getHours().toString().padStart(2, "0");
          const m = now.getMinutes().toString().padStart(2, "0");
          document.getElementById("taskbar-clock").textContent = h + ":" + m;
        }
        updateClock();
        setInterval(updateClock, 30000);

        // ===== Uptime =====
        const sessionStart = Date.now();
        function updateUptime() {
          const diff = Date.now() - sessionStart;
          const mins = Math.floor(diff / 60000);
          const secs = Math.floor((diff % 60000) / 1000);
          const el = document.getElementById("start-menu-uptime");
          if (el) el.textContent = "uptime: " + mins + "m " + secs + "s";
        }
        updateUptime();
        setInterval(updateUptime, 1000);

        // ===== Particle Network Background =====
        function initParticleNetwork() {
          const canvas = document.getElementById("bg-canvas");
          if (!canvas) return;
          const ctx = canvas.getContext("2d");
          const connectionDist = 180;
          const particles = [];
          const pulses = [];
          const count = 70;
          const ambientBlobs = [];

          function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
          }
          resize();
          window.addEventListener("resize", resize);

          for (let i = 0; i < 4; i++) {
            ambientBlobs.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              r: 150 + Math.random() * 200,
              vx: (Math.random() - 0.5) * 0.15,
              vy: (Math.random() - 0.5) * 0.15,
              color: Math.random() < 0.3 ? "cyan" : "green",
              alpha: 0.015 + Math.random() * 0.02,
            });
          }

          for (let i = 0; i < count; i++) {
            const isHub = Math.random() < 0.1;
            particles.push({
              x: Math.random() * canvas.width,
              y: Math.random() * canvas.height,
              vx: (Math.random() - 0.5) * (isHub ? 0.2 : 0.4),
              vy: (Math.random() - 0.5) * (isHub ? 0.2 : 0.4),
              r: isHub ? 3 + Math.random() * 2 : Math.random() * 2 + 1,
              isHub,
              color: Math.random() < 0.15 ? "cyan" : "green",
              pulseTimer: Math.random() * 300,
              glowPhase: Math.random() * Math.PI * 2,
              glowSpeed: 0.01 + Math.random() * 0.02,
            });
          }

          let time = 0;

          function draw() {
            ctx.fillStyle = "#0a0e17";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            time += 0.016;

            ambientBlobs.forEach((blob) => {
              blob.x += blob.vx;
              blob.y += blob.vy;
              if (blob.x < -blob.r) blob.x = canvas.width + blob.r;
              if (blob.x > canvas.width + blob.r) blob.x = -blob.r;
              if (blob.y < -blob.r) blob.y = canvas.height + blob.r;
              if (blob.y > canvas.height + blob.r) blob.y = -blob.r;
              const grad = ctx.createRadialGradient(
                blob.x,
                blob.y,
                0,
                blob.x,
                blob.y,
                blob.r,
              );
              if (blob.color === "cyan") {
                grad.addColorStop(0, "rgba(6, 182, 212, " + blob.alpha + ")");
                grad.addColorStop(1, "rgba(6, 182, 212, 0)");
              } else {
                grad.addColorStop(0, "rgba(34, 197, 94, " + blob.alpha + ")");
                grad.addColorStop(1, "rgba(34, 197, 94, 0)");
              }
              ctx.fillStyle = grad;
              ctx.fillRect(
                blob.x - blob.r,
                blob.y - blob.r,
                blob.r * 2,
                blob.r * 2,
              );
            });

            particles.forEach((p) => {
              p.x += p.vx;
              p.y += p.vy;
              if (p.x < 0) p.x = canvas.width;
              if (p.x > canvas.width) p.x = 0;
              if (p.y < 0) p.y = canvas.height;
              if (p.y > canvas.height) p.y = 0;

              p.pulseTimer--;
              if (p.pulseTimer <= 0) {
                p.pulseTimer = p.isHub
                  ? 30 + Math.random() * 80
                  : 100 + Math.random() * 400;
                let nearest = null;
                let nearestDist = Infinity;
                particles.forEach((other) => {
                  if (other === p) return;
                  const d = Math.hypot(other.x - p.x, other.y - p.y);
                  if (d < connectionDist && d < nearestDist) {
                    nearest = other;
                    nearestDist = d;
                  }
                });
                if (nearest) {
                  pulses.push({
                    x: p.x,
                    y: p.y,
                    tx: nearest.x,
                    ty: nearest.y,
                    progress: 0,
                    speed: 0.02 + Math.random() * 0.03,
                    color: p.color,
                    trail: [],
                  });
                }
              }
            });

            for (let i = 0; i < particles.length; i++) {
              for (let j = i + 1; j < particles.length; j++) {
                const d = Math.hypot(
                  particles[i].x - particles[j].x,
                  particles[i].y - particles[j].y,
                );
                if (d < connectionDist) {
                  const alpha = (1 - d / connectionDist) * 0.3;
                  ctx.strokeStyle = "rgba(34, 197, 94, " + alpha + ")";
                  ctx.lineWidth = 1;
                  ctx.beginPath();
                  ctx.moveTo(particles[i].x, particles[i].y);
                  ctx.lineTo(particles[j].x, particles[j].y);
                  ctx.stroke();
                }
              }
            }

            for (let i = pulses.length - 1; i >= 0; i--) {
              const pulse = pulses[i];
              pulse.progress += pulse.speed;
              if (pulse.progress >= 1) {
                pulses.splice(i, 1);
                continue;
              }
              const px = pulse.x + (pulse.tx - pulse.x) * pulse.progress;
              const py = pulse.y + (pulse.ty - pulse.y) * pulse.progress;
              pulse.trail.push({ x: px, y: py });
              if (pulse.trail.length > 8) pulse.trail.shift();
              for (let t = 0; t < pulse.trail.length; t++) {
                const trailAlpha = (t / pulse.trail.length) * 0.8;
                const trailR = 1 + (t / pulse.trail.length) * 2;
                const baseColor =
                  pulse.color === "cyan" ? "6, 182, 212" : "34, 197, 94";
                ctx.beginPath();
                ctx.arc(
                  pulse.trail[t].x,
                  pulse.trail[t].y,
                  trailR,
                  0,
                  Math.PI * 2,
                );
                ctx.fillStyle =
                  "rgba(" +
                  baseColor +
                  ", " +
                  trailAlpha * (1 - pulse.progress * 0.5) +
                  ")";
                ctx.fill();
              }
              const baseColor =
                pulse.color === "cyan" ? "6, 182, 212" : "34, 197, 94";
              const glowGrad = ctx.createRadialGradient(px, py, 0, px, py, 12);
              glowGrad.addColorStop(
                0,
                "rgba(" + baseColor + ", " + 0.6 * (1 - pulse.progress) + ")",
              );
              glowGrad.addColorStop(1, "rgba(" + baseColor + ", 0)");
              ctx.fillStyle = glowGrad;
              ctx.beginPath();
              ctx.arc(px, py, 12, 0, Math.PI * 2);
              ctx.fill();
            }

            particles.forEach((p) => {
              const glowPulse =
                Math.sin(time * p.glowSpeed * 60 + p.glowPhase) * 0.3 + 0.7;
              const baseColor =
                p.color === "cyan" ? "6, 182, 212" : "34, 197, 94";
              const glowR = p.isHub ? 20 : 10;
              const glowGrad = ctx.createRadialGradient(
                p.x,
                p.y,
                0,
                p.x,
                p.y,
                glowR,
              );
              glowGrad.addColorStop(
                0,
                "rgba(" + baseColor + ", " + 0.3 * glowPulse + ")",
              );
              glowGrad.addColorStop(1, "rgba(" + baseColor + ", 0)");
              ctx.fillStyle = glowGrad;
              ctx.beginPath();
              ctx.arc(p.x, p.y, glowR, 0, Math.PI * 2);
              ctx.fill();
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
              ctx.fillStyle =
                "rgba(" + baseColor + ", " + (0.6 * glowPulse + 0.2) + ")";
              ctx.fill();
            });

            const vignetteGrad = ctx.createRadialGradient(
              canvas.width / 2,
              canvas.height / 2,
              canvas.height * 0.3,
              canvas.width / 2,
              canvas.height / 2,
              canvas.height * 0.9,
            );
            vignetteGrad.addColorStop(0, "rgba(10, 14, 23, 0)");
            vignetteGrad.addColorStop(1, "rgba(10, 14, 23, 0.7)");
            ctx.fillStyle = vignetteGrad;
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            requestAnimationFrame(draw);
          }

          draw();
        }

        initParticleNetwork();

        // ===== SRE Game Engine =====
        function initSreGame(win) {
          const q = (sel) => win.querySelector(sel);
          const qa = (sel) => win.querySelectorAll(sel);

          const bootLines = [
            {
              text: "$ ssh production-cluster.prod.internal",
              cls: "",
              delay: 300,
            },
            { text: "Connecting to 10.0.42.1...", cls: "sre-dim", delay: 500 },
            {
              text: "Authenticated. Welcome to prod.",
              cls: "sre-info",
              delay: 400,
            },
            { text: "", cls: "", delay: 200 },
            { text: "$ kubectl get nodes", cls: "", delay: 600 },
            {
              text: "NAME           STATUS   ROLES    AGE   VERSION",
              cls: "sre-dim",
              delay: 300,
            },
            {
              text: "prod-node-01   Ready    master   45d   v1.36.0",
              cls: "",
              delay: 200,
            },
            {
              text: "prod-node-02   Ready    worker   45d   v1.36.0",
              cls: "",
              delay: 200,
            },
            {
              text: "prod-node-03   Ready    worker   45d   v1.36.0",
              cls: "",
              delay: 200,
            },
            { text: "", cls: "", delay: 200 },
            { text: "$ systemctl status monitoring", cls: "", delay: 500 },
            {
              text: "● prometheus.service - Prometheus Monitoring",
              cls: "",
              delay: 200,
            },
            {
              text: "   Active: active (running) since Mon 2024-01-15",
              cls: "",
              delay: 200,
            },
            { text: "", cls: "", delay: 200 },
            {
              text: "All systems nominal. No alerts.",
              cls: "sre-info",
              delay: 400,
            },
            { text: "", cls: "", delay: 200 },
            {
              text: "You're on call. The dashboard is green.",
              cls: "",
              delay: 600,
            },
            { text: "For now...", cls: "sre-warn", delay: 800 },
          ];

          const alerts = [
            {
              severity: "warning",
              title: "⚠ High Memory Usage Detected",
              desc: "prod-node-02 memory at 87%. Pod evictions imminent.",
              timer: 15,
              damage: 8,
              actions: [
                {
                  text: "Restart pods",
                  result:
                    "Pods restarted. Memory dropped... then spiked higher. +12% usage.",
                },
                {
                  text: "Scale horizontally",
                  result:
                    "New pods scheduled. Node now at 94% with scheduling overhead.",
                },
                {
                  text: "Kill top consumer",
                  result:
                    "Killed memhog process. It was a critical cache. Latency tripled.",
                },
              ],
            },
            {
              severity: "warning",
              title: "⚠ Latency Spike on API Gateway",
              desc: "p99 latency jumped from 120ms to 2.4s. Users reporting slow responses.",
              timer: 14,
              damage: 10,
              actions: [
                {
                  text: "Enable circuit breaker",
                  result:
                    "Circuit breaker tripped. Now 40% of requests are failing outright.",
                },
                {
                  text: "Rollback last deploy",
                  result:
                    "Rollback complete. The latency was infrastructure-level, not code.",
                },
                {
                  text: "Add rate limiting",
                  result:
                    "Rate limiter engaged. Legitimate traffic now being throttled too.",
                },
              ],
            },
            {
              severity: "critical",
              title: "🔴 Disk I/O Saturation",
              desc: "prod-node-03 disk utilization at 100%. Write operations queueing.",
              timer: 12,
              damage: 12,
              actions: [
                {
                  text: "Clear old logs",
                  result:
                    "Logs cleared. Application started writing audit logs at 10x rate.",
                },
                {
                  text: "Move to faster storage",
                  result:
                    "Storage migration started. I/O spiked during the transition.",
                },
                {
                  text: "Enable write coalescing",
                  result:
                    "Writes coalesced. Data consistency checks now failing.",
                },
              ],
            },
            {
              severity: "critical",
              title: "🔴 Certificate Expiring in 2h",
              desc: "TLS cert for *.prod.internal expires soon. Auto-renewal failed.",
              timer: 10,
              damage: 12,
              actions: [
                {
                  text: "Manual cert renewal",
                  result:
                    "Renewed cert. ACME challenge failed for internal DNS zone.",
                },
                {
                  text: "Switch to internal CA",
                  result:
                    "Internal CA signed it. Browser trust store doesn't recognize the root.",
                },
                {
                  text: "Extend validity window",
                  result: "Cannot extend expired cert. The window has closed.",
                },
              ],
            },
            {
              severity: "critical",
              title: "🔴 Database Connection Pool Exhausted",
              desc: "PostgreSQL primary: 450/450 connections used. New connections being rejected.",
              timer: 10,
              damage: 14,
              actions: [
                {
                  text: "Increase pool size",
                  result:
                    "Pool expanded to 600. Server ran out of shared memory.",
                },
                {
                  text: "Kill idle connections",
                  result:
                    "Killed 200 connections. Hit the replication lag monitors.",
                },
                {
                  text: "Enable PgBouncer",
                  result: "PgBouncer deployed. Transaction retry storms began.",
                },
              ],
            },
            {
              severity: "catastrophic",
              title: "💀 Cascading Failure Detected",
              desc: "Service mesh sidecars crashing. 12 microservices affected. Error propagation across all zones.",
              timer: 8,
              damage: 16,
              actions: [
                {
                  text: "Emergency rollback all",
                  result:
                    "Rollback triggered dependency conflicts. More services down.",
                },
                {
                  text: "Isolate affected zones",
                  result:
                    "Zones isolated. Cross-zone replication broke. Data divergence detected.",
                },
                {
                  text: "Full cluster restart",
                  result:
                    "Restart initiated. Boot storm caused DNS resolution failures.",
                },
              ],
            },
            {
              severity: "catastrophic",
              title: "💀 CRITICAL: Cluster Unstable",
              desc: "CoreDNS flapping. Etcd quorum at risk. Multiple nodes NotReady. This is it.",
              timer: 6,
              damage: 20,
              actions: [
                {
                  text: "Attempt etcd restore",
                  result:
                    "Restore started from 4h-old backup. 4 hours of data loss.",
                },
                {
                  text: "Failover to DR site",
                  result:
                    "DR site activated. Replication was stale. Partial data available.",
                },
                {
                  text: "Call for help...",
                  result:
                    "You need more than a runbook. You need an SRE who lives for this.",
                },
              ],
            },
          ];

          let health = 100;
          let currentRound = 0;
          let alertTimer = null;

          function showScreen(index) {
            qa(".sre-game-screen").forEach((s, i) => {
              s.classList.toggle("sre-game-screen-active", i === index);
            });
          }

          async function runBoot() {
            const output = q(".sre-boot-output");
            for (const line of bootLines) {
              await new Promise((r) => setTimeout(r, line.delay));
              const el = document.createElement("div");
              el.className = `sre-line ${line.cls}`;
              el.textContent = line.text || " ";
              output.appendChild(el);
              output.scrollTop = output.scrollHeight;
            }
            q(".sre-boot-enter").classList.remove("sre-hidden");
          }

          q(".sre-boot-enter").addEventListener("click", () => {
            showScreen(1);
            startGame();
          });

          function startGame() {
            health = 100;
            currentRound = 0;
            updateHealth();
            updateRound();
            updateStatus();
            q(".sre-game-message").innerHTML = `
        <p>Monitoring production...</p>
        <p class="sre-sub">Alerts will appear below. Click an action to mitigate before time runs out.</p>
      `;
            q(".sre-game-actions").innerHTML = "";
            scheduleNextAlert();
          }

          function scheduleNextAlert() {
            if (currentRound >= alerts.length) return;
            const delay = currentRound === 0 ? 2500 : 1800;
            setTimeout(() => showAlert(currentRound), delay);
          }

          function showAlert(index) {
            const alert = alerts[index];
            let timeLeft = alert.timer;
            const gameArea = q(".sre-game-area");
            gameArea.innerHTML = "";

            const card = document.createElement("div");
            card.className = `sre-alert-card sre-severity-${alert.severity}`;
            card.innerHTML = `
        <div class="sre-alert-header">
          <span class="sre-alert-title">${alert.title}</span>
          <span class="sre-alert-severity">${alert.severity}</span>
        </div>
        <div class="sre-alert-desc">${alert.desc}</div>
        <div class="sre-alert-timer">Time remaining: ${timeLeft}s</div>
      `;
            gameArea.appendChild(card);

            const actionsDiv = q(".sre-game-actions");
            actionsDiv.innerHTML = "";
            alert.actions.forEach((action, i) => {
              const btn = document.createElement("button");
              btn.className = "sre-action-btn";
              btn.textContent = action.text;
              btn.addEventListener("click", () => handleAction(index, i));
              actionsDiv.appendChild(btn);
            });

            clearInterval(alertTimer);
            alertTimer = setInterval(() => {
              timeLeft--;
              const timerEl = gameArea.querySelector(".sre-alert-timer");
              if (timerEl) timerEl.textContent = `Time remaining: ${timeLeft}s`;
              if (timeLeft <= 0) {
                clearInterval(alertTimer);
                timeExpired(index);
              }
            }, 1000);
          }

          function handleAction(alertIndex, actionIndex) {
            clearInterval(alertTimer);
            const alert = alerts[alertIndex];
            const action = alert.actions[actionIndex];
            health -= alert.damage;
            updateHealth();

            const gameArea = q(".sre-game-area");
            const log = document.createElement("div");
            log.className = "sre-mitigation-log";
            log.innerHTML = `<strong>Mitigation failed:</strong> ${action.result}`;
            gameArea.appendChild(log);

            qa(".sre-action-btn").forEach((b) => {
              b.disabled = true;
              b.style.opacity = "0.4";
            });

            currentRound++;
            updateRound();
            updateStatus();

            if (health <= 0 || currentRound >= alerts.length) {
              setTimeout(() => showScreen(2), 2000);
              return;
            }

            scheduleNextAlert();
          }

          function timeExpired(alertIndex) {
            const alert = alerts[alertIndex];
            health -= alert.damage;
            updateHealth();
            updateStatus();

            const gameArea = q(".sre-game-area");
            const log = document.createElement("div");
            log.className = "sre-mitigation-log";
            log.innerHTML = `<strong>Time expired — alert unresolved.</strong> System absorbed the damage.`;
            gameArea.appendChild(log);

            qa(".sre-action-btn").forEach((b) => {
              b.disabled = true;
              b.style.opacity = "0.4";
            });

            currentRound++;
            updateRound();

            if (health <= 0) {
              setTimeout(() => showScreen(2), 2000);
              return;
            }

            if (currentRound < alerts.length) {
              scheduleNextAlert();
            } else {
              setTimeout(() => showScreen(2), 2000);
            }
          }

          function updateHealth() {
            health = Math.max(0, Math.min(100, health));
            const fill = q(".sre-health-fill");
            fill.style.width = health + "%";
            fill.style.background =
              health > 60 ? "#22c55e" : health > 30 ? "#eab308" : "#ef4444";
            q(".sre-health-pct").textContent = health + "%";
          }

          function updateRound() {
            q(".sre-round-num").textContent = currentRound + 1;
          }

          function updateStatus() {
            const status = q(".sre-game-status");
            if (health > 60) {
              status.textContent = "Stable";
              status.className = "sre-game-status sre-status-ok";
            } else if (health > 30) {
              status.textContent = "Degraded";
              status.className = "sre-game-status sre-status-warn";
            } else {
              status.textContent = "Critical";
              status.className = "sre-game-status sre-status-crit";
            }
          }

          // Game Over → Solution
          q(".sre-gameover-reveal").addEventListener("click", () => {
            showScreen(3);
          });

          // Replay from solution screen
          q(".sre-solution-replay").addEventListener("click", () => {
            showScreen(0);
            q(".sre-boot-output").innerHTML = "";
            q(".sre-boot-enter").classList.add("sre-hidden");
            runBoot();
          });

          // Start boot sequence
          runBoot();

          // Store alert timer reference on window state for cleanup
          const wState = windows.get(winId);
          if (wState) {
            // Periodically sync the timer so closeWindow can clear it
            const syncTimer = setInterval(() => {
              wState.alertTimer = alertTimer;
            }, 100);
            // Stop syncing after 60s (game is usually done by then)
            setTimeout(() => clearInterval(syncTimer), 60000);
          }
        }

        // ===== Keyboard shortcut: Escape closes start menu =====
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && startMenuOpen) {
            startMenuOpen = false;
            startMenu.classList.remove("visible");
          }
        });
      });
    </script>
  </body>
