---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import FormattedDate from "../components/FormattedDate.astro";
import SiteHeader from "../components/SiteHeader.astro";

type Props = CollectionEntry<"blog">["data"] & {
  /** From getPostLanguage(); "th" for Thai posts. */
  lang?: "th" | "en";
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  lang = "en",
} = Astro.props;
// For share cards only: on the page, the cover sits right above the h1 and
// is decorative.
const coverAlt = `Cover image for ${title}`;
// English page chrome inside a Thai post.
const chromeLang = lang === "en" ? undefined : "en";
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={heroImage}
      imageAlt={heroImage ? coverAlt : undefined}
      type="article"
      lang={lang}
      publishedTime={pubDate}
      modifiedTime={updatedDate}
    />
    <style>
      main {
        width: min(1020px, 100% - 32px);
        margin: 0 auto;
        padding: 24px 0 64px;
      }
      .hero-image img {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--window-shadow);
      }
      .title {
        padding-top: 1.5em;
        text-align: center;
      }
      .title h1 {
        margin: 0 0 0.5em 0;
        color: var(--text-primary);
        font-size: clamp(1.75rem, 1.25rem + 2vw, 2.5rem);
        line-height: 1.3;
      }
      .date {
        margin-bottom: 0.75em;
        color: var(--text-secondary);
        font-family: var(--font-mono);
        font-size: 0.875rem;
      }
      .last-updated-on {
        font-style: italic;
      }
      .post-footer {
        max-width: 720px;
        margin: 3em auto 0;
        padding-top: 1.5em;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 12px 24px;
        border-top: 1px solid var(--glass-border);
      }
      .post-footer a {
        color: var(--accent-cyan);
        font-weight: 600;
        text-decoration: none;
      }
      .post-footer a:hover {
        color: var(--text-primary);
      }
      .post-footer a:focus-visible {
        outline: 3px solid var(--accent-secondary);
        outline-offset: 3px;
      }
    </style>
  </head>

  <body>
    <SiteHeader />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                loading="eager"
                fetchpriority="high"
              />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date" lang={chromeLang}>
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
      <nav class="post-footer" aria-label="Blog" lang={chromeLang}>
        <a href="/blog/"><span aria-hidden="true">← </span>All posts</a>
        <a href="/rss.xml">Subscribe via RSS</a>
      </nav>
    </main>
  </body>
</html>
