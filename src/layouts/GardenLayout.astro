---
import type { MarkdownHeading } from "astro";
import { Font } from "astro:assets";
import BaseHead from "@components/BaseHead.astro";
import BrandMark from "@components/BrandMark.astro";
import GardenTree from "@components/garden/GardenTree.astro";
import "@styles/website-mode.css";
import "@styles/garden.css";
import { buildGardenTree, getGardenNotes } from "@utils/garden";

interface Props {
  title: string;
  description: string;
  /** Id of the note being shown; omitted on the garden home. */
  current?: string;
  headings?: MarkdownHeading[];
}

const { title, description, current, headings = [] } = Astro.props;
const tree = buildGardenTree(await getGardenNotes());
const toc = headings.filter(({ depth }) => depth <= 3);
---

<!-- The garden is part of website mode: same tokens, type, and header. -->
<html lang="en" data-site-mode="website">
  <head>
    <BaseHead
      title={`${title} | PePoDev Garden`}
      description={description}
      type={current ? "article" : "website"}
    />
    <Font cssVariable="--font-plex-sans" />
    <Font cssVariable="--font-plex-thai" />
    <Font cssVariable="--font-plex-mono" />
    <script is:inline data-cfasync="false">
      // Before first paint: the saved light/dark theme, or the desktop's own
      // inside the desktop Garden window (whose titlebar then replaces the site
      // header). Theme changes made elsewhere are followed live.
      const root = document.documentElement;
      const embedded = window.top !== window.self;
      if (embedded) root.dataset.embed = "";
      try {
        root.dataset.theme =
          (embedded && parent.document.documentElement.dataset.theme) ||
          JSON.parse(localStorage.getItem("pepodev.desktopPrefs") || "{}").theme ||
          localStorage.getItem("pepodev.theme") ||
          "dark";
      } catch {
        root.dataset.theme = "dark";
      }
      addEventListener("storage", (event) => {
        if (event.key === "pepodev.theme" && event.newValue) root.dataset.theme = event.newValue;
      });
    </script>
  </head>

  <body>
    <div class="garden-shell">
      <a class="website-skip-link" href="#garden-main">Skip to content</a>
      <header class="website-header garden-header">
        <div class="ws-header-inner">
          <a class="ws-brand" href="/" aria-label="pepo.dev home">
            <BrandMark size={26} />
            <span>pepo.dev</span>
          </a>
          <nav class="ws-nav" aria-label="Site">
            <a href="/garden/" aria-current={current ? undefined : "page"}>Garden</a>
            <a href="/blog/">Writing</a>
            <a href="/resume/">Resume</a>
          </nav>
        </div>
      </header>

      <div class="garden-layout">
        <main id="garden-main" class="garden-main">
          <slot />
        </main>

        <aside class="garden-sidebar" aria-label="Garden notes">
          <input
            class="garden-filter"
            type="search"
            placeholder="Filter notes"
            aria-label="Filter notes"
            data-garden-filter
          />
          <div data-garden-tree>
            <GardenTree folder={tree} current={current} />
          </div>
          <p class="garden-filter-empty" data-garden-filter-empty hidden>
            No notes match.
          </p>
        </aside>

        {
          toc.length > 1 && (
            <nav class="garden-toc" aria-label="On this page">
              <p>On this page</p>
              <ul>
                {toc.map(({ depth, slug, text }) => (
                  <li data-depth={depth}>
                    <a href={`#${slug}`}>{text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </div>

    <script>
      const input = document.querySelector<HTMLInputElement>("[data-garden-filter]");
      const tree = document.querySelector<HTMLElement>("[data-garden-tree]");
      const empty = document.querySelector<HTMLElement>("[data-garden-filter-empty]");

      input?.addEventListener("input", () => {
        if (!tree || !empty) return;
        const query = input.value.trim().toLowerCase();
        tree.querySelectorAll<HTMLElement>("[data-note]").forEach((item) => {
          item.hidden = query !== "" && !item.dataset.note?.includes(query);
        });
        // Deepest folders first, so a parent sees its children's final state.
        [...tree.querySelectorAll<HTMLDetailsElement>("details")].reverse().forEach((details) => {
          const match = details.querySelector("[data-note]:not([hidden])");
          details.parentElement!.hidden = query !== "" && !match;
          details.open = query ? Boolean(match) : details.hasAttribute("data-open");
        });
        empty.hidden = query === "" || Boolean(tree.querySelector("[data-note]:not([hidden])"));
      });

      // In the desktop Garden window, events inside this frame never reach the
      // desktop. Re-send the ones it needs: window focus (click or Tab), closing
      // menus on click, Escape-to-close, and Ctrl/Cmd+K.
      const frame = window.frameElement;
      if (frame) {
        for (const type of ["mousedown", "click", "focusin"]) {
          document.addEventListener(type, () => {
            frame.dispatchEvent(new Event(type, { bubbles: true }));
          });
        }
        // Anything outside the garden opens in a new tab, not inside the window.
        document.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
          if (link.origin !== location.origin || !link.pathname.startsWith("/garden/")) {
            link.target = "_blank";
            link.rel = "noopener";
          }
        });
        document.addEventListener("keydown", (event) => {
          const palette = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k";
          if (event.key !== "Escape" && !palette) return;
          // Escape first clears a filled-in filter, like any search field.
          if (event.key === "Escape" && event.target === input && input?.value) return;
          const forwarded = new KeyboardEvent("keydown", {
            key: event.key,
            ctrlKey: event.ctrlKey,
            metaKey: event.metaKey,
            bubbles: true,
            cancelable: true,
          });
          window.parent.document.dispatchEvent(forwarded);
          if (forwarded.defaultPrevented) event.preventDefault();
        });
      }
    </script>
  </body>
</html>
