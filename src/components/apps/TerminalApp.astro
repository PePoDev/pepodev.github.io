---
import skills from "@data/skills.json";

const skillNames = skills.map((skill) => skill.name);
const commands = [
  "help",
  "whoami",
  "skills",
  "projects",
  "uptime",
  "contact",
  "clear",
];
---

<div class="app-content terminal-app" data-terminal-app>
  <div class="terminal-output" data-terminal-output>
    <div><span class="terminal-muted">pepo-shell v1.0</span></div>
    <div>Type <span class="terminal-accent">help</span> to list commands.</div>
  </div>
  <form class="terminal-input-row" data-terminal-form>
    <span>pepo@desktop:~$</span>
    <input
      data-terminal-input
      type="text"
      autocomplete="off"
      spellcheck="false"
      aria-label="Terminal command"
    />
  </form>
</div>

<script define:vars={{ commands, skillNames }} is:inline>
  // @ts-nocheck
  function initTerminal() {
    const app = document.querySelector("[data-terminal-app]");
    if (!app) return;

    const output = app.querySelector("[data-terminal-output]");
    const form = app.querySelector("[data-terminal-form]");
    const input = app.querySelector("[data-terminal-input]");
    const bootTime = Date.now();

    function print(text, className = "") {
      const line = document.createElement("div");
      if (className) line.className = className;
      line.textContent = text;
      output.appendChild(line);
      output.scrollTop = output.scrollHeight;
    }

    function openApp(appId) {
      document.dispatchEvent(
        new CustomEvent("desktop:open-app", { detail: { appId } }),
      );
    }

    function execute(raw) {
      const command = raw.trim().toLowerCase();
      print("pepo@desktop:~$ " + raw, "terminal-command");

      if (!command) return;
      if (command === "clear") {
        output.innerHTML = "";
        return;
      }
      if (command === "help") {
        print("Available commands: " + commands.join(", "));
      } else if (command === "whoami") {
        print(
          "Pepo - Site Reliability Engineer focused on cloud platforms, observability, IaC, GitOps, and production resilience.",
        );
      } else if (command === "skills") {
        print(skillNames.join(", ") + ".");
      } else if (command === "projects") {
        print("Opening Projects...");
        openApp("project");
      } else if (command === "uptime") {
        const seconds = Math.floor((Date.now() - bootTime) / 1000);
        print("desktop uptime: " + seconds + "s");
      } else if (command === "contact") {
        print("pepo@pepo.dev | github.com/pepodev | linkedin.com/in/pepodev");
      } else {
        print("command not found: " + raw, "terminal-error");
      }
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      execute(input.value);
      input.value = "";
    });

    app.addEventListener("click", () => input.focus());

    // Opening, restoring or re-launching the window focuses the input. Touch
    // screens wait for a tap unless the keyboard opened it, since focus
    // raises the on-screen keyboard over the window.
    const win = app.closest("[data-window]");
    const touchQuery = window.matchMedia(
      "(max-width: 768px), (hover: none), (pointer: coarse)",
    );
    function focusInput(keyboard) {
      if (keyboard || !touchQuery.matches) input.focus({ preventScroll: true });
    }
    win?.addEventListener("desktop:window-focus", (event) =>
      focusInput(event.detail?.keyboard),
    );
    // Rocket Loader can run this after the window opened.
    const active = document.activeElement;
    if (
      win?.classList.contains("focused") &&
      win.getAttribute("aria-hidden") === "false" &&
      (active === win || active === document.body)
    ) {
      focusInput(active === win);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initTerminal);
  } else {
    initTerminal();
  }
</script>
