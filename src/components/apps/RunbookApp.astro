---
const runbooks = [
  {
    title: "Kafka consumer lag spike",
    tags: "kafka observability",
    steps: ["Check consumer group lag by partition", "Scale consumers or pause producers", "Inspect broker IO and rebalance events"],
  },
  {
    title: "Kubernetes node pressure",
    tags: "kubernetes capacity",
    steps: ["Find pressure signal and noisy pods", "Drain only after PDB review", "Tune requests or add capacity"],
  },
  {
    title: "Datadog cost anomaly",
    tags: "cost monitoring",
    steps: ["Review indexed logs and custom metrics", "Identify new tag cardinality", "Apply retention and sampling controls"],
  },
  {
    title: "Rollback deployment",
    tags: "gitops incident",
    steps: ["Freeze rollout", "Promote previous stable revision", "Verify SLO recovery and write timeline note"],
  },
];
---

<div class="app-content ops-app runbook-app" data-runbook-app>
  <input
    class="runbook-search"
    data-runbook-search
    type="search"
    placeholder="Search runbooks..."
    aria-label="Search runbooks"
  />
  <div class="runbook-list">
    {runbooks.map((runbook) => (
      <article class="runbook-card" data-runbook-card data-search={`${runbook.title} ${runbook.tags}`}>
        <span class="ops-pill">{runbook.tags}</span>
        <h3>{runbook.title}</h3>
        <ol>
          {runbook.steps.map((step) => <li>{step}</li>)}
        </ol>
      </article>
    ))}
  </div>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const app = document.querySelector("[data-runbook-app]");
    if (!app) return;
    const search = app.querySelector("[data-runbook-search]");
    search.addEventListener("input", () => {
      const query = search.value.toLowerCase();
      app.querySelectorAll("[data-runbook-card]").forEach((card) => {
        card.hidden = !card.dataset.search.toLowerCase().includes(query);
      });
    });
  });
</script>
