<div class="app-content calculator-app" data-calculator>
  <div class="calculator-display" aria-live="polite">
    <div class="calculator-history"></div>
    <div class="calculator-value" tabindex="-1">0</div>
  </div>

  <div class="calculator-grid">
    <button type="button" data-action="clear">AC</button>
    <button type="button" data-action="backspace">DEL</button>
    <button type="button" data-token="%">%</button>
    <button type="button" class="calculator-op" data-token="/">/</button>
    <button type="button" data-token="7">7</button>
    <button type="button" data-token="8">8</button>
    <button type="button" data-token="9">9</button>
    <button type="button" class="calculator-op" data-token="*">*</button>
    <button type="button" data-token="4">4</button>
    <button type="button" data-token="5">5</button>
    <button type="button" data-token="6">6</button>
    <button type="button" class="calculator-op" data-token="-">-</button>
    <button type="button" data-token="1">1</button>
    <button type="button" data-token="2">2</button>
    <button type="button" data-token="3">3</button>
    <button type="button" class="calculator-op" data-token="+">+</button>
    <button type="button" class="calculator-zero" data-token="0">0</button>
    <button type="button" data-token=".">.</button>
    <button type="button" class="calculator-equals" data-action="equals"
      >=</button
    >
  </div>
</div>

<script>
  import { isAppKeyboardEvent } from "@utils/app-keyboard";

  function initCalculator() {
    document.querySelectorAll("[data-calculator]").forEach((calculator) => {
      if (calculator.dataset.ready === "true") return;
      calculator.dataset.ready = "true";

      const valueEl = calculator.querySelector(".calculator-value");
      const historyEl = calculator.querySelector(".calculator-history");
      let expression = "";
      let justEvaluated = false;

      function render(history = "", isResult = false) {
        valueEl.textContent = expression || "0";
        historyEl.textContent = history;
        // While typing, keep the newest digits in view; a result reads from
        // its first digit. History always shows its end: the latest step.
        valueEl.scrollLeft = isResult ? 0 : valueEl.scrollWidth;
        historyEl.scrollLeft = historyEl.scrollWidth;
        markCutEdges(valueEl);
        markCutEdges(historyEl);
      }

      // A faded edge marks digits scrolled out of view.
      function markCutEdges(element) {
        const hidden = element.scrollWidth - element.clientWidth;
        element.classList.toggle("is-cut-start", element.scrollLeft > 1);
        element.classList.toggle("is-cut-end", element.scrollLeft < hidden - 1);
      }

      const edgeObserver = new ResizeObserver((entries) => {
        entries.forEach((entry) => markCutEdges(entry.target));
      });
      [valueEl, historyEl].forEach((element) => {
        element.addEventListener("scroll", () => markCutEdges(element), {
          passive: true,
        });
        edgeObserver.observe(element);
      });

      function appendToken(token) {
        if (justEvaluated && /[\d.]/.test(token)) expression = "";
        justEvaluated = false;

        // One decimal point per number.
        if (token === "." && /(?:^|[+\-*/%])\d*\.\d*$/.test(expression)) {
          return;
        }
        if (/[+\-*/%]/.test(token) && /[+\-*/%]$/.test(expression)) {
          expression = expression.slice(0, -1);
        }
        // A digit replaces a lone leading 0; "05" is a syntax error.
        if (/\d/.test(token) && /(?:^|[+\-*/])0$/.test(expression)) {
          expression = expression.slice(0, -1);
        }

        expression += token;
        render();
      }

      // Errors keep the expression on screen so it can be fixed.
      function calculate() {
        if (!expression) return;
        // Large results come back in exponent form (1e+22); allow that "e"
        // between digits so they can be calculated with.
        const withoutExponents = expression.replace(/(\d)e([+-]?\d)/g, "$1$2");
        if (!/^[\d+\-*/%. ()]+$/.test(withoutExponents)) {
          render("Invalid expression");
          return;
        }
        if (/[+\-*/]$/.test(expression)) {
          render("Incomplete expression");
          return;
        }

        let result;
        try {
          const evaluableExpression = normalizePercentExpression(expression);
          result = Function(`"use strict"; return (${evaluableExpression})`)();
        } catch {
          render("Invalid expression");
          return;
        }

        if (!Number.isFinite(result)) {
          render(
            /\/[0.]+(?![\d.])/.test(expression)
              ? "Cannot divide by 0"
              : "Number too large",
          );
          return;
        }

        const previous = expression;
        expression = String(Number.parseFloat(result.toFixed(10)));
        justEvaluated = true;
        render(previous + " =", true);
      }

      function normalizePercentExpression(value) {
        return value.replace(/(\d+(?:\.\d+)?(?:e[+-]?\d+)?)%/g, "($1/100)");
      }

      calculator.addEventListener("click", (event) => {
        const button = event.target.closest("button");
        if (!button) return;

        if (button.dataset.token) appendToken(button.dataset.token);
        if (button.dataset.action === "clear") {
          expression = "";
          justEvaluated = false;
          render();
        }
        if (button.dataset.action === "backspace") {
          expression = expression.slice(0, -1);
          render();
        }
        if (button.dataset.action === "equals") calculate();
      });

      document.addEventListener("keydown", (event) => {
        if (!isAppKeyboardEvent(event, calculator.closest(".window"))) return;

        if (/^[\d+\-*/%.]$/.test(event.key)) {
          event.preventDefault();
          appendToken(event.key);
        } else if (event.key === "Enter" || event.key === "=") {
          event.preventDefault();
          calculate();
        } else if (event.key === "Backspace") {
          event.preventDefault();
          expression = expression.slice(0, -1);
          render();
        } else if (event.key === "Escape") {
          // Escape also closes the window (WindowController), so the next
          // open starts from 0.
          expression = "";
          render();
        }
      });
    });
  }

  // Initialize immediately if DOM is ready, otherwise wait for DOMContentLoaded
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCalculator);
  } else {
    initCalculator();
  }
</script>
