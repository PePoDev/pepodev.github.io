---
import { getCollection, render } from "astro:content";

const posts = await Promise.all(
  (await getCollection("blog"))
    .filter((post) => post.data.publish !== false)
    .sort((a, b) => {
      const aDate = a.data.pubDate || new Date(0);
      const bDate = b.data.pubDate || new Date(0);
      return bDate.valueOf() - aDate.valueOf();
    })
    .map(async (post) => {
      const { Content } = await render(post);
      return { post, Content };
    }),
);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  }).format(date);
---

<div class="app-content" data-blog-app>
  <div class="terminal-heading" data-blog-terminal>
    <span class="prompt">~/blog $</span>
    <span data-blog-command>ls articles/</span>
  </div>
  <div class="blog-list-view" data-blog-list-view>
    <h2>Latest Articles</h2>
    <p class="app-subtitle">
      Postmortems, write-ups, and lessons from the trenches
    </p>
    <div class="blog-list">
      {
        posts.map(({ post }, index) => {
          const title = post.data.title || post.id;
          const description =
            post.data.description || post.data["sub-title"] || "";
          return (
            <button
              class="blog-item"
              type="button"
              data-blog-index={index}
              data-blog-slug={post.id}
            >
              <div class="blog-item-title">{title}</div>
              {post.data.pubDate && (
                <div class="blog-item-meta">
                  {formatDate(post.data.pubDate)}
                </div>
              )}
              <div class="blog-item-desc">{description}</div>
            </button>
          );
        })
      }
    </div>
  </div>
  <div class="blog-reader" data-blog-reader>
    {
      posts.map(({ post, Content }, index) => {
        const title = post.data.title || post.id;
        return (
          <article
            class="blog-post-panel"
            data-blog-post={index}
            data-blog-slug={post.id}
            hidden
          >
            <div class="blog-reader-header">
              <button class="blog-reader-back" type="button" data-blog-back>
                Back to articles
              </button>
              <h2 class="blog-reader-title">{title}</h2>
              {post.data.pubDate && (
                <div class="blog-reader-date">
                  {formatDate(post.data.pubDate)}
                </div>
              )}
            </div>
            <div class="blog-reader-body">
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</div>

<script>
  function initBlog() {
    document.querySelectorAll("[data-blog-app]").forEach((app) => {
      const listView = app.querySelector(
        "[data-blog-list-view]",
      ) as HTMLElement | null;
      const reader = app.querySelector(
        "[data-blog-reader]",
      ) as HTMLElement | null;
      const panels = app.querySelectorAll("[data-blog-post]");
      const terminalCommand = app.querySelector(
        "[data-blog-command]",
      ) as HTMLElement | null;

      function updateTerminalPath(slug?: string) {
        if (terminalCommand) {
          if (slug) {
            terminalCommand.textContent = `cat articles/${slug}`;
          } else {
            terminalCommand.textContent = "ls articles/";
          }
        }
      }

      function showList() {
        if (listView) listView.style.display = "";
        if (reader) reader.classList.remove("active");
        panels.forEach((panel) => {
          (panel as HTMLElement).hidden = true;
        });
        updateTerminalPath();
      }

      function openArticleBySlug(slug: string) {
        console.log("Opening article with slug:", slug);
        const panel = app.querySelector(
          `[data-blog-post][data-blog-slug="${slug}"]`,
        ) as HTMLElement;
        console.log("Found panel:", panel);
        if (!panel) {
          console.log(
            "Available slugs:",
            Array.from(panels).map((p) => (p as HTMLElement).dataset.blogSlug),
          );
          return false;
        }

        const index = panel.dataset.blogPost;
        console.log("Panel index:", index);
        if (!index) return false;

        if (listView) listView.style.display = "none";
        if (reader) reader.classList.add("active");
        panels.forEach((p) => {
          (p as HTMLElement).hidden =
            (p as HTMLElement).dataset.blogPost !== index;
        });
        updateTerminalPath(slug);
        return true;
      }

      // Expose the function globally for URL deep linking
      (window as any).__pepodevBlogOpenSlug = openArticleBySlug;

      app.querySelectorAll("[data-blog-index]").forEach((item) => {
        item.addEventListener("click", () => {
          const index = (item as HTMLElement).dataset.blogIndex;
          const slug = (item as HTMLElement).dataset.blogSlug;
          if (listView) listView.style.display = "none";
          if (reader) reader.classList.add("active");
          panels.forEach((panel) => {
            (panel as HTMLElement).hidden =
              (panel as HTMLElement).dataset.blogPost !== index;
          });
          updateTerminalPath(slug);
        });
      });

      app.querySelectorAll("[data-blog-back]").forEach((button) => {
        button.addEventListener("click", showList);
      });

      app
        .closest("[data-window]")
        ?.addEventListener("desktop:window-close", showList);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBlog);
  } else {
    initBlog();
  }
</script>
