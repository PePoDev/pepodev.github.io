---
import { render } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import {
  getPostDescription,
  getPostLanguage,
  getPublishedPosts,
} from "@utils/blog";

const posts = await Promise.all(
  (await getPublishedPosts()).map(async (post) => {
    const { Content } = await render(post);
    return { post, Content, lang: getPostLanguage(post) };
  }),
);
---

<div class="app-content" data-blog-app>
  <div class="terminal-heading" data-blog-terminal>
    <span class="prompt">~/blog $</span>
    <span data-blog-command>ls articles/</span>
  </div>
  <div class="blog-list-view" data-blog-list-view>
    <h2>Latest Articles</h2>
    <p class="app-subtitle">
      Postmortems, write-ups, and lessons from the trenches
    </p>
    <div class="blog-list">
      {
        posts.map(({ post, lang }, index) => {
          const description = getPostDescription(post);
          return (
            <button
              class="blog-item"
              type="button"
              data-blog-index={index}
              data-blog-slug={post.id}
            >
              <div class="blog-item-title" lang={lang}>
                {post.data.title}
              </div>
              <div class="blog-item-meta">
                <FormattedDate date={post.data.pubDate} />
              </div>
              <div class="blog-item-desc" lang={lang}>
                {description}
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="blog-item-tags">
                  {post.data.tags.map((tag) => (
                    <span class="blog-tag">{tag}</span>
                  ))}
                </div>
              )}
            </button>
          );
        })
      }
    </div>
  </div>
  <div class="blog-reader" data-blog-reader>
    {
      posts.map(({ post, Content, lang }, index) => {
        return (
          <article
            class="blog-post-panel"
            data-blog-post={index}
            data-blog-slug={post.id}
            hidden
          >
            <div class="blog-reader-header">
              <button class="blog-reader-back" type="button" data-blog-back>
                Back to articles
              </button>
              <button
                class="blog-reader-share"
                type="button"
                data-blog-share
                data-blog-slug-share={post.id}
                title="Share article"
              >
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="18" cy="5" r="3" />
                  <circle cx="6" cy="12" r="3" />
                  <circle cx="18" cy="19" r="3" />
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                </svg>
              </button>
              <h2 class="blog-reader-title" lang={lang}>
                {post.data.title}
              </h2>
              <div class="blog-reader-date">
                <FormattedDate date={post.data.pubDate} />
              </div>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="blog-reader-tags">
                  {post.data.tags.map((tag) => (
                    <span class="blog-tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <div class="blog-reader-body" lang={lang}>
              <Content />
            </div>
          </article>
        );
      })
    }
  </div>
</div>

<script>
  function initBlog() {
    document.querySelectorAll("[data-blog-app]").forEach((app) => {
      const listView = app.querySelector(
        "[data-blog-list-view]",
      ) as HTMLElement | null;
      const reader = app.querySelector(
        "[data-blog-reader]",
      ) as HTMLElement | null;
      const panels = app.querySelectorAll("[data-blog-post]");
      const terminalCommand = app.querySelector(
        "[data-blog-command]",
      ) as HTMLElement | null;
      // The list and the reader share the window's scroller.
      const scroller = app.closest(".window-content") as HTMLElement | null;
      let listScrollTop = 0;

      function updateTerminalPath(slug?: string) {
        if (terminalCommand) {
          if (slug) {
            terminalCommand.textContent = `cat articles/${slug}`;
          } else {
            terminalCommand.textContent = "ls articles/";
          }
        }
      }

      // Back returns to where the list was; closing the window resets it.
      function showList(restoreScroll: boolean) {
        if (listView) listView.style.display = "";
        if (reader) reader.classList.remove("active");
        panels.forEach((panel) => {
          (panel as HTMLElement).hidden = true;
        });
        updateTerminalPath();
        if (!restoreScroll) listScrollTop = 0;
        if (scroller) scroller.scrollTop = listScrollTop;
      }

      // Focus follows the view, so the keyboard never drops to the page:
      // into the article's Back button, then back to the article's item.
      // Neither scrolls, since both views set their own scroll position.
      // An unknown slug leaves the list open with focus on its first item.
      function openArticleBySlug(slug: string, { focus = false } = {}) {
        const panel = Array.from(panels).find(
          (p) => (p as HTMLElement).dataset.blogSlug === slug,
        ) as HTMLElement | undefined;
        if (!panel) {
          if (focus) {
            app
              .querySelector<HTMLElement>("[data-blog-index]")
              ?.focus({ preventScroll: true });
          }
          return false;
        }

        const index = panel.dataset.blogPost;
        if (typeof index === "undefined") return false;

        if (scroller && !reader?.classList.contains("active")) {
          listScrollTop = scroller.scrollTop;
        }
        if (listView) listView.style.display = "none";
        if (reader) reader.classList.add("active");
        panels.forEach((p) => {
          (p as HTMLElement).hidden =
            (p as HTMLElement).dataset.blogPost !== index;
        });
        updateTerminalPath(slug);
        // Every article opens at its title.
        if (scroller) scroller.scrollTop = 0;
        if (focus) {
          panel
            .querySelector<HTMLElement>("[data-blog-back]")
            ?.focus({ preventScroll: true });
        }
        return true;
      }

      // URL deep links (?blog=) open articles through this, focus included.
      (window as any).__pepodevBlogOpenSlug = (slug: string) =>
        openArticleBySlug(slug, { focus: true });

      app.querySelectorAll("[data-blog-index]").forEach((item) => {
        item.addEventListener("click", () => {
          const slug = (item as HTMLElement).dataset.blogSlug;
          if (slug) openArticleBySlug(slug, { focus: true });
        });
      });

      app.querySelectorAll("[data-blog-back]").forEach((button) => {
        button.addEventListener("click", () => {
          const slug =
            button.closest<HTMLElement>("[data-blog-post]")?.dataset.blogSlug;
          showList(true);
          Array.from(app.querySelectorAll<HTMLElement>("[data-blog-index]"))
            .find((item) => item.dataset.blogSlug === slug)
            ?.focus({ preventScroll: true });
        });
      });

      // Article links open in a new tab, so the desktop never navigates away.
      app
        .querySelectorAll<HTMLAnchorElement>(".blog-reader-body a[href]")
        .forEach((link) => {
          const url = new URL(link.href, window.location.href);
          const samePage =
            url.origin === window.location.origin &&
            url.pathname === window.location.pathname;
          if (!/^https?:$/.test(url.protocol) || samePage) return;
          link.target = "_blank";
          link.relList.add("noopener", "noreferrer");
        });

      app.querySelectorAll("[data-blog-share]").forEach((button) => {
        button.addEventListener("click", () => {
          const slug = (button as HTMLElement).dataset.blogSlugShare;
          if (!slug) return;

          const url = `${window.location.origin}${window.location.pathname}?blog=${encodeURIComponent(
            slug,
          )}`;

          navigator.clipboard
            .writeText(url)
            .then(() => {
              // Show toast notification
              const event = new CustomEvent("desktop:show-toast", {
                detail: {
                  message: "Link copied to clipboard!",
                  duration: 3000,
                },
              });
              document.dispatchEvent(event);
            })
            .catch((err) => {
              console.error("Failed to copy link:", err);
              const event = new CustomEvent("desktop:show-toast", {
                detail: {
                  message: "Failed to copy link",
                  duration: 3000,
                },
              });
              document.dispatchEvent(event);
            });
        });
      });

      app
        .closest("[data-window]")
        ?.addEventListener("desktop:window-close", () => showList(false));
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBlog);
  } else {
    initBlog();
  }
</script>
