---

<div class="app-content reliability-arcade ops-app" data-reliability-arcade>
  <section class="arcade-sidebar" aria-label="Reliability arcade apps">
    <div>
      <span class="ops-pill">interactive lab</span>
      <h2>Reliability Arcade</h2>
      <p>Pick a module, make operational calls, and watch health, cost, and the event log react.</p>
    </div>
    <div class="arcade-module-list">
      {
        modules.map((module, index) => (
          <button
            type="button"
            class:list={["arcade-module-tab", index === 0 && "active"]}
            data-arcade-tab={module.id}
          >
            <span>{module.code}</span>
            <strong>{module.name}</strong>
          </button>
        ))
      }
    </div>
  </section>

  <section class="arcade-stage">
    <div class="arcade-hud">
      <div class="ops-stat">
        <span>Health</span>
        <strong data-arcade-health>82%</strong>
        <small>service status</small>
      </div>
      <div class="ops-stat">
        <span>Score</span>
        <strong data-arcade-score>0</strong>
        <small>decision quality</small>
      </div>
      <div class="ops-stat">
        <span>Cost</span>
        <strong data-arcade-cost>$0</strong>
        <small>change delta</small>
      </div>
    </div>

    <div class="arcade-panel">
      {
        modules.map((module, index) => (
          <article
            class:list={["arcade-module", index === 0 && "active"]}
            data-arcade-module={module.id}
          >
            <div class="arcade-module-header">
              <div>
                <span class="ops-pill">{module.stat}: {module.value}</span>
                <h3>{module.name}</h3>
                <p>{module.description}</p>
              </div>
              <div class="arcade-icon" aria-hidden="true">{module.code}</div>
            </div>
            <div class="arcade-playfield">
              <div class="arcade-system-map" aria-hidden="true">
                <span class="node active">edge</span>
                <span class="line"></span>
                <span class="node">api</span>
                <span class="line"></span>
                <span class="node warn">data</span>
                <span class="line"></span>
                <span class="node">ops</span>
              </div>
              <div class="arcade-actions">
                {
                  module.actions.map(([label, health, cost, result]) => (
                    <button
                      type="button"
                      data-arcade-action
                      data-health={health}
                      data-cost={cost}
                      data-result={result}
                    >
                      {label}
                    </button>
                  ))
                }
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="arcade-log" data-arcade-log aria-live="polite">
      <div><strong>00:00</strong><span>Select a module and run the first decision.</span></div>
    </div>
  </section>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-reliability-arcade]").forEach((root) => {
      const tabs = Array.from(root.querySelectorAll("[data-arcade-tab]"));
      const modules = Array.from(root.querySelectorAll("[data-arcade-module]"));
      const healthEl = root.querySelector("[data-arcade-health]");
      const scoreEl = root.querySelector("[data-arcade-score]");
      const costEl = root.querySelector("[data-arcade-cost]");
      const log = root.querySelector("[data-arcade-log]");
      let health = 82;
      let score = 0;
      let cost = 0;
      let ticks = 0;

      function clamp(value, min, max) {
        return Math.min(max, Math.max(min, value));
      }

      function renderStats() {
        healthEl.textContent = health + "%";
        scoreEl.textContent = String(score);
        costEl.textContent = (cost < 0 ? "-$" : "$") + Math.abs(cost) + "k";
        healthEl.style.color =
          health >= 75 ? "var(--accent-green)" : health >= 45 ? "var(--accent-amber)" : "var(--accent-red)";
      }

      function addLog(message) {
        ticks += 1;
        const row = document.createElement("div");
        const time = document.createElement("strong");
        const text = document.createElement("span");
        time.textContent = "00:" + String(ticks * 7).padStart(2, "0");
        text.textContent = message;
        row.prepend(time);
        row.append(text);
        log.prepend(row);
        while (log.children.length > 6) log.lastElementChild.remove();
      }

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          const id = tab.dataset.arcadeTab;
          tabs.forEach((item) => item.classList.toggle("active", item === tab));
          modules.forEach((module) => {
            module.classList.toggle("active", module.dataset.arcadeModule === id);
          });
          addLog("Loaded " + tab.querySelector("strong").textContent + ".");
        });
      });

      root.querySelectorAll("[data-arcade-action]").forEach((button) => {
        button.addEventListener("click", () => {
          const healthDelta = Number(button.dataset.health || 0);
          const costDelta = Number(button.dataset.cost || 0);
          health = clamp(health + healthDelta, 0, 100);
          cost += costDelta;
          score = clamp(score + healthDelta - Math.max(0, costDelta - 6), -99, 999);
          renderStats();
          addLog(button.dataset.result);
        });
      });

      renderStats();
    });
  });
</script>
