---
// The garden pages are full static pages, so the window frames them instead of
// rendering every note into index.html. Lazy loading defers the first request
// until the window opens.
---

<iframe
  class="garden-frame"
  src="/garden/"
  title="Digital garden"
  loading="lazy"
  data-garden-frame></iframe>

<style>
  .garden-frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: var(--bg-primary);
  }
</style>

<script>
  // Mouse events over the frame never reach the page, so let window drags and
  // resizes pass over it until the button is released.
  const frame = document.querySelector<HTMLIFrameElement>("[data-garden-frame]");
  const win = frame?.closest<HTMLElement>("[data-window]");
  win?.querySelectorAll(".window-titlebar, .window-resize-handle").forEach((handle) => {
    handle.addEventListener("mousedown", () => frame!.style.setProperty("pointer-events", "none"));
  });
  document.addEventListener("mouseup", () => frame?.style.removeProperty("pointer-events"));
</script>
