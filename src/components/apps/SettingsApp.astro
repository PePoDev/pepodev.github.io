---
import { getMusicTracks } from "@data/music";
import { accentMap, backgroundMap } from "@utils/desktop-prefs";

const accents = [
  { id: "green", label: "Green", color: "#30d158" },
  { id: "cyan", label: "Cyan", color: "#64d2ff" },
  { id: "purple", label: "Purple", color: "#bf5af2" },
  { id: "amber", label: "Amber", color: "#ff9f0a" },
];

const tracks = getMusicTracks().map((track) => ({
  id: track.id,
  label: track.title,
}));
const defaultTrackId = tracks[0]?.id ?? "";
---

<div class="app-content settings-app" data-settings-app>
  <div class="settings-layout">
    <section class="settings-panel">
      <h2>Appearance</h2>
      <div class="settings-grid">
        <label class="settings-field">
          <span>Theme</span>
          <select data-setting="theme">
            <option value="dark">Dark</option>
            <option value="light">Light</option>
          </select>
        </label>

        <label class="settings-field">
          <span>Background</span>
          <select data-setting="background" data-background-select>
            <!-- Options will be populated dynamically based on theme -->
          </select>
        </label>

        <label class="settings-field">
          <span>Window radius</span>
          <input
            data-setting="radius"
            type="range"
            min="6"
            max="20"
            value="6"
          />
        </label>

        <label class="settings-field">
          <span>Glass opacity</span>
          <input
            data-setting="glass"
            type="range"
            min="55"
            max="90"
            value="55"
          />
        </label>

        <label class="settings-field settings-checkbox">
          <input data-setting="backgroundEffect" type="checkbox" />
          <span>Background effect</span>
        </label>

        <label class="settings-field settings-checkbox">
          <input data-setting="windowGlass" type="checkbox" />
          <span>Window glass style</span>
        </label>
      </div>

      <div
        class="settings-swatches"
        role="radiogroup"
        aria-label="Accent color"
      >
        {
          accents.map((accent) => (
            <button
              type="button"
              data-accent={accent.id}
              aria-label={`${accent.label} accent`}
              style={`--swatch: ${accent.color}`}
            />
          ))
        }
      </div>
    </section>

    <section class="settings-panel">
      <h2>Music</h2>
      <div class="settings-grid">
        <label class="settings-field">
          <span>Track</span>
          <select data-music-setting="track">
            {
              tracks.map((track) => (
                <option value={track.id}>{track.label}</option>
              ))
            }
          </select>
        </label>
      </div>

      <div class="settings-actions">
        <button type="button" data-music-setting="toggle">Play music</button>
        <button type="button" data-settings-reset>Reset all settings</button>
      </div>
      <p class="settings-status" data-settings-status role="status"></p>
    </section>
  </div>
</div>

<script
  define:vars={{ defaultTrackId, accentMap, backgroundMap }}
  is:inline
>
  // @ts-nocheck
  function initSettings() {
    const app = document.querySelector("[data-settings-app]");
    if (!app) return;

    const prefsKey = "pepodev.desktopPrefs";
    const musicKey = "pepodev.music";
    const defaults = {
      theme: localStorage.getItem("pepodev.theme") || "dark",
      accent: "green",
      radius: 6,
      glass: 55,
      backgroundEffect: true,
      windowGlass: true,
    };

    function updateRangeFill(input) {
      if (!input) return;
      const min = Number(input.min || 0);
      const max = Number(input.max || 100);
      const value = Number(input.value || min);
      const progress = max > min ? ((value - min) / (max - min)) * 100 : 0;
      input.style.setProperty(
        "--range-progress",
        Math.max(0, Math.min(100, progress)) + "%",
      );
    }

    const darkBackgroundsList = [
      { id: "network", label: "Primary" },
      { id: "aurora", label: "Aurora" },
      { id: "midnight", label: "Midnight" },
      { id: "ember", label: "Ember" },
      { id: "ocean", label: "Ocean Deep" },
      { id: "glacier", label: "Glacier" },
      { id: "void", label: "Void" },
      { id: "neon", label: "Neon City" },
      { id: "plasma", label: "Plasma" },
      { id: "storm", label: "Storm" },
      { id: "matrix", label: "Matrix" },
      { id: "sakura", label: "Sakura" },
      { id: "forest", label: "Forest" },
      { id: "sunset", label: "Sunset" },
      { id: "copper", label: "Copper" },
    ];

    const lightBackgroundsList = [
      { id: "cloud", label: "Cloud" },
      { id: "daylight", label: "Daylight" },
      { id: "mint", label: "Mint" },
      { id: "peach", label: "Peach" },
      { id: "sky", label: "Sky" },
      { id: "lavender", label: "Lavender" },
      { id: "cream", label: "Cream" },
      { id: "rose", label: "Rose" },
      { id: "sage", label: "Sage" },
      { id: "coral", label: "Coral" },
      { id: "powder", label: "Powder Blue" },
      { id: "lemon", label: "Lemon" },
      { id: "blush", label: "Blush" },
      { id: "seafoam", label: "Seafoam" },
      { id: "sand", label: "Sand" },
    ];

    function getDefaultBackground(theme) {
      return theme === "light" ? "cloud" : "network";
    }

    function loadPrefs() {
      let saved = {};
      try {
        saved = JSON.parse(localStorage.getItem(prefsKey) || "{}");
      } catch {
        // Ignore corrupt persisted settings.
      }
      const prefs = { ...defaults, ...saved };
      // Like the theme script in index.astro, a missing background follows
      // the theme, so a light theme never starts on a dark background.
      if (!backgroundMap[prefs.background]) {
        prefs.background = getDefaultBackground(prefs.theme);
      }
      return prefs;
    }

    function loadMusic() {
      try {
        const raw = localStorage.getItem(musicKey);
        if (raw)
          return {
            track: defaultTrackId,
            playing: false,
            ...JSON.parse(raw),
          };
      } catch {
        // Ignore corrupt persisted settings.
      }
      return { track: defaultTrackId, playing: false };
    }

    function applyPrefs(prefs) {
      const root = document.documentElement;
      const accent = accentMap[prefs.accent] || accentMap.green;
      const background =
        backgroundMap[prefs.background] || backgroundMap.network;
      root.setAttribute("data-theme", prefs.theme);
      root.style.setProperty("--accent-primary", accent.primary);
      root.style.setProperty("--accent-secondary", accent.secondary);
      // Also update the main accent variables for backward compatibility
      root.style.setProperty("--accent-green", accent.primary);
      root.style.setProperty("--accent-cyan", accent.secondary);
      root.style.setProperty("--window-radius", `${prefs.radius}px`);
      root.style.setProperty(
        "--glass-bg",
        `rgba(${prefs.theme === "light" ? "255, 255, 255" : "44, 44, 46"}, ${
          prefs.glass / 100
        })`,
      );
      root.style.setProperty("--desktop-bg-color", background.bg);
      root.style.setProperty("--particle-primary-rgb", background.primary);
      root.style.setProperty("--particle-secondary-rgb", background.secondary);
      root.setAttribute(
        "data-background-effect",
        prefs.backgroundEffect ? "on" : "off",
      );
      root.setAttribute("data-window-glass", prefs.windowGlass ? "on" : "off");
      localStorage.setItem("pepodev.theme", prefs.theme);
      localStorage.setItem(prefsKey, JSON.stringify(prefs));
      document.dispatchEvent(
        new CustomEvent("desktop:preferences", { detail: prefs }),
      );
    }

    function populateBackgrounds(theme) {
      const backgroundSelect = app.querySelector("[data-background-select]");
      if (!backgroundSelect) return;

      const backgrounds =
        theme === "light" ? lightBackgroundsList : darkBackgroundsList;
      backgroundSelect.innerHTML = backgrounds
        .map((bg) => `<option value="${bg.id}">${bg.label}</option>`)
        .join("");
    }

    function render() {
      const prefs = loadPrefs();
      const music = loadMusic();

      // Populate backgrounds based on current theme
      populateBackgrounds(prefs.theme);

      app.querySelector('[data-setting="theme"]').value = prefs.theme;
      app.querySelector('[data-setting="background"]').value = prefs.background;
      app.querySelector('[data-setting="radius"]').value = String(prefs.radius);
      app.querySelector('[data-setting="glass"]').value = String(prefs.glass);
      app.querySelector('[data-setting="backgroundEffect"]').checked = Boolean(
        prefs.backgroundEffect,
      );
      app.querySelector('[data-setting="windowGlass"]').checked = Boolean(
        prefs.windowGlass,
      );
      app
        .querySelectorAll('input[type="range"]')
        .forEach((input) => updateRangeFill(input));
      app.querySelectorAll("[data-accent]").forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.accent === prefs.accent),
        );
      });
      app.querySelector('[data-music-setting="track"]').value = music.track;
      app.querySelector('[data-music-setting="toggle"]').textContent =
        music.playing ? "Pause music" : "Play music";
    }

    app.addEventListener("input", (event) => {
      const target = event.target;
      if (target.dataset.setting) {
        const prefs = loadPrefs();
        const oldTheme = prefs.theme;
        prefs[target.dataset.setting] =
          target.type === "range"
            ? Number(target.value)
            : target.type === "checkbox"
              ? target.checked
              : target.value;

        // A new theme starts on its own default background.
        if (target.dataset.setting === "theme" && oldTheme !== prefs.theme) {
          prefs.background = getDefaultBackground(prefs.theme);
        }

        applyPrefs(prefs);
      }
    });

    // The command palette's Toggle Theme asks Settings to switch, so both
    // apply the theme the same way.
    document.addEventListener("desktop:toggle-theme", () => {
      const prefs = loadPrefs();
      prefs.theme = prefs.theme === "light" ? "dark" : "light";
      prefs.background = getDefaultBackground(prefs.theme);
      applyPrefs(prefs);
    });

    app.addEventListener("change", (event) => {
      const target = event.target;
      if (target.dataset.musicSetting === "track") {
        const music = { ...loadMusic(), track: target.value };
        localStorage.setItem(musicKey, JSON.stringify(music));
        document.dispatchEvent(
          new CustomEvent("desktop:music-settings", { detail: music }),
        );
        render();
      }
    });

    const resetButton = app.querySelector("[data-settings-reset]");
    const status = app.querySelector("[data-settings-status]");
    const coarsePointer = window.matchMedia("(pointer: coarse)");

    function armReset() {
      resetButton.classList.add("confirming");
      status.textContent = coarsePointer.matches
        ? "Tap Reset all settings again to clear all settings and reload."
        : "Press Enter or click Reset all settings again to clear all settings and reload.";
    }

    // Leaving the button, clicking elsewhere, or closing the window cancels.
    function disarmReset() {
      if (!resetButton.classList.contains("confirming")) return;
      resetButton.classList.remove("confirming");
      status.textContent = "";
    }

    resetButton.addEventListener("blur", disarmReset);
    document.addEventListener("click", (event) => {
      if (event.target !== resetButton) disarmReset();
    });
    app
      .closest("[data-window]")
      ?.addEventListener("desktop:window-close", disarmReset);

    app.addEventListener("click", (event) => {
      const accentButton = event.target.closest("[data-accent]");
      if (accentButton) {
        const prefs = { ...loadPrefs(), accent: accentButton.dataset.accent };
        applyPrefs(prefs);
      }

      if (event.target.matches('[data-music-setting="toggle"]')) {
        const music = loadMusic();
        const next = { ...music, playing: !music.playing };
        localStorage.setItem(musicKey, JSON.stringify(next));
        document.dispatchEvent(
          new CustomEvent("desktop:music-settings", { detail: next }),
        );
        render();
      }

      if (event.target.matches("[data-settings-reset]")) {
        // Destructive, like the palette's Reset Desktop: the first click or
        // tap only asks for confirmation.
        if (!resetButton.classList.contains("confirming")) {
          armReset();
          return;
        }
        // Clear ALL desktop settings and state for a complete fresh start
        const keysToRemove = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          // Remove all pepodev-related keys
          if (key?.startsWith("pepodev.")) {
            keysToRemove.push(key);
          }
        }
        keysToRemove.forEach((key) => localStorage.removeItem(key));

        // Reload the page to show default state
        setTimeout(() => window.location.reload(), 200);
      }
    });

    applyPrefs(loadPrefs());
    render();
    // Preferences also change outside Settings (the palette's Toggle Theme).
    // Changes made here re-render through this event as well.
    document.addEventListener("desktop:preferences", render);
    document.addEventListener("desktop:music-settings", render);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSettings);
  } else {
    initSettings();
  }
</script>
