---
const nodes = [
  { id: "edge", label: "Edge", detail: "CloudFront, WAF, DNS, TLS policy, and traffic steering." },
  { id: "eks", label: "EKS", detail: "Multi-node Kubernetes platform with GitOps delivery and autoscaling." },
  { id: "data", label: "Data", detail: "PostgreSQL, Kafka Strimzi, Elasticsearch, and retention controls." },
  { id: "obs", label: "Observability", detail: "OpenTelemetry, Grafana LGTM, Datadog, SLOs, and alert routing." },
  { id: "sec", label: "Security", detail: "Vault, Teleport, least privilege IAM, and audit trails." },
];
---

<div class="app-content ops-app architecture-app" data-architecture-app>
  <div class="architecture-canvas">
    {nodes.map((node) => (
      <button type="button" data-node={node.id}>{node.label}</button>
    ))}
  </div>
  <aside class="architecture-detail">
    <span class="ops-pill">Selected node</span>
    <h2 data-architecture-title>{nodes[0].label}</h2>
    <p data-architecture-detail>{nodes[0].detail}</p>
  </aside>
</div>

<script define:vars={{ nodes }} is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const app = document.querySelector("[data-architecture-app]");
    if (!app) return;
    const title = app.querySelector("[data-architecture-title]");
    const detail = app.querySelector("[data-architecture-detail]");

    app.addEventListener("click", (event) => {
      const button = event.target.closest("[data-node]");
      if (!button) return;
      const node = nodes.find((item) => item.id === button.dataset.node);
      if (!node) return;
      app.querySelectorAll("[data-node]").forEach((item) => {
        item.classList.toggle("active", item === button);
      });
      title.textContent = node.label;
      detail.textContent = node.detail;
    });

    app.querySelector("[data-node]")?.classList.add("active");
  });
</script>
