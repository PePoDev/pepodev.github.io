---

<div class="app-content welcome-app">
  <div class="terminal-heading">
    <span class="prompt">~/system $</span> login.sh
  </div>

  <div class="welcome-header">
    <pre
      class="ascii-art">
 ██╗    ██╗███████╗██╗      ██████╗ ██████╗ ███╗   ███╗███████╗
 ██║    ██║██╔════╝██║     ██╔════╝██╔═══██╗████╗ ████║██╔════╝
 ██║ █╗ ██║█████╗  ██║     ██║     ██║   ██║██╔████╔██║█████╗  
 ██║███╗██║██╔══╝  ██║     ██║     ██║   ██║██║╚██╔╝██║██╔══╝  
 ╚███╔███╔╝███████╗███████╗╚██████╗╚██████╔╝██║ ╚═╝ ██║███████╗
  ╚══╝╚══╝ ╚══════╝╚══════╝ ╚═════╝ ╚═════╝ ╚═╝     ╚═╝╚══════╝
    </pre>
  </div>

  <div class="welcome-messages">
    <div class="terminal-prompt">
      <span class="prompt">~/explore $</span>
      <span class="cursor-blink">▊</span>
      <p class="welcome-hint">
        Hint: Click on the desktop icons to explore my work, projects, and
        experience!
      </p>
    </div>

    <div class="section-divider"></div>

    <button
      type="button"
      class="quote-box"
      data-quote-box
      aria-describedby="welcome-quote-hint"
    >
      <span class="quote-icon" aria-hidden="true">💭</span>
      <span class="quote-text" aria-live="polite">
        <span class="quote-main" data-quote-text>
          "Any sufficiently advanced technology is indistinguishable from
          magic."
        </span>
        <span class="quote-author" data-quote-author>— Arthur C. Clarke</span>
      </span>
    </button>
    <p id="welcome-quote-hint" class="welcome-quote-hint">
      Click the quote for more wisdom ✨
    </p>
  </div>
</div>

<style>
  .welcome-app {
    font-family: "Courier New", monospace;
  }

  .welcome-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .ascii-art {
    color: var(--app-primary-text, var(--accent-green));
    font-size: 0.45rem;
    line-height: 1;
    margin: 0;
    text-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
  }

  .welcome-messages {
    animation: fadeIn 0.5s ease-in;
  }

  .quote-box {
    display: flex;
    gap: 1rem;
    width: 100%;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border: none;
    border-left: 3px solid var(--accent-green);
    border-radius: 4px;
    margin: 1rem 0;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .quote-box:hover,
  .quote-box:focus-visible {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(4px);
  }

  /* Text colour keeps the ring at 3:1 or more in both themes; the light
     accent green is too pale on light glass. */
  .quote-box:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }

  .quote-icon {
    font-size: 2rem;
  }

  .quote-text {
    flex: 1;
    font-size: 14px;
    line-height: 1.6;
  }

  .quote-main {
    display: block;
    font-style: italic;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
  }

  .quote-author {
    display: block;
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .terminal-prompt {
    margin-top: 1.5rem;
  }

  /* Secondary text, not faded with opacity, keeps the hints at AA. */
  .welcome-hint {
    margin-top: 8px;
    font-size: 0.9em;
  }

  .welcome-quote-hint {
    margin-top: -0.5rem;
    font-size: 0.85em;
    text-align: center;
  }

  .cursor-blink {
    animation: blink 1s step-end infinite;
    color: var(--app-primary-text, var(--accent-green));
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-messages,
    .cursor-blink {
      animation: none;
    }

    .quote-box:hover,
    .quote-box:focus-visible {
      transform: none;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  function initWelcome() {
    const quotes = [
      {
        text: "Any sufficiently advanced technology is indistinguishable from magic.",
        author: "Arthur C. Clarke",
      },
      {
        text: "The best way to predict the future is to invent it.",
        author: "Alan Kay",
      },
      {
        text: "Code is like humor. When you have to explain it, it's bad.",
        author: "Cory House",
      },
      {
        text: "First, solve the problem. Then, write the code.",
        author: "John Johnson",
      },
      {
        text: "Simplicity is the soul of efficiency.",
        author: "Austin Freeman",
      },
      {
        text: "Make it work, make it right, make it fast.",
        author: "Kent Beck",
      },
      {
        text: "The only way to go fast, is to go well.",
        author: "Robert C. Martin",
      },
      {
        text: "Experience is the name everyone gives to their mistakes.",
        author: "Oscar Wilde",
      },
      {
        text: "In theory, theory and practice are the same. In practice, they're not.",
        author: "Yogi Berra",
      },
      {
        text: "Programs must be written for people to read, and only incidentally for machines to execute.",
        author: "Harold Abelson",
      },
      {
        text: "Walking on water and developing software from a specification are easy if both are frozen.",
        author: "Edward V. Berard",
      },
    ];

    const quoteBox = document.querySelector("[data-quote-box]");
    const quoteText = document.querySelector("[data-quote-text]");
    const quoteAuthor = document.querySelector("[data-quote-author]");

    if (!quoteBox || !quoteText || !quoteAuthor) return;

    let currentIndex = 0;

    function getRandomQuote() {
      let newIndex;
      do {
        newIndex = Math.floor(Math.random() * quotes.length);
      } while (newIndex === currentIndex && quotes.length > 1);

      currentIndex = newIndex;
      return quotes[currentIndex];
    }

    function updateQuote() {
      const quote = getRandomQuote();

      // Fade out
      quoteText.style.opacity = "0";
      quoteAuthor.style.opacity = "0";

      setTimeout(() => {
        quoteText.textContent = quote.text;
        quoteAuthor.textContent = `— ${quote.author}`;

        // Fade in
        quoteText.style.opacity = "1";
        quoteAuthor.style.opacity = "1";
      }, 200);
    }

    // Add smooth transition
    quoteText.style.transition = "opacity 0.2s ease";
    quoteAuthor.style.transition = "opacity 0.2s ease";

    quoteBox.addEventListener("click", updateQuote);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWelcome);
  } else {
    initWelcome();
  }
</script>
