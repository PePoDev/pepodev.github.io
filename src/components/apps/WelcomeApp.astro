<div class="app-content welcome-app">
  <div class="terminal-heading">
    <span class="prompt">~/system $</span> login.sh
  </div>

  <div class="welcome-header">
    <pre
      class="ascii-art">
 ██╗    ██╗███████╗██╗      ██████╗ ██████╗ ███╗   ███╗███████╗
 ██║    ██║██╔════╝██║     ██╔════╝██╔═══██╗████╗ ████║██╔════╝
 ██║ █╗ ██║█████╗  ██║     ██║     ██║   ██║██╔████╔██║█████╗  
 ██║███╗██║██╔══╝  ██║     ██║     ██║   ██║██║╚██╔╝██║██╔══╝  
 ╚███╔███╔╝███████╗███████╗╚██████╗╚██████╔╝██║ ╚═╝ ██║███████╗
  ╚══╝╚══╝ ╚══════╝╚══════╝ ╚═════╝ ╚═════╝ ╚═╝     ╚═╝╚══════╝
    </pre>
  </div>

  <div class="welcome-messages">
    <div class="terminal-prompt">
      <span class="prompt">~/explore $</span>
      <span class="cursor-blink">▊</span>
      <p style="margin-top: 8px; font-size: 0.9em; opacity: 0.7;">
        Hint: Click on the desktop icons to explore my work, projects, and
        experience!
      </p>
    </div>

    <div class="section-divider"></div>

    <div class="quote-box" data-quote-box>
      <div class="quote-icon">💭</div>
      <div class="quote-text">
        <p class="quote-main" data-quote-text>
          "Any sufficiently advanced technology is indistinguishable from
          magic."
        </p>
        <p class="quote-author" data-quote-author>— Arthur C. Clarke</p>
      </div>
    </div>
    <p
      style="text-align: center; font-size: 0.85em; opacity: 0.6; margin-top: -0.5rem;"
    >
      Click the quote for more wisdom ✨
    </p>
  </div>
</div>

<style>
  .welcome-app {
    font-family: "Courier New", monospace;
  }

  .welcome-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .ascii-art {
    color: var(--accent-green);
    font-size: 0.45rem;
    line-height: 1;
    margin: 0;
    text-shadow: 0 0 10px rgba(34, 197, 94, 0.5);
  }

  .welcome-messages {
    animation: fadeIn 0.5s ease-in;
  }

  .quote-box {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-left: 3px solid var(--accent-green);
    border-radius: 4px;
    margin: 1rem 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .quote-box:hover {
    background: rgba(255, 255, 255, 0.06);
    transform: translateX(4px);
  }

  .quote-icon {
    font-size: 2rem;
  }

  .quote-text {
    flex: 1;
  }

  .quote-main {
    font-style: italic;
    margin: 0 0 0.5rem 0;
    color: var(--text-primary);
  }

  .quote-author {
    margin: 0;
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .terminal-prompt {
    margin-top: 1.5rem;
  }

  .cursor-blink {
    animation: blink 1s step-end infinite;
    color: var(--accent-green);
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const quotes = [
      {
        text: "Any sufficiently advanced technology is indistinguishable from magic.",
        author: "Arthur C. Clarke",
      },
      {
        text: "The best way to predict the future is to invent it.",
        author: "Alan Kay",
      },
      {
        text: "Code is like humor. When you have to explain it, it's bad.",
        author: "Cory House",
      },
      {
        text: "First, solve the problem. Then, write the code.",
        author: "John Johnson",
      },
      {
        text: "Simplicity is the soul of efficiency.",
        author: "Austin Freeman",
      },
      {
        text: "Make it work, make it right, make it fast.",
        author: "Kent Beck",
      },
      {
        text: "The only way to go fast, is to go well.",
        author: "Robert C. Martin",
      },
      {
        text: "Experience is the name everyone gives to their mistakes.",
        author: "Oscar Wilde",
      },
      {
        text: "In theory, theory and practice are the same. In practice, they're not.",
        author: "Yogi Berra",
      },
      {
        text: "Programs must be written for people to read, and only incidentally for machines to execute.",
        author: "Harold Abelson",
      },
      {
        text: "Walking on water and developing software from a specification are easy if both are frozen.",
        author: "Edward V. Berard",
      },
    ];

    const quoteBox = document.querySelector("[data-quote-box]");
    const quoteText = document.querySelector("[data-quote-text]");
    const quoteAuthor = document.querySelector("[data-quote-author]");

    if (!quoteBox || !quoteText || !quoteAuthor) return;

    let currentIndex = 0;

    function getRandomQuote() {
      let newIndex;
      do {
        newIndex = Math.floor(Math.random() * quotes.length);
      } while (newIndex === currentIndex && quotes.length > 1);

      currentIndex = newIndex;
      return quotes[currentIndex];
    }

    function updateQuote() {
      const quote = getRandomQuote();

      // Fade out
      quoteText.style.opacity = "0";
      quoteAuthor.style.opacity = "0";

      setTimeout(() => {
        quoteText.textContent = quote.text;
        quoteAuthor.textContent = `— ${quote.author}`;

        // Fade in
        quoteText.style.opacity = "1";
        quoteAuthor.style.opacity = "1";
      }, 200);
    }

    // Add smooth transition
    quoteText.style.transition = "opacity 0.2s ease";
    quoteAuthor.style.transition = "opacity 0.2s ease";

    quoteBox.addEventListener("click", updateQuote);
  });
</script>
