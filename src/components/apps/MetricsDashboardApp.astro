---
const panels = [
  { label: "Availability", value: "99.97%", trend: "+0.02%" },
  { label: "p95 latency", value: "184 ms", trend: "-36 ms" },
  { label: "Error rate", value: "0.08%", trend: "-0.04%" },
  { label: "Cloud cost", value: "$42.8k", trend: "-11%" },
];
---

<div class="app-content ops-app metrics-app" data-metrics-app>
  <div class="ops-summary-grid">
    {panels.map((panel) => (
      <div class="ops-stat">
        <span>{panel.label}</span>
        <strong>{panel.value}</strong>
        <small>{panel.trend}</small>
      </div>
    ))}
  </div>
  <div class="metrics-chart" data-metrics-chart aria-label="Simulated service metrics"></div>
  <div class="metrics-log">
    <div><strong>deploy marker</strong><span>checkout-api v2.18 promoted</span></div>
    <div><strong>alert</strong><span>latency budget remains healthy</span></div>
    <div><strong>cost</strong><span>spot coverage 67%, rightsizing queue clear</span></div>
  </div>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const chart = document.querySelector("[data-metrics-chart]");
    if (!chart) return;

    function render() {
      chart.innerHTML = "";
      for (let i = 0; i < 34; i++) {
        const bar = document.createElement("span");
        bar.style.height = 22 + Math.round(Math.random() * 70) + "%";
        chart.appendChild(bar);
      }
    }

    render();
    window.setInterval(render, 2400);
  });
</script>
