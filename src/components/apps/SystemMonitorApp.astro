<div class="app-content ops-app system-monitor-app" data-system-monitor>
  <div class="monitor-grid">
    <div class="monitor-gauge"><span>CPU</span><strong data-monitor="cpu">--%</strong></div>
    <div class="monitor-gauge"><span>Memory</span><strong data-monitor="mem">--%</strong></div>
    <div class="monitor-gauge"><span>Network</span><strong data-monitor="net">-- Mb/s</strong></div>
    <div class="monitor-gauge"><span>Uptime</span><strong data-monitor="uptime">--</strong></div>
  </div>
  <div class="monitor-log" data-monitor-log></div>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const app = document.querySelector("[data-system-monitor]");
    if (!app) return;
    const started = Date.now();
    const log = app.querySelector("[data-monitor-log]");
    const messages = [
      "otel collector exported traces",
      "karpenter consolidated one node",
      "vault token renewal succeeded",
      "argocd application synced",
      "datadog monitor evaluated healthy",
    ];

    function set(name, value) {
      app.querySelector(`[data-monitor="${name}"]`).textContent = value;
    }

    function render() {
      set("cpu", 18 + Math.round(Math.random() * 46) + "%");
      set("mem", 42 + Math.round(Math.random() * 28) + "%");
      set("net", (8 + Math.random() * 80).toFixed(1) + " Mb/s");
      set("uptime", Math.floor((Date.now() - started) / 1000) + "s");
      const line = document.createElement("div");
      line.textContent = new Date().toLocaleTimeString() + " " + messages[Math.floor(Math.random() * messages.length)];
      log.prepend(line);
      while (log.children.length > 7) log.lastElementChild.remove();
    }

    render();
    window.setInterval(render, 2200);
  });
</script>
