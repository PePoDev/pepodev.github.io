---
import { getMusicTracks } from "../../data/music";

const tracks = getMusicTracks();
const defaultTrack = tracks[0];
---

<div class="app-content music-player-app" data-music-player>
  <div class="music-now">
    {
      defaultTrack?.mediaType === "video" ? (
        <video
          class="music-art"
          id="music-art"
          src={defaultTrack.src}
          muted
          playsinline
          preload="metadata"
          aria-hidden="true"
        />
      ) : defaultTrack ? (
        <img
          class="music-art"
          id="music-art"
          src=""
          alt=""
          loading="lazy"
        />
      ) : (
        <div class="music-art music-art-empty" id="music-art" aria-hidden="true" />
      )
    }
    <div>
      <div class="music-eyebrow">Now Playing</div>
      <h2 id="music-title">{defaultTrack?.title ?? "No Music Found"}</h2>
      <p id="music-detail">
        {defaultTrack?.detail ?? "Add audio files to public/music"}
      </p>
    </div>
  </div>

  <div class="music-transport">
    <button type="button" data-music-prev aria-label="Previous track">&lt;&lt;</button>
    <button type="button" class="music-play" data-music-toggle>Play</button>
    <button type="button" data-music-next aria-label="Next track">&gt;&gt;</button>
  </div>

  <div class="music-meter" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <label class="settings-field">
    <span>Track</span>
    <select data-music-track>
      {tracks.map((track) => <option value={track.id}>{track.title}</option>)}
    </select>
  </label>

  <label class="settings-field">
    <span>Music volume</span>
    <input data-music-volume type="range" min="0" max="100" value="60" />
  </label>

  <p class="music-status" data-music-status aria-live="polite"></p>

  {
    defaultTrack?.mediaType === "video" ? (
      <video
        class="music-media"
        data-music-media
        playsinline
        preload="metadata"
        src={defaultTrack.src}
      />
    ) : (
      defaultTrack && (
        <audio
          class="music-media"
          data-music-media
          preload="metadata"
          src={defaultTrack.src}
        />
      )
    )
  }
</div>

<script define:vars={{ tracks }} is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const musicKey = "pepodev.music";
    const player = document.querySelector("[data-music-player]");
    if (!player || window.__pepoMusicController) return;

    const defaultTrackId = tracks[0]?.id || "";
    let settings = loadMusicSettings();

    const title = document.getElementById("music-title");
    const detail = document.getElementById("music-detail");
    const art = document.getElementById("music-art");
    const toggle = player.querySelector("[data-music-toggle]");
    const trackSelect = player.querySelector("[data-music-track]");
    const volume = player.querySelector("[data-music-volume]");
    const media = player.querySelector("[data-music-media]");
    const status = player.querySelector("[data-music-status]");

    function loadMusicSettings() {
      try {
        const raw = localStorage.getItem(musicKey);
        if (raw)
          return { track: defaultTrackId, volume: 0.6, playing: false, ...JSON.parse(raw) };
      } catch {
        // Ignore corrupt persisted settings.
      }
      return { track: defaultTrackId, volume: 0.6, playing: false };
    }

    function saveMusicSettings(next) {
      settings = { ...settings, ...next };
      localStorage.setItem(musicKey, JSON.stringify(settings));
      document.dispatchEvent(
        new CustomEvent("desktop:music-settings", { detail: settings }),
      );
      render();
    }

    function currentTrack() {
      return tracks.find((track) => track.id === settings.track) || tracks[0];
    }

    function applyVolume() {
      if (!media) return;
      media.volume = Math.max(0, Math.min(1, settings.volume));
      media.muted = false;
    }

    function syncAudioSource() {
      const track = currentTrack();
      if (!track || !media) return;
      const wasPaused = media.paused;
      if (!media.src.endsWith(track.src)) {
        media.src = track.src;
        media.load();
      }
      if (settings.playing && !wasPaused) void startPlayback();
    }

    async function startPlayback() {
      if (!media) return false;
      applyVolume();
      try {
        await media.play();
        saveMusicSettings({ playing: true });
        return true;
      } catch (error) {
        saveMusicSettings({ playing: false });
        if (status) {
          status.textContent =
            error instanceof Error && error.name === "NotAllowedError"
              ? "Playback was blocked by the browser."
              : "This browser could not play the selected file.";
        }
        return false;
      }
    }

    async function setPlaying(playing) {
      if (!media) return;
      if (playing) {
        await startPlayback();
      } else {
        media.pause();
        saveMusicSettings({ playing: false });
      }
    }

    function setTrack(trackId) {
      saveMusicSettings({ track: trackId });
      syncAudioSource();
      if (settings.playing) void startPlayback();
    }

    function render() {
      const track = currentTrack();
      if (!track) return;
      title.textContent = track.title;
      detail.textContent = track.detail;
      if (art?.tagName === "VIDEO" && track.mediaType === "video") {
        if (!art.src.endsWith(track.src)) {
          art.src = track.src;
          art.load();
        }
      } else if (art?.tagName === "IMG") {
        art.removeAttribute("src");
      }
      trackSelect.value = track.id;
      volume.value = String(Math.round(settings.volume * 100));
      toggle.textContent = settings.playing ? "Pause" : "Play";
      player.classList.toggle("music-playing", settings.playing);
      if (status) {
        status.textContent = settings.playing
          ? settings.volume === 0
            ? "Playing silently. Raise Music volume to hear it."
            : "Playing from public/music."
          : "";
      }
      applyVolume();
    }

    toggle.addEventListener("click", () => setPlaying(!settings.playing));
    player.querySelector("[data-music-prev]").addEventListener("click", () => {
      const index = tracks.findIndex((track) => track.id === settings.track);
      if (!tracks.length) return;
      setTrack(tracks[((index < 0 ? 0 : index) - 1 + tracks.length) % tracks.length].id);
    });
    player.querySelector("[data-music-next]").addEventListener("click", () => {
      const index = tracks.findIndex((track) => track.id === settings.track);
      if (!tracks.length) return;
      setTrack(tracks[((index < 0 ? 0 : index) + 1) % tracks.length].id);
    });
    trackSelect.addEventListener("change", () => setTrack(trackSelect.value));
    volume.addEventListener("input", () => {
      saveMusicSettings({ volume: Number(volume.value) / 100 });
      applyVolume();
    });

    document.addEventListener("desktop:music-settings", (event) => {
      const wasPlaying = settings.playing;
      const oldTrack = settings.track;
      settings = { ...settings, ...event.detail };
      if (!currentTrack()) settings.track = defaultTrackId;
      render();
      if (event.detail.track && oldTrack !== settings.track) syncAudioSource();
      if (!media) return;
      if (settings.playing && (!wasPlaying || event.detail.track)) {
        void startPlayback();
      }
      if (!settings.playing) media.pause();
    });

    media?.addEventListener("ended", () => {
      if (!tracks.length) return;
      const index = tracks.findIndex((track) => track.id === settings.track);
      setTrack(tracks[((index < 0 ? 0 : index) + 1) % tracks.length].id);
    });

    media?.addEventListener("error", () => {
      const code = media.error?.code;
      if (status) {
        status.textContent = code
          ? `This browser could not play the selected file. Media error ${code}.`
          : "This browser could not play the selected file.";
      }
      saveMusicSettings({ playing: false });
    });

    window.__pepoMusicController = { setPlaying, setTrack };
    syncAudioSource();
    render();
  });
</script>
