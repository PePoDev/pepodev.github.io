---
const tracks = [
  {
    id: "datacenter",
    title: "Datacenter Pulse",
    detail: "Warm synth arpeggio",
    bpm: 92,
    notes: [196, 247, 294, 370, 330, 294, 247, 220],
  },
  {
    id: "nightshift",
    title: "Night Shift",
    detail: "Slow ambient pads",
    bpm: 72,
    notes: [146.83, 196, 220, 293.66, 261.63, 220, 196, 164.81],
  },
  {
    id: "incident",
    title: "Incident Response",
    detail: "Tense low pulse",
    bpm: 118,
    notes: [110, 146.83, 164.81, 196, 185, 164.81, 146.83, 123.47],
  },
];
---

<div class="app-content music-player-app" data-music-player>
  <div class="music-now">
    <div class="music-art" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div>
      <div class="music-eyebrow">Now Playing</div>
      <h2 id="music-title">Datacenter Pulse</h2>
      <p id="music-detail">Warm synth arpeggio</p>
    </div>
  </div>

  <div class="music-transport">
    <button type="button" data-music-prev aria-label="Previous track">&lt;&lt;</button>
    <button type="button" class="music-play" data-music-toggle>Play</button>
    <button type="button" data-music-next aria-label="Next track">&gt;&gt;</button>
  </div>

  <div class="music-meter" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
  </div>

  <label class="settings-field">
    <span>Track</span>
    <select data-music-track>
      {tracks.map((track) => <option value={track.id}>{track.title}</option>)}
    </select>
  </label>

  <label class="settings-field">
    <span>Music volume</span>
    <input data-music-volume type="range" min="0" max="100" value="60" />
  </label>
</div>

<script define:vars={{ tracks }} is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const musicKey = "pepodev.music";
    const systemAudioKey = "pepodev.systemAudio";
    const player = document.querySelector("[data-music-player]");
    if (!player || window.__pepoMusicController) return;

    let audioContext = null;
    let masterGain = null;
    let delay = null;
    let timer = null;
    let step = 0;
    let settings = loadMusicSettings();
    let systemAudio = loadSystemAudio();

    const title = document.getElementById("music-title");
    const detail = document.getElementById("music-detail");
    const toggle = player.querySelector("[data-music-toggle]");
    const trackSelect = player.querySelector("[data-music-track]");
    const volume = player.querySelector("[data-music-volume]");

    function loadMusicSettings() {
      try {
        const raw = localStorage.getItem(musicKey);
        if (raw)
          return { track: "datacenter", volume: 0.6, playing: false, ...JSON.parse(raw) };
      } catch {
        // Ignore corrupt persisted settings.
      }
      return { track: "datacenter", volume: 0.6, playing: false };
    }

    function loadSystemAudio() {
      try {
        const raw = localStorage.getItem(systemAudioKey);
        if (raw) return { volume: 1, muted: false, ...JSON.parse(raw) };
      } catch {
        // Ignore corrupt persisted settings.
      }
      return { volume: 1, muted: false };
    }

    function saveMusicSettings(next) {
      settings = { ...settings, ...next };
      localStorage.setItem(musicKey, JSON.stringify(settings));
      document.dispatchEvent(
        new CustomEvent("desktop:music-settings", { detail: settings }),
      );
      render();
    }

    function currentTrack() {
      return tracks.find((track) => track.id === settings.track) || tracks[0];
    }

    function ensureAudio() {
      if (audioContext) return true;
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) return false;

      audioContext = new AudioContextClass();
      masterGain = audioContext.createGain();
      delay = audioContext.createDelay();
      const feedback = audioContext.createGain();
      delay.delayTime.value = 0.22;
      feedback.gain.value = 0.18;
      delay.connect(feedback);
      feedback.connect(delay);
      delay.connect(masterGain);
      masterGain.connect(audioContext.destination);
      applyVolume();
      return true;
    }

    function applyVolume() {
      if (!masterGain || !audioContext) return;
      const gain = settings.playing && !systemAudio.muted
        ? settings.volume * systemAudio.volume
        : 0;
      masterGain.gain.setTargetAtTime(gain, audioContext.currentTime, 0.03);
    }

    function playNote(frequency, duration) {
      if (!audioContext || !masterGain) return;
      const now = audioContext.currentTime;
      const osc = audioContext.createOscillator();
      const gain = audioContext.createGain();
      osc.type = "triangle";
      osc.frequency.setValueAtTime(frequency, now);
      osc.frequency.exponentialRampToValueAtTime(frequency * 1.005, now + duration);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.16, now + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + duration);
      osc.connect(gain);
      gain.connect(masterGain);
      gain.connect(delay);
      osc.start(now);
      osc.stop(now + duration + 0.02);
    }

    function scheduleLoop() {
      stopLoop();
      if (!settings.playing || !ensureAudio()) return;
      const track = currentTrack();
      const beatMs = 60000 / track.bpm;
      timer = window.setInterval(() => {
        const note = track.notes[step % track.notes.length];
        playNote(note, Math.min(0.38, beatMs / 1000));
        step += 1;
      }, beatMs);
      playNote(track.notes[step % track.notes.length], 0.35);
      step += 1;
    }

    function stopLoop() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    async function setPlaying(playing) {
      if (playing && ensureAudio() && audioContext.state === "suspended") {
        await audioContext.resume();
      }
      saveMusicSettings({ playing });
      applyVolume();
      if (playing) scheduleLoop();
      else stopLoop();
    }

    function setTrack(trackId) {
      saveMusicSettings({ track: trackId });
      step = 0;
      if (settings.playing) scheduleLoop();
    }

    function render() {
      const track = currentTrack();
      title.textContent = track.title;
      detail.textContent = track.detail;
      trackSelect.value = track.id;
      volume.value = String(Math.round(settings.volume * 100));
      toggle.textContent = settings.playing ? "Pause" : "Play";
      player.classList.toggle("music-playing", settings.playing);
      applyVolume();
    }

    toggle.addEventListener("click", () => setPlaying(!settings.playing));
    player.querySelector("[data-music-prev]").addEventListener("click", () => {
      const index = tracks.findIndex((track) => track.id === settings.track);
      setTrack(tracks[(index - 1 + tracks.length) % tracks.length].id);
    });
    player.querySelector("[data-music-next]").addEventListener("click", () => {
      const index = tracks.findIndex((track) => track.id === settings.track);
      setTrack(tracks[(index + 1) % tracks.length].id);
    });
    trackSelect.addEventListener("change", () => setTrack(trackSelect.value));
    volume.addEventListener("input", () => {
      saveMusicSettings({ volume: Number(volume.value) / 100 });
      applyVolume();
    });

    document.addEventListener("desktop:audio-settings", (event) => {
      systemAudio = { ...systemAudio, ...event.detail };
      applyVolume();
    });

    document.addEventListener("desktop:music-settings", (event) => {
      const wasPlaying = settings.playing;
      settings = { ...settings, ...event.detail };
      render();
      if (settings.playing && (!wasPlaying || event.detail.track)) scheduleLoop();
      if (!settings.playing) stopLoop();
    });

    window.__pepoMusicController = { setPlaying, setTrack };
    render();
  });
</script>
