---
import { getMusicTracks } from "@data/music";

const tracks = getMusicTracks();
const defaultTrack = tracks[0];
---

<div class="app-content music-player-app" data-music-player>
  <div class="music-now">
    {
      defaultTrack?.mediaType === "video" ? (
        <video
          class="music-art"
          id="music-art"
          data-music-media
          playsinline
          preload="none"
          aria-hidden="true"
        />
      ) : defaultTrack ? (
        <img
          class="music-art"
          id="music-art"
          src=""
          alt="Album artwork for currently playing track"
          loading="lazy"
        />
      ) : (
        <div
          class="music-art music-art-empty"
          id="music-art"
          aria-hidden="true"
        />
      )
    }
    <div>
      <label class="music-title-picker">
        <select id="music-title" data-music-track aria-label="Track">
          {
            tracks.map((track) => (
              <option value={track.id}>{track.title}</option>
            ))
          }
        </select>
      </label>
      <div class="music-eyebrow">Now Playing</div>
      <p id="music-detail">
        {defaultTrack?.detail ?? "Add audio files to public/music"}
      </p>
    </div>
  </div>

  <div class="music-playback-header">
    <div class="music-time-row" aria-label="Playback time">
      <span data-music-elapsed>0:00</span>
      <input
        data-music-seek
        type="range"
        min="0"
        max="1000"
        value="0"
        aria-label="Seek track"
        disabled
      />
      <span data-music-remaining>-0:00</span>
    </div>
  </div>

  <div class="music-transport">
    <button type="button" data-music-prev aria-label="Previous track"
      >&lt;&lt;</button
    >
    <button type="button" class="music-play" data-music-toggle>Play</button>
    <button type="button" data-music-next aria-label="Next track"
      >&gt;&gt;</button
    >
  </div>

  <div class="music-visualizer" aria-hidden="true">
    <canvas data-music-visualizer width="720" height="160"></canvas>
    <div class="music-visualizer-glow"></div>
  </div>

  <p class="music-status" data-music-status aria-live="polite"></p>

  {
    defaultTrack?.mediaType === "audio" && (
      <audio class="music-media" data-music-media preload="none" />
    )
  }
</div>

<script define:vars={{ tracks }} is:inline>
  // @ts-nocheck
  function initMusicPlayer() {
    const musicKey = "pepodev.music";
    const audioSettingsKey = "pepodev.systemAudio";
    const player = document.querySelector("[data-music-player]");
    if (!player || window.__pepoMusicController) return;

    const defaultTrackId = tracks[0]?.id || "";
    const persistedSettings = loadMusicSettings();
    let settings = normalizeMusicSettings({
      ...persistedSettings,
      playing: false,
    });
    let audioSettings = loadAudioSettings();

    const title = document.getElementById("music-title");
    const detail = document.getElementById("music-detail");
    const art = document.getElementById("music-art");
    const toggle = player.querySelector("[data-music-toggle]");
    const trackSelect = player.querySelector("[data-music-track]");
    const media = player.querySelector("[data-music-media]");
    const status = player.querySelector("[data-music-status]");
    const elapsedTime = player.querySelector("[data-music-elapsed]");
    const remainingTime = player.querySelector("[data-music-remaining]");
    const seek = player.querySelector("[data-music-seek]");
    const visualizer = player.querySelector("[data-music-visualizer]");
    const visualizerContext = visualizer?.getContext("2d");
    const musicWindow = player.closest("[data-window]");
    const reducedMotion = window.matchMedia?.(
      "(prefers-reduced-motion: reduce)",
    );
    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
    let playbackRequestId = 0;
    let audioContext = null;
    let analyser = null;
    let outputGain = null;
    let mediaSource = null;
    let frequencyData = null;
    let waveformData = null;
    let visualizerFrame = 0;
    let visualizerPhase = 0;
    let audioFramePlaying = false;

    function loadMusicSettings() {
      try {
        const raw = localStorage.getItem(musicKey);
        if (raw)
          return { track: defaultTrackId, playing: false, ...JSON.parse(raw) };
      } catch {
        // Ignore corrupt persisted settings.
      }
      return { track: defaultTrackId, playing: false };
    }

    function loadAudioSettings() {
      try {
        const raw = localStorage.getItem(audioSettingsKey);
        if (raw) return { volume: 1, muted: false, ...JSON.parse(raw) };
      } catch {
        // Ignore corrupt persisted settings.
      }
      return { volume: 1, muted: false };
    }

    function normalizeMusicSettings(next) {
      const track = tracks.some((item) => item.id === next.track)
        ? next.track
        : defaultTrackId;
      return { track, playing: Boolean(next.playing) };
    }

    function saveMusicSettings(next) {
      settings = normalizeMusicSettings({ ...settings, ...next });
      localStorage.setItem(musicKey, JSON.stringify(settings));
      document.dispatchEvent(
        new CustomEvent("desktop:music-settings", { detail: settings }),
      );
      render();
    }

    function currentTrack() {
      return tracks.find((track) => track.id === settings.track) || tracks[0];
    }

    function isMediaPlaying() {
      return Boolean(media && !media.paused && !media.ended);
    }

    function isDesktopMode() {
      return document.documentElement.dataset.siteMode !== "website";
    }

    function isWindowOpen() {
      return (
        !musicWindow ||
        (!musicWindow.hidden &&
          musicWindow.getAttribute("aria-hidden") === "false")
      );
    }

    function isPlayerVisible() {
      return (
        isWindowOpen() &&
        !musicWindow?.classList.contains("minimized") &&
        !musicWindow?.classList.contains("closing") &&
        isDesktopMode() &&
        !document.hidden
      );
    }

    // A page load fetches no media: the track loads when the window opens or
    // playback starts. For video tracks the artwork element is the player.
    function loadTrackSource() {
      const track = currentTrack();
      if (!track || !media || media.getAttribute("src") === track.src) return;
      playbackRequestId += 1;
      media.preload = "metadata";
      media.src = track.src;
      media.load();
    }

    function formatTime(seconds) {
      if (!Number.isFinite(seconds) || seconds < 0) return "0:00";
      const wholeSeconds = Math.floor(seconds);
      const minutes = Math.floor(wholeSeconds / 60);
      const remainder = String(wholeSeconds % 60).padStart(2, "0");
      return `${minutes}:${remainder}`;
    }

    function updateRangeFill(input) {
      if (!input) return;
      const min = Number(input.min || 0);
      const max = Number(input.max || 100);
      const value = Number(input.value || min);
      const progress =
        max > min ? ((value - min) / (max - min)) * 100 : 0;
      input.style.setProperty(
        "--range-progress",
        Math.max(0, Math.min(100, progress)) + "%",
      );
    }

    function updatePlaybackTime() {
      if (!elapsedTime || !remainingTime) return;
      const currentTime = media?.currentTime || 0;
      const duration = media?.duration || 0;
      elapsedTime.textContent = formatTime(currentTime);
      remainingTime.textContent =
        Number.isFinite(duration) && duration > 0
          ? `-${formatTime(Math.max(0, duration - currentTime))}`
          : "-0:00";
      if (seek) {
        const canSeek = Number.isFinite(duration) && duration > 0;
        seek.disabled = !canSeek;
        seek.value = canSeek
          ? String(Math.round((currentTime / duration) * Number(seek.max)))
          : "0";
        updateRangeFill(seek);
      }
    }

    // A media element routed into a suspended AudioContext plays silently,
    // and some browsers never resume it (Firefox without an audio device).
    // So the media plays on its own and joins the analyser once it runs.
    function connectAnalyzer() {
      if (!media || analyser || audioContext?.state !== "running") {
        return Boolean(analyser);
      }
      try {
        analyser = audioContext.createAnalyser();
        outputGain = audioContext.createGain();
        analyser.fftSize = 256;
        analyser.smoothingTimeConstant = 0.72;
        frequencyData = new Uint8Array(analyser.frequencyBinCount);
        waveformData = new Uint8Array(analyser.fftSize);
        mediaSource = audioContext.createMediaElementSource(media);
        mediaSource.connect(analyser);
        analyser.connect(outputGain);
        outputGain.connect(audioContext.destination);
        applyVolume();
      } catch {
        analyser = null;
        outputGain = null;
        frequencyData = null;
        waveformData = null;
      }
      return Boolean(analyser);
    }

    function resumeAudioContext() {
      if (!media || !AudioContextClass) return;
      if (!audioContext) {
        try {
          audioContext = new AudioContextClass();
          audioContext.addEventListener("statechange", () => {
            connectAnalyzer();
            syncVisualizer();
          });
        } catch {
          audioContext = null;
          return;
        }
      }
      if (audioContext.state !== "running") {
        // Not awaited: playback must not wait for a resume that may never
        // settle. The visualizer falls back to its idle pattern meanwhile.
        Promise.resolve()
          .then(() => audioContext.resume())
          .catch(() => {});
      }
      connectAnalyzer();
    }

    function sampleAudio() {
      if (
        analyser &&
        frequencyData &&
        waveformData &&
        audioContext?.state === "running"
      ) {
        analyser.getByteFrequencyData(frequencyData);
        analyser.getByteTimeDomainData(waveformData);
      }
    }

    // Sends levels to the music-reactive desktop background. A stop is sent
    // once.
    function publishAudioFrame(playing) {
      if (playing && frequencyData && audioContext?.state === "running") {
        let low = 0;
        let mid = 0;
        let high = 0;
        const lowLimit = Math.max(1, Math.floor(frequencyData.length * 0.18));
        const midLimit = Math.max(
          lowLimit + 1,
          Math.floor(frequencyData.length * 0.52),
        );

        frequencyData.forEach((value, index) => {
          if (index < lowLimit) low += value;
          else if (index < midLimit) mid += value;
          else high += value;
        });

        const lowLevel = low / (lowLimit * 255);
        const midLevel = mid / ((midLimit - lowLimit) * 255);
        const highLevel = high / ((frequencyData.length - midLimit) * 255);
        audioFramePlaying = true;
        document.dispatchEvent(
          new CustomEvent("desktop:music-audio-frame", {
            detail: {
              playing: true,
              low: lowLevel,
              mid: midLevel,
              high: highLevel,
              energy: Math.min(
                1,
                lowLevel * 0.46 + midLevel * 0.34 + highLevel * 0.2,
              ),
            },
          }),
        );
      } else if (!playing && audioFramePlaying) {
        audioFramePlaying = false;
        document.dispatchEvent(
          new CustomEvent("desktop:music-audio-frame", {
            detail: { playing: false, low: 0, mid: 0, high: 0, energy: 0 },
          }),
        );
      }
    }

    function drawVisualizer(playing) {
      if (!visualizer || !visualizerContext) return;

      const width = visualizer.width;
      const height = visualizer.height;
      const center = height * 0.58;
      const barCount = 40;
      const gap = 4;
      const barWidth = (width - gap * (barCount - 1)) / barCount;
      const gradient = visualizerContext.createLinearGradient(0, 18, 0, height);

      visualizerContext.clearRect(0, 0, width, height);

      const background = visualizerContext.createLinearGradient(
        0,
        0,
        width,
        height,
      );
      background.addColorStop(0, "rgba(6, 13, 24, 0.58)");
      background.addColorStop(1, "rgba(18, 32, 48, 0.32)");
      visualizerContext.fillStyle = background;
      visualizerContext.fillRect(0, 0, width, height);

      visualizerContext.globalAlpha = 0.28;
      visualizerContext.strokeStyle = "rgba(125, 240, 255, 0.25)";
      visualizerContext.lineWidth = 1;
      for (let y = 24; y < height; y += 28) {
        visualizerContext.beginPath();
        visualizerContext.moveTo(0, y);
        visualizerContext.lineTo(width, y);
        visualizerContext.stroke();
      }
      visualizerContext.globalAlpha = 1;

      gradient.addColorStop(0, "rgba(247, 211, 96, 0.95)");
      gradient.addColorStop(0.42, "rgba(79, 224, 200, 0.92)");
      gradient.addColorStop(1, "rgba(119, 152, 255, 0.48)");
      visualizerContext.fillStyle = gradient;
      visualizerContext.shadowBlur = 18;
      visualizerContext.shadowColor = "rgba(79, 224, 200, 0.45)";

      for (let index = 0; index < barCount; index += 1) {
        const sourceIndex = frequencyData
          ? Math.min(
              frequencyData.length - 1,
              Math.floor((index / barCount) * frequencyData.length),
            )
          : index;
        const frequencyLevel = frequencyData?.[sourceIndex] ?? 0;
        const idleLevel =
          28 +
          Math.sin(visualizerPhase + index * 0.55) * 12 +
          Math.cos(visualizerPhase * 0.65 + index * 0.28) * 8;
        const hasAudioData =
          playing && analyser && audioContext?.state === "running";
        const normalizedLevel = hasAudioData
          ? frequencyLevel / 255
          : idleLevel / 100;
        const pulse = playing
          ? Math.max(0.12, normalizedLevel)
          : Math.max(0.08, normalizedLevel * 0.52);
        const barHeight = Math.max(8, pulse * (height - 34));
        const x = index * (barWidth + gap);
        const y = center - barHeight / 2;
        const radius = Math.min(8, barWidth / 2);

        visualizerContext.beginPath();
        visualizerContext.roundRect(x, y, barWidth, barHeight, radius);
        visualizerContext.fill();
      }

      visualizerContext.shadowBlur = 0;
      visualizerContext.globalAlpha = playing ? 0.92 : 0.42;
      visualizerContext.strokeStyle = "rgba(247, 211, 96, 0.72)";
      visualizerContext.lineWidth = 2;
      visualizerContext.beginPath();
      for (let x = 0; x <= width; x += 12) {
        const waveformIndex = waveformData
          ? Math.min(
              waveformData.length - 1,
              Math.floor((x / width) * waveformData.length),
            )
          : 0;
        const frequencyIndex = frequencyData
          ? Math.min(
              frequencyData.length - 1,
              Math.floor((x / width) * frequencyData.length),
            )
          : 0;
        const waveform = waveformData
          ? (waveformData[waveformIndex] - 128) / 128
          : Math.sin(visualizerPhase * 1.6 + x * 0.028) * 0.35;
        const energy = frequencyData?.[frequencyIndex]
          ? frequencyData[frequencyIndex] / 255
          : 0.22;
        const y = center + waveform * (8 + energy * 24) * (playing ? 1 : 0.42);
        if (x === 0) visualizerContext.moveTo(x, y);
        else visualizerContext.lineTo(x, y);
      }
      visualizerContext.stroke();
      visualizerContext.globalAlpha = 1;
    }

    // Animate only while music plays in the visible window. Reduced motion
    // keeps the visualizer static.
    function shouldAnimateVisualizer() {
      return isMediaPlaying() && isPlayerVisible() && !reducedMotion?.matches;
    }

    function tickVisualizer() {
      visualizerFrame = 0;
      if (!shouldAnimateVisualizer()) {
        syncVisualizer();
        return;
      }
      sampleAudio();
      visualizerPhase += 0.055;
      drawVisualizer(true);
      visualizerFrame = requestAnimationFrame(tickVisualizer);
    }

    // The desktop background asks for levels on each of its own frames, so
    // the music reaches it with the player minimized or closed and without a
    // second animation loop. Reduced motion sends no levels.
    function requestAudioFrame() {
      const playing = isMediaPlaying() && !reducedMotion?.matches;
      if (playing) sampleAudio();
      publishAudioFrame(playing);
    }

    function syncVisualizer() {
      if (shouldAnimateVisualizer()) {
        if (!visualizerFrame) {
          visualizerFrame = requestAnimationFrame(tickVisualizer);
        }
        return;
      }
      if (visualizerFrame) {
        cancelAnimationFrame(visualizerFrame);
        visualizerFrame = 0;
      }
      if (isPlayerVisible()) drawVisualizer(false);
    }

    function applyVolume() {
      if (!media) return;
      const volume = Number.isFinite(audioSettings.volume)
        ? Math.max(0, Math.min(1, audioSettings.volume))
        : 1;
      const outputVolume = audioSettings.muted ? 0 : volume;
      if (outputGain && audioContext) {
        outputGain.gain.setTargetAtTime(
          outputVolume,
          audioContext.currentTime,
          0.015,
        );
        media.volume = 1;
        media.muted = false;
        return;
      }
      media.volume = volume;
      media.muted = Boolean(audioSettings.muted);
    }

    function syncAudioSource() {
      const track = currentTrack();
      if (!track || !media) return;
      const wasPaused = media.paused;
      // A closed, idle player loads the new track when it is next needed.
      if (isWindowOpen() || !wasPaused) loadTrackSource();
      if (settings.playing && !wasPaused) void startPlayback();
    }

    async function startPlayback() {
      if (!media || !currentTrack()) {
        playbackRequestId += 1;
        saveMusicSettings({ playing: false });
        if (status) status.textContent = "Add playable files to public/music.";
        return false;
      }
      loadTrackSource();
      const requestId = playbackRequestId + 1;
      playbackRequestId = requestId;
      resumeAudioContext();
      applyVolume();
      try {
        await media.play();
        if (requestId !== playbackRequestId || !isMediaPlaying()) return false;
        saveMusicSettings({ playing: true });
        return true;
      } catch (error) {
        if (requestId !== playbackRequestId) return false;
        saveMusicSettings({ playing: false });
        if (status) {
          status.textContent =
            error instanceof Error && error.name === "NotAllowedError"
              ? "Playback was blocked by the browser."
              : "This browser could not play the selected file.";
        }
        return false;
      }
    }

    async function setPlaying(playing) {
      if (!media) return;
      if (playing) {
        await startPlayback();
      } else {
        playbackRequestId += 1;
        media.pause();
        saveMusicSettings({ playing: false });
      }
    }

    function setTrack(trackId) {
      saveMusicSettings({ track: trackId });
      syncAudioSource();
      if (settings.playing) void startPlayback();
    }

    function render() {
      const track = currentTrack();
      const isActuallyPlaying = isMediaPlaying();
      if (!track) {
        if (title) title.innerHTML = '<option value="">No Music Found</option>';
        detail.textContent = "Add audio files to public/music";
        trackSelect.disabled = true;
        toggle.disabled = true;
        player.classList.remove("music-playing");
        updatePlaybackTime();
        if (status) status.textContent = "Add playable files to public/music.";
        return;
      }
      detail.textContent = track.detail;
      if (art?.tagName === "IMG") art.removeAttribute("src");
      trackSelect.value = track.id;
      trackSelect.disabled = false;
      toggle.disabled = false;
      toggle.textContent = isActuallyPlaying ? "Pause" : "Play";
      player.classList.toggle("music-playing", isActuallyPlaying);
      if (status) {
        status.textContent =
          isActuallyPlaying &&
          (audioSettings.muted || audioSettings.volume === 0)
            ? "Playing silently. Raise system volume to hear it."
            : "";
      }
      applyVolume();
      updatePlaybackTime();
    }

    toggle.addEventListener("click", () => setPlaying(!isMediaPlaying()));
    player.querySelector("[data-music-prev]").addEventListener("click", () => {
      const index = tracks.findIndex((track) => track.id === settings.track);
      if (!tracks.length) return;
      setTrack(
        tracks[((index < 0 ? 0 : index) - 1 + tracks.length) % tracks.length]
          .id,
      );
    });
    player.querySelector("[data-music-next]").addEventListener("click", () => {
      const index = tracks.findIndex((track) => track.id === settings.track);
      if (!tracks.length) return;
      setTrack(tracks[((index < 0 ? 0 : index) + 1) % tracks.length].id);
    });
    trackSelect.addEventListener("change", () => setTrack(trackSelect.value));
    seek?.addEventListener("input", () => {
      if (!media || !Number.isFinite(media.duration) || media.duration <= 0)
        return;
      media.currentTime =
        (Number(seek.value) / Number(seek.max)) * media.duration;
      updatePlaybackTime();
    });

    // React to changes only: this player's own saves arrive here too, and
    // restarting on them looped startPlayback while music played.
    document.addEventListener("desktop:music-settings", (event) => {
      const wasPlaying = settings.playing;
      const oldTrack = settings.track;
      settings = normalizeMusicSettings({ ...settings, ...event.detail });
      const trackChanged = oldTrack !== settings.track;
      render();
      if (trackChanged) syncAudioSource();
      if (!media) return;
      if (settings.playing && (!wasPlaying || trackChanged)) {
        void startPlayback();
      }
      if (!settings.playing) media.pause();
    });

    document.addEventListener("desktop:audio-settings", (event) => {
      audioSettings = { ...loadAudioSettings(), ...(event.detail || {}) };
      applyVolume();
      render();
    });

    media?.addEventListener("ended", () => {
      if (!tracks.length) return;
      const index = tracks.findIndex((track) => track.id === settings.track);
      setTrack(tracks[((index < 0 ? 0 : index) + 1) % tracks.length].id);
    });

    media?.addEventListener("play", () => {
      render();
      syncVisualizer();
    });
    media?.addEventListener("pause", () => {
      render();
      syncVisualizer();
    });
    media?.addEventListener("timeupdate", updatePlaybackTime);
    media?.addEventListener("loadedmetadata", updatePlaybackTime);
    media?.addEventListener("durationchange", updatePlaybackTime);
    media?.addEventListener("seeked", updatePlaybackTime);

    media?.addEventListener("error", () => {
      const code = media.error?.code;
      if (status) {
        status.textContent = code
          ? `This browser could not play the selected file. Media error ${code}.`
          : "This browser could not play the selected file.";
      }
      saveMusicSettings({ playing: false });
    });

    // Music stops with its window and in website mode, which has no audio
    // controls.
    function stopForHiddenPlayer() {
      if (media && (!media.paused || settings.playing)) void setPlaying(false);
    }

    musicWindow?.addEventListener("desktop:window-open", () => {
      loadTrackSource();
      render();
    });
    // Rocket Loader can run this after the window opened, past its
    // desktop:window-open.
    if (musicWindow?.getAttribute("aria-hidden") === "false") {
      loadTrackSource();
    }
    musicWindow?.addEventListener("desktop:window-close", stopForHiddenPlayer);
    document.addEventListener("site:mode-change", (event) => {
      if (event.detail?.mode === "website") stopForHiddenPlayer();
      syncVisualizer();
    });
    document.addEventListener("visibilitychange", syncVisualizer);
    reducedMotion?.addEventListener?.("change", syncVisualizer);
    // Opening, minimizing, restoring and closing all change these.
    if (musicWindow) {
      new MutationObserver(syncVisualizer).observe(musicWindow, {
        attributes: true,
        attributeFilter: ["class", "hidden", "aria-hidden"],
      });
    }

    window.__pepoMusicController = { setPlaying, setTrack, requestAudioFrame };
    if (persistedSettings.playing) {
      localStorage.setItem(musicKey, JSON.stringify(settings));
      document.dispatchEvent(
        new CustomEvent("desktop:music-settings", { detail: settings }),
      );
    }
    render();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMusicPlayer);
  } else {
    initMusicPlayer();
  }
</script>
