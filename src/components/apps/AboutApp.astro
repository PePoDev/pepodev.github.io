---
import skills from "../../data/skills.json";
import ContactIcon from "./ContactIcon.astro";
---

<div class="app-content">
  <div class="terminal-heading">
    <span class="prompt">~/about $</span> whoami
  </div>
  <div class="profile-header">
    <div class="profile-avatar">T</div>
    <div class="profile-info">
      <h2>Thiwanon Chomcharoen (PePoDev)</h2>
      <div class="profile-role">Site Reliability Engineer</div>
      <div class="profile-location">Bangkok City, Thailand</div>
      <div style="margin-top:8px">
        <span class="status-badge online">Available for opportunities</span>
      </div>
    </div>
  </div>
  <h3>Who Am I</h3>
  <p>
    Experienced and energetic DevOps Engineer with over four years of experience
    effectively managing infrastructure projects from conception to completion.
    I specialize in using Kubernetes, Terraform, and many open-source
    technologies to deliver an efficient and reliable platform.
  </p>
  <p>
    I'm passionate about being part of the open-source community to create
    freedom of technology. When I'm not optimizing cloud costs or implementing
    chaos engineering, I'm building tools that help teams ship faster and sleep
    better.
  </p>
  <div class="section-divider"></div>
  <h3>Skills & Expertise</h3>
  <div class="skill-list">
    {
      skills.map((skill) => (
        <div class="skill-item">
          <div class="skill-item-label">
            <span>{skill.name}</span>
            <span>{skill.level}%</span>
          </div>
          <div class="skill-bar">
            <div
              class="skill-bar-fill"
              style="width: 0%"
              data-level={skill.level}
            />
          </div>
        </div>
      ))
    }
  </div>
  <div class="section-divider"></div>
  <h3>Get in Touch</h3>
  <div class="contact-links">
    <a href="mailto:pepo@pepo.dev" class="contact-link">
      <ContactIcon name="email" />
      pepo@pepo.dev
    </a>
    <a
      href="https://github.com/pepodev"
      class="contact-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <ContactIcon name="github" />
      GitHub
    </a>
    <a
      href="https://linkedin.com/in/pepodev"
      class="contact-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <ContactIcon name="linkedin" />
      LinkedIn
    </a>
    <a
      href="https://blog.pepo.dev"
      class="contact-link"
      target="_blank"
      rel="noopener noreferrer"
    >
      <ContactIcon name="blog" />
      Blog
    </a>
  </div>
</div>
