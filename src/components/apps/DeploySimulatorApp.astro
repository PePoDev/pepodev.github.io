---
const stages = ["Commit", "Test", "Build", "Deploy", "Canary", "Promote"];
---

<div class="app-content ops-app deploy-sim-app" data-deploy-sim>
  <div class="deploy-track">
    {stages.map((stage) => (
      <div class="deploy-stage" data-stage>
        <span></span>
        <strong>{stage}</strong>
      </div>
    ))}
  </div>
  <div class="deploy-console" data-deploy-console>Pipeline idle. Start a run.</div>
  <div class="settings-actions">
    <button type="button" data-deploy-start>Start deploy</button>
    <button type="button" data-deploy-rollback>Rollback</button>
  </div>
</div>

<script define:vars={{ stages }} is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const app = document.querySelector("[data-deploy-sim]");
    if (!app) return;
    const stageEls = Array.from(app.querySelectorAll("[data-stage]"));
    const consoleEl = app.querySelector("[data-deploy-console]");
    let timer = null;

    function setStage(index) {
      stageEls.forEach((stage, stageIndex) => {
        stage.classList.toggle("done", stageIndex < index);
        stage.classList.toggle("active", stageIndex === index);
      });
      consoleEl.textContent =
        index < stages.length
          ? "Running " + stages[index].toLowerCase() + " stage..."
          : "Deployment promoted. SLOs are healthy.";
    }

    app.querySelector("[data-deploy-start]").addEventListener("click", () => {
      if (timer) window.clearInterval(timer);
      let index = 0;
      setStage(index);
      timer = window.setInterval(() => {
        index += 1;
        setStage(index);
        if (index >= stages.length) window.clearInterval(timer);
      }, 900);
    });

    app.querySelector("[data-deploy-rollback]").addEventListener("click", () => {
      if (timer) window.clearInterval(timer);
      stageEls.forEach((stage) => stage.classList.remove("active", "done"));
      consoleEl.textContent = "Rollback executed. Previous stable revision restored.";
    });
  });
</script>
