---
import type { Project } from "@app-types/data";
import projects from "@data/projects.json";
---

<div class="app-content">
  <div class="terminal-heading">
    <span class="prompt">~/projects $</span> gh repo list --limit 10
  </div>
  <h2>Project Showcase</h2>
  <p class="app-subtitle">Tools, systems, and side projects I've built</p>
  <div class="project-grid">
    {
      projects.map((project) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card"
        >
          <div class="project-card-header">
            <div class="project-card-name">{project.name}</div>
            <div class="project-card-meta">
              {project.archived && (
                <span class="project-archived-badge">Archived</span>
              )}
              <span class="project-stars">★ {project.stars}</span>
            </div>
          </div>
          <div class="project-card-desc">{project.description}</div>
          <div class="project-tags">
            {project.tags.map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</div>
