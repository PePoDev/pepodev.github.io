---
const photos = [
  {
    title: "Production Dawn",
    meta: "observability wall",
    gradient: "linear-gradient(135deg, #0f766e, #22d3ee)",
  },
  {
    title: "Cluster Room",
    meta: "platform notes",
    gradient: "linear-gradient(135deg, #312e81, #a855f7)",
  },
  {
    title: "Release Night",
    meta: "deploy window",
    gradient: "linear-gradient(135deg, #7c2d12, #f59e0b)",
  },
  {
    title: "Quiet Pager",
    meta: "green dashboard",
    gradient: "linear-gradient(135deg, #14532d, #30d158)",
  },
];
---

<div class="app-content gallery-app" data-gallery-app>
  <section class="gallery-lock" data-gallery-lock>
    <div class="gallery-lock-image" aria-hidden="true">
      <div class="gallery-lock-shackle"></div>
      <div class="gallery-lock-body">
        <span></span>
      </div>
    </div>
    <form class="gallery-lock-form" data-gallery-form>
      <label for="gallery-password">Please enter the password</label>
      <input
        id="gallery-password"
        data-gallery-password
        type="password"
        autocomplete="current-password"
        aria-describedby="gallery-error"
      />
      <button type="submit">Unlock</button>
      <p id="gallery-error" data-gallery-error role="status" aria-live="polite">
      </p>
    </form>
  </section>

  <section
    class="gallery-unlocked"
    data-gallery-unlocked
    aria-labelledby="gallery-title"
    tabindex="-1"
    hidden
  >
    <div class="gallery-header">
      <span id="gallery-title" class="ops-pill">Private gallery</span>
      <strong>{photos.length} pictures</strong>
    </div>
    <div class="gallery-grid">
      {
        photos.map((photo) => (
          <article class="gallery-card">
            <div
              class="gallery-picture"
              style={`background: ${photo.gradient}`}
            >
              <span>{photo.title}</span>
            </div>
            <h3>{photo.title}</h3>
            <p>{photo.meta}</p>
          </article>
        ))
      }
    </div>
  </section>
</div>

<script>
  function initGallery() {
    const app = document.querySelector("[data-gallery-app]");
    if (!app) return;

    const form = app.querySelector("[data-gallery-form]");
    const passwordInput = app.querySelector("[data-gallery-password]");
    const error = app.querySelector("[data-gallery-error]");
    const locked = app.querySelector("[data-gallery-lock]");
    const unlocked = app.querySelector("[data-gallery-unlocked]");

    // Put the keyboard where it is needed: the password field while locked,
    // the pictures once unlocked.
    function focusGallery() {
      (locked.hidden ? unlocked : passwordInput).focus({ preventScroll: true });
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      if (passwordInput.value === "password") {
        locked.hidden = true;
        unlocked.hidden = false;
        error.textContent = "";
        passwordInput.removeAttribute("aria-invalid");
        focusGallery();
        return;
      }

      error.textContent = "Incorrect password, try again.";
      passwordInput.setAttribute("aria-invalid", "true");
      passwordInput.select();
    });

    // Opening, restoring or re-launching the window focuses it. Touch
    // screens wait for a tap unless the keyboard opened it, since the
    // password field raises the on-screen keyboard over the window.
    const win = app.closest("[data-window]");
    const touchQuery = window.matchMedia(
      "(max-width: 768px), (hover: none), (pointer: coarse)",
    );
    function focusOnOpen(keyboard: boolean) {
      if (keyboard || !touchQuery.matches) focusGallery();
    }
    win?.addEventListener("desktop:window-focus", (event) =>
      focusOnOpen(Boolean((event as CustomEvent).detail?.keyboard)),
    );
    // Rocket Loader can run this after the window opened.
    const active = document.activeElement;
    if (
      win?.classList.contains("focused") &&
      win.getAttribute("aria-hidden") === "false" &&
      (active === win || active === document.body)
    ) {
      focusOnOpen(active === win);
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }
</script>
