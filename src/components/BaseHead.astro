---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import "@styles/global.css";
import type { ImageMetadata } from "astro";
import {
  BLOG_TITLE,
  SITE_LOCALE,
  SITE_OG_IMAGE,
  SITE_OG_IMAGE_ALT,
  SITE_TITLE,
  SITE_URL,
} from "@/consts";
import { Font, getImage } from "astro:assets";

type SocialImage = ImageMetadata | string;

interface Props {
  title: string;
  description: string;
  image?: SocialImage;
  imageAlt?: string;
  type?: "website" | "article";
  /** Page language (BCP 47), "en" by default; sets og:locale and inLanguage. */
  lang?: string;
  /** Article dates for article:* tags and BlogPosting structured data. */
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Keep the page out of search results and omit its URL tags (the 404). */
  noindex?: boolean;
}

const OG_LOCALES: Record<string, string> = { th: "th_TH" };
const AUTHOR = {
  "@type": "Person",
  name: "Thiwanon Chomcharoen (PePo)",
};

const siteURL = Astro.site ?? new URL(SITE_URL);
const canonicalURL = new URL(Astro.url.pathname, siteURL);

const {
  title,
  description,
  image = SITE_OG_IMAGE,
  imageAlt = SITE_OG_IMAGE_ALT,
  type = "website",
  lang = "en",
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

// Share a resized JPEG, not the original upload (up to 1.3 MB, sometimes
// WebP, which some link-preview crawlers do not render).
const socialImage =
  typeof image === "string"
    ? { src: image, width: 1200, height: 630 }
    : await getImage({
        src: image,
        width: Math.min(image.width, 1200),
        format: "jpg",
        // One file, no srcset: crawlers read a single URL.
        layout: "none",
      }).then(({ src, attributes }) => ({
        src,
        width: Number(attributes.width),
        height: Number(attributes.height),
      }));
const socialImageURL = new URL(socialImage.src, siteURL);
const ogLocale = OG_LOCALES[lang] ?? SITE_LOCALE;

const structuredData =
  type === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        image: socialImageURL.href,
        datePublished: publishedTime?.toISOString(),
        dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
        inLanguage: lang,
        url: canonicalURL.href,
        mainEntityOfPage: canonicalURL.href,
        author: { ...AUTHOR, url: siteURL.href },
      }
    : {
        "@context": "https://schema.org",
        ...AUTHOR,
        jobTitle: "Site Reliability Engineer",
        url: siteURL.href,
        image: socialImageURL.href,
        sameAs: [
          "https://github.com/pepodev",
          "https://linkedin.com/in/pepodev",
          "https://blog.pepo.dev",
        ],
        knowsAbout: [
          "Kubernetes",
          "Terraform",
          "Cloud Infrastructure",
          "Site Reliability Engineering",
        ],
      };
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<!-- The ICO's sizes keep Chromium on the SVG; the ICO is for old browsers. -->
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={BLOG_TITLE}
  href={new URL("rss.xml", siteURL)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Theme & Author -->
<meta name="theme-color" content="#1a1a1a" />
<meta name="author" content="PePoDev" />
<meta name="robots" content={noindex ? "noindex" : "index, follow"} />

<!-- Desktop, blog, and resume type (variables.css). Not preloaded: website
     mode uses IBM Plex instead. -->
<Font cssVariable="--font-inter" />
<Font cssVariable="--font-jetbrains-mono" />

<!-- Canonical URL -->
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={ogLocale} />
{!noindex && <meta property="og:url" content={canonicalURL} />}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL.href} />
<meta property="og:image:secure_url" content={socialImageURL.href} />
<meta property="og:image:width" content={socialImage.width} />
<meta property="og:image:height" content={socialImage.height} />
<meta property="og:image:alt" content={imageAlt} />
{
  publishedTime && (
    <meta
      property="article:published_time"
      content={publishedTime.toISOString()}
    />
  )
}
{
  modifiedTime && (
    <meta
      property="article:modified_time"
      content={modifiedTime.toISOString()}
    />
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
{!noindex && <meta name="twitter:url" content={canonicalURL} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL.href} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Structured Data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
/>
