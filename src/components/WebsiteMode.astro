    <section
      id="website-contact"
      class="ws-section ws-wrap"
      aria-labelledby="website-contact-title"
    >
      <div class="ws-sec-head">
        <span class="ws-sec-idx" aria-hidden="true">{contactIndex}</span>
        <h2 id="website-contact-title">Contact</h2>
        <p class="ws-sec-meta">Bangkok · UTC+7</p>
      </div>
      <div class="ws-ct-grid">
        <div class="ws-panel ws-contact">
          <h3 class="ws-contact-title">Let's build something reliable.</h3>
          <p class="ws-contact-copy">
            Reach out about infrastructure, SRE, open source, or collaboration.
          </p>
          <div class="ws-email-row">
            <a class="ws-email" href={emailHref}>{email}</a>
            <button class="ws-copy" type="button" data-copy-email={email} hidden>
              Copy<span class="ws-sr"> email address</span>
            </button>
            <span class="ws-sr" role="status" data-copy-status></span>
          </div>
          <ul class="ws-channels" aria-label="Elsewhere">
            {
              channels.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.external ? "_blank" : undefined}
                    rel={link.external ? "noopener noreferrer" : undefined}
                  >
                    <b>{link.name}</b>
                    <span>{link.handle}</span>
                    <i aria-hidden="true">{link.external ? "↗" : "→"}</i>
