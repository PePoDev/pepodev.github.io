                <path d="M228 22 L262 48 L300 30 M262 48 L250 90"></path>
                <path d="M150 178 L196 160 L232 182"></path>
                <path d="M110 40 L140 18"></path>
              </g>
              <g fill="currentColor" fill-opacity=".75">
                <circle cx="18" cy="150" r="1.6"></circle>
                <circle cx="52" cy="128" r="2"></circle>
                <circle cx="70" cy="170" r="1.4"></circle>
                <circle cx="96" cy="112" r="1.4"></circle>
                <circle cx="228" cy="22" r="1.6"></circle>
                <circle cx="262" cy="48" r="2.2"></circle>
                <circle cx="250" cy="90" r="1.4"></circle>
                <circle cx="150" cy="178" r="1.4"></circle>
                <circle cx="196" cy="160" r="2"></circle>
                <circle cx="110" cy="40" r="1.3"></circle>
              </g>
              <g fill="#e8edf3" fill-opacity=".55">
                <circle cx="300" cy="30" r="1.6"></circle>
                <circle cx="232" cy="182" r="1.6"></circle>
                <circle cx="140" cy="18" r="1.4"></circle>
              </g>
            </svg>
            <div class="ws-mini-icons">
              <i style="--c:#0a84ff"></i><i style="--c:#30d158"></i><i
                style="--c:#ff9f0a"></i><i style="--c:#bf5af2"></i><i
                style="--c:#30d158"></i>
            </div>
            <div class="ws-mini-icons ws-mini-icons--col">
              <i style="--c:#64d2ff"></i><i style="--c:#bf5af2"></i><i
                style="--c:#0a84ff"></i><i style="--c:#30d158"></i>
            </div>
            <div class="ws-mini-win">
              <div class="ws-mw-bar">
                <span>Work — Experience</span><b></b><b></b><b></b>
              </div>
              <div class="ws-mw-body">
                <p class="ws-mw-cmd">~/work $ cat career_history.md</p>
                <p class="ws-mw-h">Career Timeline</p>
                <span style="width:82%"></span><span style="width:64%"></span><span
                  style="width:74%"></span>
              </div>
            </div>
            <div class="ws-mini-task">
              <span class="ws-mt-start"></span><span class="ws-mt-app">Work</span
              ><span class="ws-mt-clock" data-bkk-time>{bangkokTime}</span>
            </div>
          </div>
          <div class="ws-desk-copy">
            <h3 class="ws-desk-title">pepo.dev is also a desktop.</h3>
            <p>
              Draggable windows, a terminal, Snake and an SRE game, with this same
              portfolio inside. Same content, different shape.
            </p>
            <button
              class="ws-btn ws-btn--desk"
              type="button"
              data-site-mode-target="desktop"
            >
              <MonitorIcon size={16} />Launch desktop mode
