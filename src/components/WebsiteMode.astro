---
import BrandMark from "@components/BrandMark.astro";
import ModeSwitch from "@components/ModeSwitch.astro";
import MonitorIcon from "@components/MonitorIcon.astro";
import certifications from "@data/certifications.json";
import education from "@data/education.json";
import experiences from "@data/experiences.json";
import projects from "@data/projects.json";
import skills from "@data/skills.json";
import socialLinks from "@data/social-links.json";
import "@styles/website-mode.css";
import {
  getPostDescription,
  getPostLanguage,
  getPublishedPosts,
} from "@utils/blog";
import {
  formatCertificationMonth,
  getProviderBadge,
  summarizeCertifications,
} from "@utils/certifications";
import { formatDegreeShort, formatEducationYears } from "@utils/education";
import {
  formatIsoMonth,
  formatMonth,
  getCareerSummary,
  monthIndex,
  numberToWords,
  type TimelineSegment,
} from "@utils/experience";
import { gardenHref, getGardenNotes, getRecentlyTended } from "@utils/garden";
import {
  getGameJamYear,
  getLanguageColor,
  getProjectLanguage,
  getProjectLinkLabel,
  getProjectSummary,
  getProjectTopics,
  isGameJamProject,
} from "@utils/projects";

const now = new Date();
const career = getCareerSummary(experiences, now);
const { roles, current, firstStart, today } = career;
const previousCompanies = roles
  .filter((role) => !role.current)
  .slice(0, 2)
  .map((role) => role.companyShortName);
const currentLine = current
  ? `Currently at ${current.companyName}${
      previousCompanies.length > 0
        ? `, previously ${previousCompanies.join(" and ")}`
        : ""
    }.`
  : "";
const certSummary = summarizeCertifications(certifications);
const certYears =
  certSummary.firstYear === certSummary.lastYear
    ? `${certSummary.lastYear ?? ""}`
    : `${certSummary.firstYear}–${certSummary.lastYear}`;
const certificationsNewestFirst = [...certifications].sort((a, b) =>
  b.issueDate.localeCompare(a.issueDate),
);

// "Terraform / Terramate / IaC" -> Terraform + "Terramate · IaC";
// "Cloud (AWS, GCP)" -> Cloud + "AWS · GCP".
const stack = skills.map(({ name }) => {
  const paren = name.match(/^(.*?)\s*\((.*)\)$/);
  if (paren) {
    return { name: paren[1], detail: paren[2].split(/,\s*/).join(" · ") };
  }
  const [first, ...rest] = name.split(" / ");
  return { name: first, detail: rest.join(" · ") };
});
const coreStack = stack.slice(0, 5).map(({ name }) => name);

const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, 5).map((post) => ({
  post,
  lang: getPostLanguage(post),
  date: post.data.pubDate.toISOString().slice(0, 10),
}));
const allNotes = await getGardenNotes();
const gardenNotes = getRecentlyTended(allNotes, 5);
const gardenCount = allNotes.filter((note) => note.id !== "index").length;
// Writing and Garden take the next numbers only when they have something to
// show, so Contact always comes last.
let nextIndex = 4;
const sectionIndex = () => String(nextIndex++).padStart(2, "0");
const writingIndex = posts.length > 0 ? sectionIndex() : "";
const gardenIndex = gardenNotes.length > 0 ? sectionIndex() : "";
const contactIndex = sectionIndex();
const thaiPosts = allPosts.filter(
  (post) => getPostLanguage(post) === "th",
).length;
const topics = [
  ...new Set(allPosts.map((post) => post.data.tags?.[0]).filter(Boolean)),
] as string[];
const topicList =
  topics.length > 1
    ? `${topics.slice(0, -1).join(", ")} and ${topics.at(-1)}`
    : topics.join("");

const activeProjects = projects.filter(({ archived }) => !archived);
const archivedProjects = projects.filter(({ archived }) => archived);
const gameJams = archivedProjects.filter(isGameJamProject).length;
const archiveLine = `${archivedProjects.length} projects${
  gameJams > 0
    ? `, including ${numberToWords(gameJams)} Global Game Jam entries`
    : ""
}`;
const originLine = `I started out writing game backends in Go${
  gameJams > 0
    ? `, and I've built games at ${numberToWords(gameJams)} Global Game Jams`
    : ""
}.`;

const socialByIcon = new Map(socialLinks.map((link) => [link.icon, link]));
const emailHref = socialByIcon.get("email")?.href ?? "mailto:pepo@pepo.dev";
const email = emailHref.replace(/^mailto:/, "");
const resumeHref = socialByIcon.get("resume")?.href ?? "/resume/";
const issueLink = socialByIcon.get("issue");
const webringLink = socialByIcon.get("webring");
const isExternal = (href: string) => /^https?:/.test(href);
// The garden lives on this site now, so its channel is a local link.
const gardenChannel =
  gardenNotes.length > 0
    ? { label: "Digital garden", href: "/garden/", icon: "garden" }
    : undefined;
const channels = ["github", "linkedin", "resume", "blog", "garden", "facebook"]
  .map((icon) => (icon === "garden" ? gardenChannel : socialByIcon.get(icon)))
  .filter((link) => link !== undefined)
  .map((link) => {
    const [label, handle] = link.label.split(" - ");
    const name =
      label === label.toUpperCase()
        ? label.charAt(0) + label.slice(1).toLowerCase()
        : label;
    return {
      ...link,
      name: name.replace(/^Digital Garden$/, "Digital garden"),
      handle: handle ?? `pepo.dev${link.href}`,
      external: isExternal(link.href),
    };
  });

// Bangkok has no daylight saving time, so ICT is always UTC+7. The script
// below keeps this current; the build-time value stands in without JS.
const bangkokTime = new Intl.DateTimeFormat("en-GB", {
  timeZone: "Asia/Bangkok",
  hour: "2-digit",
  minute: "2-digit",
  hourCycle: "h23",
}).format(now);
const buildDate = now.toISOString().slice(0, 10);

const segmentLabel = (segment: TimelineSegment) => {
  const from = formatMonth(segment.start, "long");
  const span = segment.role?.current
    ? `${from} to present`
    : `${from} to ${formatMonth(segment.end, "long")}`;
  return segment.role
    ? `${segment.role.companyName}, ${segment.role.role}, ${span}`
    : `Between roles, ${span}`;
};
const yearSpan = (segment: TimelineSegment) => {
  const start = segment.start.year;
  if (segment.role?.current) return `${start}–now`;
  const end = segment.end.year;
  return end === start ? `${start}` : `${start}–${String(end).slice(2)}`;
};
const roleSegments = career.timeline.filter((segment) => segment.role);

// "Built observability platform with…" -> tag "Built" + "Observability
// platform with…". When the rest starts with a connective ("Deployed and
// managed…", "Contributed to…"), it stays lower case and carries on from the
// tag ("and managed…"), so the verb is not repeated. Only the display
// changes; experiences.json keeps its wording.
const CONNECTIVES = new Set(
  "a an and as at by for from in into of on or the to with".split(" "),
);
const changeOf = (detail: string) => {
  const [verb, ...words] = detail.split(" ");
  const text = words.join(" ");
  return CONNECTIVES.has(words[0]?.toLowerCase() ?? "")
    ? { verb, text }
    : { verb, text: text.charAt(0).toUpperCase() + text.slice(1) };
};
const visibleChanges = 4;
---

<div
  id="website"
  class="website-shell"
  data-site-mode-panel="website"
  aria-hidden="true"
>
  <a class="website-skip-link" href="#website-main">Skip to content</a>

  <header class="website-header">
    <div class="ws-header-inner">
      <a class="ws-brand" href="#website-hero" aria-label="pepo.dev, back to top">
        <BrandMark size={26} />
        <span>pepo.dev</span>
      </a>
      <nav class="ws-nav" aria-label="Portfolio sections">
        <a href="#website-overview"><span aria-hidden="true">01</span>Overview</a>
        <a href="#website-experience"
          ><span aria-hidden="true">02</span>Experience</a
        >
        <a href="#website-projects"><span aria-hidden="true">03</span>Projects</a>
        {
          posts.length > 0 && (
            <a href="#website-writing">
              <span aria-hidden="true">{writingIndex}</span>Writing
            </a>
          )
        }
        {
          gardenNotes.length > 0 && (
            <a class="ws-nav-optional" href="#website-garden">
              <span aria-hidden="true">{gardenIndex}</span>Garden
            </a>
          )
        }
        <a href="#website-contact"
          ><span aria-hidden="true">{contactIndex}</span
          >Contact</a
        >
      </nav>
      <div class="ws-header-actions">
        <a class="ws-resume-link" href={resumeHref}>Resume</a>
        <ModeSwitch variant="website" />
      </div>
    </div>
  </header>

  <main id="website-main" class="ws-main" tabindex="-1">
    <section
      id="website-hero"
      class="ws-hero ws-wrap"
      aria-labelledby="website-title"
    >
      <div class="ws-hero-grid">
        <div class="ws-hero-copy">
          <div class="ws-identity">
            <BrandMark size={44} />
            <p>
              <b>Thiwanon Chomcharoen</b>
              <span>PePoDev · {current?.role ?? roles[0]?.role}</span>
            </p>
          </div>
          <h1 id="website-title">
            I keep cloud platforms reliable, observable and <span
              class="ws-keep">cost-efficient.</span
            >
          </h1>
          <p class="ws-lede">
            {current?.role ?? "Engineer"} in Bangkok with <strong
              >{career.yearsLabel} years of experience</strong
            >, running Kubernetes, Terraform and AWS/GCP infrastructure in
            production. {currentLine}
          </p>
          <div class="ws-cta-row">
            <a class="ws-btn ws-btn--primary" href={emailHref}>Email me</a>
            <a class="ws-btn" href={resumeHref}>View resume</a>
            <a class="ws-text-link" href="#website-experience"
              >Read the changelog <span aria-hidden="true">↓</span></a
            >
          </div>
        </div>

        <div class="ws-hero-side">
          <aside class="ws-status-card" aria-label="Profile at a glance">
            <div class="ws-sc-head">
              <p class="ws-sc-state">
                <span class="ws-pulse" aria-hidden="true"></span>Open to
                opportunities
              </p>
              <p class="ws-sc-time">
                <span class="ws-sr">Local time in Bangkok: </span><time
                  data-bkk-time
                  datetime={bangkokTime}>{bangkokTime}</time
                > ICT
              </p>
            </div>
            <dl class="ws-sc-list">
              {
                current && (
                  <>
                    <div>
                      <dt>Role</dt>
                      <dd>{current.role}</dd>
                    </div>
                    <div>
                      <dt>Company</dt>
                      <dd>
                        {current.companyName}{" "}
                        <span class="ws-dim">
                          since {formatMonth(current.start)}
                        </span>
                      </dd>
                    </div>
                  </>
                )
              }
              <div data-experience-years>
                <dt>Experience</dt>
                <dd>
                  {career.yearsLabel} years{" "}
                  <span class="ws-dim">
                    {career.companies} companies since {firstStart?.year}
                  </span>
                </dd>
              </div>
              <div>
                <dt>Based in</dt>
                <dd>Bangkok, Thailand <span class="ws-dim">UTC+7</span></dd>
              </div>
              <div>
                <dt>Studied</dt>
                <dd>
                  {formatDegreeShort(education)}{" "}
                  <span class="ws-dim">
                    <abbr title={education.school}>{education.schoolShort}</abbr>
                    · {formatEducationYears(education, "–")}
                  </span>
                </dd>
              </div>
              <div>
                <dt>Core stack</dt>
                <dd class="ws-dots">
                  {coreStack.map((name) => <span>{name}</span>)}
                </dd>
              </div>
              {
                certSummary.count > 0 && (
                  <div>
                    <dt>Certified</dt>
                    <dd>
                      {certSummary.count} earned{" "}
                      <span class="ws-dim">{certYears}</span>
                      <span class="ws-dim ws-dd-line">
                        {certSummary.providers.join(", ")}
                      </span>
                    </dd>
                  </div>
                )
              }
            </dl>
          </aside>

          <div class="ws-bridge">
            <div class="ws-mini ws-mini--sm" aria-hidden="true">
              <div class="ws-mini-icons">
                <i style="--c:#0a84ff"></i><i style="--c:#30d158"></i><i
                  style="--c:#ff9f0a"></i>
              </div>
              <div class="ws-mini-win">
                <div class="ws-mw-bar"><b></b><b></b><b></b></div>
              </div>
              <div class="ws-mini-task"></div>
            </div>
            <div class="ws-bridge-copy">
              <p class="ws-bridge-title">This portfolio is also a desktop.</p>
              <p class="ws-bridge-sub">
                Windows, a terminal and games, with the same content.
              </p>
            </div>
            <button
              class="ws-btn ws-btn--bridge"
              type="button"
              data-site-mode-target="desktop"
            >
              <MonitorIcon size={16} />Open desktop mode
            </button>
          </div>
        </div>
      </div>

      {
        firstStart && (
          <figure class="ws-uptime" aria-labelledby="website-uptime-title">
            <figcaption class="ws-uptime-head">
              <h2 id="website-uptime-title">Career uptime</h2>
              <p class="ws-dots" data-uptime-summary>
                <span>{`${formatMonth(firstStart)} – ${formatMonth(today)}`}</span>
                <span>{`${career.totalMonths} months`}</span>
                <span>{`${career.companies} companies`}</span>
              </p>
              <p class="ws-uptime-key">
                <span>
                  <i class="ws-key ws-key--on" aria-hidden="true" />
                  In role
                </span>
                <span>
                  <i class="ws-key ws-key--gap" aria-hidden="true" />
                  Between roles
                </span>
                <span class="ws-key-scale">1 bar = 1 month</span>
              </p>
            </figcaption>
            <div
              class="ws-uptime-chart"
              style={`--months: ${career.totalMonths}`}
            >
              {career.timeline.map((segment) => (
                <span
                  class:list={[
                    "ws-seg",
                    segment.kind === "gap" && "ws-seg--gap",
                    segment.role?.current && "ws-seg--current",
                  ]}
                  style={`--start: ${segment.offset + 1}; --n: ${segment.months}`}
                  role="img"
                  aria-label={segmentLabel(segment)}
                  title={segmentLabel(segment)}
                >
                  {Array.from({ length: segment.months }, (_, index) => (
                    <i
                      class:list={{
                        "ws-ye":
                          (monthIndex(segment.start) + index) % 12 === 11,
                      }}
                    />
                  ))}
                </span>
              ))}
              {roleSegments.map((segment, index) => (
                <span
                  class:list={["ws-lab", index % 2 === 0 && "ws-lab--alt"]}
                  style={`--start: ${segment.offset + 1}; --n: ${segment.months}`}
                  aria-hidden="true"
                >
                  <b>
                    <span class="ws-l-full">{segment.role!.companyShortName}</span>
                    <span class="ws-l-tiny">
                      {segment.role!.companyShortName.split(" ")[0]}
                    </span>
                  </b>
                  <span>{yearSpan(segment)}</span>
                </span>
              ))}
            </div>
            <div class="ws-uptime-foot" aria-hidden="true">
              <span>{formatMonth(firstStart)}</span>
              <span>{formatMonth(today)}</span>
            </div>
          </figure>
        )
      }
    </section>

    <section
      id="website-overview"
      class="ws-section ws-wrap"
      aria-labelledby="website-overview-title"
    >
      <div class="ws-sec-head">
        <span class="ws-sec-idx" aria-hidden="true">01</span>
        <h2 id="website-overview-title">Overview</h2>
        <p class="ws-sec-meta">What I do, and what I work with</p>
      </div>
      <div class="ws-ov-grid">
        <div class="ws-ov-main">
          <div class="ws-ov-copy">
            <p class="ws-big">
              I design and operate cloud platforms on Kubernetes, Terraform, AWS
              and Google Cloud. The job, as I see it: keep them dependable, easy
              to understand, and no more expensive than they need to be.
            </p>
            <p>
              {originLine} I still like turning operational lessons into things
              other engineers enjoy, from small Go CLIs to chaos engineering played
              as a game.
            </p>
          </div>

          <div class="ws-panel ws-stack">
            <div class="ws-panel-head">
              <h3>Core stack</h3>
              <small>{stack.length} areas</small>
            </div>
            <ul class="ws-stack-list">
              {
                stack.map((item) => (
                  <li>
                    <b>{item.name}</b>
                    {item.detail && <span>{item.detail}</span>}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        {
          certSummary.count > 0 && (
            <div class="ws-panel ws-certs">
              <div class="ws-panel-head">
                <h3>Certifications</h3>
                <small>
                  {certSummary.count} earned · {certYears}
                </small>
              </div>
              <ul>
                {certificationsNewestFirst.map((cert) => (
                  <li>
                    <a
                      href={cert.credlyUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <span class="ws-prov" aria-hidden="true">
                        {getProviderBadge(cert.provider)}
                      </span>
                      <span class="ws-cert-name">
                        <b>{cert.name}</b>
                        <small>{cert.provider}</small>
                      </span>
                      <span class="ws-cert-date">
                        Earned {formatCertificationMonth(cert.issueDate, "short")}
                        <span class="ws-ext" aria-hidden="true">↗</span>
                        <span class="ws-sr"> (opens Credly)</span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    <section
      id="website-experience"
      class="ws-section ws-wrap"
      aria-labelledby="website-experience-title"
    >
      <div class="ws-sec-head">
        <span class="ws-sec-idx" aria-hidden="true">02</span>
        <h2 id="website-experience-title">Experience</h2>
        <p class="ws-sec-meta">
          <span>Changelog · newest first</span>
          <a class="ws-head-link" href={resumeHref}
            >Full resume <span aria-hidden="true">→</span></a
          >
        </p>
      </div>
      <div class="ws-changelog">
        {
          roles.map((role) => {
            const shown = role.details.slice(0, visibleChanges);
            const more = role.details.slice(visibleChanges);
            return (
              <article
                class:list={["ws-release", role.current && "ws-release--current"]}
              >
                <div class="ws-rel-meta">
                  <p class="ws-rel-company">{role.companyName}</p>
                  <p class="ws-rel-period">
                    <time datetime={formatIsoMonth(role.start)}>
                      {formatMonth(role.start)}
                    </time>{" "}
                    <span aria-hidden="true">→</span>
                    <span class="ws-sr">to</span>{" "}
                    {role.current ? (
                      "Present"
                    ) : (
                      <time datetime={formatIsoMonth(role.end)}>
                        {formatMonth(role.end)}
                      </time>
                    )}
                  </p>
                  <p class="ws-rel-dur">
                    <span data-tenure>{role.tenure}</span>
                    {role.current && (
                      <span class="ws-pill ws-pill--live">Current</span>
                    )}
                  </p>
                </div>
                <div class="ws-rel-body">
                  <h3>
                    {role.role}
                    <span class="ws-sr"> at {role.companyName}</span>
                  </h3>
                  <ul class="ws-changes">
                    {shown.map((detail) => {
                      const { verb, text } = changeOf(detail);
                      return (
                        <li>
                          <span class="ws-tag">{verb}</span> <span>{text}</span>
                        </li>
                      );
                    })}
                  </ul>
                  {more.length > 0 && (
                    <details class="ws-more">
                      <summary>
                        <span class="ws-more-closed">+{more.length} more</span>
                        <span class="ws-more-open">Show fewer</span>
                        <span class="ws-sr"> at {role.companyName}</span>
                      </summary>
                      <ul class="ws-changes">
                        {more.map((detail) => {
                          const { verb, text } = changeOf(detail);
                          return (
                            <li>
                              <span class="ws-tag">{verb}</span>{" "}
                              <span>{text}</span>
                            </li>
                          );
                        })}
                      </ul>
                    </details>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section
      id="website-projects"
      class="ws-section ws-wrap"
      aria-labelledby="website-projects-title"
    >
      <div class="ws-sec-head">
        <span class="ws-sec-idx" aria-hidden="true">03</span>
        <h2 id="website-projects-title">Projects</h2>
        <p class="ws-sec-meta">
          {activeProjects.length} active · {archivedProjects.length} archived
        </p>
      </div>
      <div class="ws-svc-grid">
        {
          activeProjects.map((project) => {
            const language = getProjectLanguage(project);
            const linkLabel = getProjectLinkLabel(project);
            return (
              <article class="ws-svc">
                <div class="ws-svc-top">
                  <span class="ws-state">Active</span>
                  {project.stars > 0 && (
                    <span class="ws-stars">
                      <span aria-hidden="true">★</span> {project.stars}
                      <span class="ws-sr"> GitHub stars</span>
                    </span>
                  )}
                </div>
                <h3>{project.name}</h3>
                <p>{getProjectSummary(project)}</p>
                <p class="ws-svc-meta">
                  {language && (
                    <span
                      class="ws-lang"
                      style={`--lang: ${getLanguageColor(language)}`}
                    >
                      {language}
                    </span>
                  )}
                  {getProjectTopics(project).map((topic) => (
                    <span>{topic}</span>
                  ))}
                </p>
                <div class="ws-svc-links">
                  {linkLabel && (
                    <a href={project.link} target="_blank" rel="noopener noreferrer">
                      {linkLabel}
                      <span class="ws-sr">: {project.name}</span>
                      <span class="ws-ext" aria-hidden="true">↗</span>
                    </a>
                  )}
                  <a href={project.github} target="_blank" rel="noopener noreferrer">
                    Source
                    <span class="ws-sr">: {project.name} on GitHub</span>
                    <span class="ws-ext" aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
      {
        archivedProjects.length > 0 && (
          <details class="ws-panel ws-archive" data-archive>
            <summary>
              <span class="ws-arch-title">Archived</span>
              <span class="ws-arch-meta">{archiveLine}</span>
              <span class="ws-chev" aria-hidden="true" />
            </summary>
            <table class="ws-arch-table">
              <caption class="ws-sr">Archived projects</caption>
              <thead>
                <tr>
                  <th scope="col">Project</th>
                  <th scope="col">What it was</th>
                  <th scope="col">Stack</th>
                  <th scope="col" class="ws-a-stars">
                    Stars
                  </th>
                </tr>
              </thead>
              <tbody>
                {archivedProjects.map((project) => {
                  const jamYear = getGameJamYear(project);
                  return (
                    <tr>
                      <th scope="row">
                        <a
                          href={project.github}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {project.name}
                        </a>
                      </th>
                      <td class="ws-a-desc">
                        {getProjectSummary(project)}
                        {jamYear && (
                          <span class="ws-ggj">
                            <abbr title="Global Game Jam">GGJ</abbr> {jamYear}
                          </span>
                        )}
                      </td>
                      <td class="ws-a-lang">{getProjectLanguage(project)}</td>
                      <td class="ws-a-stars">
                        {project.stars > 0 && (
                          <>
                            <span aria-hidden="true">★</span> {project.stars}
                            <span class="ws-sr"> GitHub stars</span>
                          </>
                        )}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </details>
        )
      }
    </section>

    {
      posts.length > 0 && (
        <section
          id="website-writing"
          class="ws-section ws-wrap"
          aria-labelledby="website-writing-title"
        >
          <div class="ws-sec-head">
            <span class="ws-sec-idx" aria-hidden="true">
              {writingIndex}
            </span>
            <h2 id="website-writing-title">Writing</h2>
            <p class="ws-sec-meta">
              {`${allPosts.length} posts${thaiPosts > 0 ? ` · ${thaiPosts} in Thai` : ""}`}
            </p>
          </div>
          <div class="ws-wr-grid">
            <div class="ws-panel ws-posts">
              <div class="ws-panel-head">
                <h3>Latest posts</h3>
                <a class="ws-head-link" href="/blog/">
                  All articles <span aria-hidden="true">→</span>
                </a>
              </div>
              <ol>
                {posts.map(({ post, lang, date }) => (
                  <li class="ws-post">
                    <time datetime={date}>{date}</time>
                    <span class="ws-post-main" lang={lang}>
                      <a class="ws-post-title" href={`/blog/${post.id}/`}>
                        {post.data.title}
                      </a>
                      <span>{getPostDescription(post)}</span>
                    </span>
                    <span class="ws-post-tags">
                      <span
                        class="ws-lang-tag"
                        title={lang === "th" ? "Written in Thai" : "Written in English"}
                      >
                        {lang.toUpperCase()}
                      </span>
                      <span class="ws-post-topics">
                        {post.data.tags?.slice(0, 2).map((tag) => (
                          <span>{tag}</span>
                        ))}
                      </span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
            <div class="ws-panel ws-elsewhere">
              <div class="ws-panel-head">
                <h3>Read elsewhere</h3>
              </div>
              <ul>
                {[socialByIcon.get("blog")]
                  .filter((link) => link !== undefined)
                  .map((link) => {
                    const [, host] = link.label.split(" - ");
                    return (
                      <li>
                        <a href={link.href} target="_blank" rel="noopener noreferrer">
                          <b>Engineering blog</b>
                          <span>{host}</span>
                          <i aria-hidden="true">↗</i>
                        </a>
                      </li>
                    );
                  })}
                <li>
                  <a href="/blog/">
                    <b>Articles on this site</b>
                    <span>pepo.dev/blog</span>
                    <i aria-hidden="true">→</i>
                  </a>
                </li>
                {gardenNotes.length > 0 && (
                  <li>
                    <a href="/garden/">
                      <b>Digital garden</b>
                      <span>pepo.dev/garden</span>
                      <i aria-hidden="true">→</i>
                    </a>
                  </li>
                )}
                <li>
                  <a href="/rss.xml">
                    <b>RSS feed</b>
                    <span>pepo.dev/rss.xml</span>
                    <i aria-hidden="true">→</i>
                  </a>
                </li>
              </ul>
              {topicList && (
                <p class="ws-note">Topics so far: {topicList}.</p>
              )}
            </div>
          </div>
        </section>
      )
    }

    {
      gardenNotes.length > 0 && (
        <section
          id="website-garden"
          class="ws-section ws-wrap"
          aria-labelledby="website-garden-title"
        >
          <div class="ws-sec-head">
            <span class="ws-sec-idx" aria-hidden="true">
              {gardenIndex}
            </span>
            <h2 id="website-garden-title">Garden</h2>
            <p class="ws-sec-meta">{`${gardenCount} notes, synced from Obsidian`}</p>
          </div>
          <div class="ws-panel ws-posts">
            <div class="ws-panel-head">
              <h3>Recently tended</h3>
              <a class="ws-head-link" href="/garden/">
                Explore the garden <span aria-hidden="true">→</span>
              </a>
            </div>
            <ol>
              {gardenNotes.map((note) => (
                <li class="ws-post">
                  {note.data.updated ? (
                    <time datetime={note.data.updated.toISOString()}>
                      {note.data.updated.toISOString().slice(0, 10)}
                    </time>
                  ) : (
                    <span />
                  )}
                  <span class="ws-post-main">
                    <a class="ws-post-title" href={gardenHref(note)}>
                      {note.data.title}
                    </a>
                    <span>{note.data.folders.join(" / ")}</span>
                  </span>
                  <span class="ws-post-tags">
                    <span class="ws-post-topics">
                      {note.data.folders.slice(1, 3).map((folder) => (
                        <span>{folder}</span>
