---
import MonitorIcon from "@components/MonitorIcon.astro";

interface Props {
  id?: string;
  variant: "taskbar" | "website";
}

const { id, variant } = Astro.props;
---

<button
  id={id}
  class:list={["site-mode-switch", `site-mode-switch--${variant}`]}
  type="button"
  data-site-mode-toggle
  aria-label="Switch to website mode"
  aria-pressed="false"
  title="Switch to website mode"
>
  <MonitorIcon />
  {variant === "website" && <span data-site-mode-label>Website mode</span>}
</button>
