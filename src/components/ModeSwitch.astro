---
interface Props {
  id?: string;
  variant: "taskbar" | "website";
}

const { id, variant } = Astro.props;
---

<button
  id={id}
  class:list={["site-mode-switch", `site-mode-switch--${variant}`]}
  type="button"
  data-site-mode-toggle
  aria-label="Switch to website mode"
  aria-pressed="false"
  title="Switch to website mode"
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect
      x="3"
      y="4"
      width="18"
      height="13"
      rx="2"
      stroke="currentColor"
      stroke-width="1.8"
    />
    <path
      d="M8 21h8M12 17v4M7 8h10M7 11h6"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
    />
  </svg>
  {variant === "website" && <span data-site-mode-label>Website mode</span>}
</button>
