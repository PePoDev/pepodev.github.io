---
import MonitorIcon from "@components/MonitorIcon.astro";

interface Props {
  id?: string;
  variant: "taskbar" | "website";
}

const { id, variant } = Astro.props;
// An action button: its name says what it does, so it has no pressed state.
// Each variant shows only in its own mode, so the name never changes and is
// right before any script runs.
const nextMode = variant === "website" ? "desktop" : "website";
const actionLabel = `Switch to ${nextMode} mode`;
---

<button
  id={id}
  class:list={["site-mode-switch", `site-mode-switch--${variant}`]}
  type="button"
  data-site-mode-toggle
  aria-label={actionLabel}
  title={actionLabel}
>
  <MonitorIcon />
  {variant === "website" && <span data-site-mode-label>Desktop mode</span>}
</button>
