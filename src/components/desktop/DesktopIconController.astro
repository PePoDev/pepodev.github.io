<script is:inline data-cfasync="false">
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    if (window.__pepodevDesktopIconsReady) return;
    window.__pepodevDesktopIconsReady = true;

    // App icons and external link icons share one grid and one occupancy map,
    // so neither kind can be placed on top of the other.
    const desktopIcons = Array.from(
      document.querySelectorAll(".desktop-icon[data-open-app]"),
    );
    // Links are placed in shortcut order, so Webring keeps the top-right cell.
    const linkIcons = Array.from(
      document.querySelectorAll(".desktop-link-icon[id]"),
    ).sort((a, b) => getShortcutIndex(a) - getShortcutIndex(b));
    const allIcons = [...desktopIcons, ...linkIcons];
    // v3/v4 drop layouts that older versions re-saved on every resize.
    const storagePrefix = "pepodev.desktopIcon.v3.";
    const linkStoragePrefix = "pepodev.linkIcon.v4.";
    const gridOriginX = 20;
    const gridOriginY = 20;
    const gridColumnStep = 88;
    const gridRowStep = 98;
    const iconMargin = 8;
    const taskbarReserve = 56;
    // Keeps "center" icons clear of the left-hand app group on narrow screens.
    const minCenterColumn = 6;
    const mobileQuery = window.matchMedia("(max-width: 768px)");
    const savedPositions = new Map();
    let occupiedCells = new Map();
    let iconCells = new Map();

    function isMobileLauncherMode() {
      return mobileQuery.matches;
    }

    // A hidden desktop measures as 0x0, so layout waits until it is shown.
    function isDesktopShown() {
      return (
        document.documentElement.dataset.siteMode === "desktop" &&
        allIcons[0]?.offsetWidth > 0
      );
    }

    function clearIconPosition(icon) {
      icon.style.position = "";
      icon.style.left = "";
      icon.style.top = "";
      icon.style.right = "";
      icon.style.bottom = "";
      icon.style.zIndex = "";
    }

    function getShortcutIndex(icon) {
      return Number.parseInt(icon.dataset.shortcutIndex || "0", 10);
    }

    function getStorageKey(icon) {
      return icon.dataset.openApp
        ? storagePrefix + icon.dataset.openApp
        : linkStoragePrefix + icon.id;
    }

    function removeStaleIconPositions() {
      try {
        const staleKeys = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (
            /^pepodev\.(desktopIcon|linkIcon)\.v\d+\./.test(key) &&
            !key.startsWith(storagePrefix) &&
            !key.startsWith(linkStoragePrefix)
          ) {
            staleKeys.push(key);
          }
        }
        staleKeys.forEach((key) => localStorage.removeItem(key));
      } catch {
        // Ignore storage failures; stale keys are never read.
      }
    }

    function loadIconPosition(icon) {
      try {
        const saved = JSON.parse(localStorage.getItem(getStorageKey(icon)));
        return Number.isFinite(saved?.x) && Number.isFinite(saved?.y)
          ? saved
          : null;
      } catch {
        return null;
      }
    }

    // Only an explicit drag saves a position; resizes re-clamp in memory.
    function saveIconPosition(icon, position) {
      savedPositions.set(icon, position);
      try {
        localStorage.setItem(getStorageKey(icon), JSON.stringify(position));
      } catch {
        // Ignore storage failures; dragging still works for the current session.
      }
    }

    function clampIconPosition(icon, x, y) {
      const maxX = Math.max(
        iconMargin,
        window.innerWidth - icon.offsetWidth - iconMargin,
      );
      const maxY = Math.max(
        iconMargin,
        window.innerHeight - icon.offsetHeight - taskbarReserve,
      );

      return {
        x: Math.min(Math.max(iconMargin, x), maxX),
        y: Math.min(Math.max(iconMargin, y), maxY),
      };
    }

    function setIconPosition(icon, x, y) {
      const next = clampIconPosition(icon, x, y);
      icon.style.position = "fixed";
      icon.style.left = next.x + "px";
      icon.style.top = next.y + "px";
      icon.style.right = "auto";
      icon.style.bottom = "auto";
      return next;
    }

    // Columns fit between equal side margins. Columns right of the center
    // column are anchored to the right edge, so spare width stays in the
    // middle and the link column sits against the right edge.
    function getGrid() {
      const icon = allIcons[0];
      const rightColumnX = window.innerWidth - icon.offsetWidth - gridOriginX;
      const maxY = window.innerHeight - icon.offsetHeight - taskbarReserve;
      const maxColumn = Math.max(
        0,
        Math.floor((rightColumnX - gridOriginX) / gridColumnStep),
      );

      return {
        maxColumn,
        maxRow: Math.max(0, Math.floor((maxY - gridOriginY) / gridRowStep)),
        centerColumn: Math.min(
          maxColumn,
          Math.max(minCenterColumn, Math.round(maxColumn / 2)),
        ),
        rightColumnX,
      };
    }

    function getCellKey(cell) {
      return cell.column + "," + cell.row;
    }

    function getColumnX(column, grid) {
      return column > grid.centerColumn
        ? grid.rightColumnX - (grid.maxColumn - column) * gridColumnStep
        : gridOriginX + column * gridColumnStep;
    }

    function getCellPosition(cell, grid) {
      return {
        x: getColumnX(cell.column, grid),
        y: gridOriginY + cell.row * gridRowStep,
      };
    }

    // Column spacing is uneven around the middle, so pick the nearest column.
    function getCellFromPosition(position, grid) {
      let column = 0;
      for (let next = 1; next <= grid.maxColumn; next++) {
        if (
          Math.abs(getColumnX(next, grid) - position.x) <
          Math.abs(getColumnX(column, grid) - position.x)
        ) {
          column = next;
        }
      }
      const row = Math.round((position.y - gridOriginY) / gridRowStep);

      return {
        column,
        row: Math.min(Math.max(0, row), grid.maxRow),
      };
    }

    function getGridIndex(
      value,
      maxIndex,
      fallback,
      centerIndex = Math.round(maxIndex / 2),
    ) {
      const centerMatch = String(value || "").match(/^center([+-]\d+)?$/);
      if (centerMatch) {
        const offset = Number.parseInt(centerMatch[1] || "0", 10);
        return Math.min(Math.max(0, centerIndex + offset), maxIndex);
      }
      if (value === "right" || value === "bottom") return maxIndex;

      const parsed = Number.parseInt(value, 10);
      if (Number.isFinite(parsed)) {
        return Math.min(Math.max(0, parsed), maxIndex);
      }

      return fallback;
    }

    function getUtilityPosition(icon, maxColumn, maxRow) {
      const index = Number.parseInt(icon.dataset.layoutIndex || "0", 10);
      const shortViewportPositions = [
        { column: maxColumn - 2, row: 0 },
        { column: maxColumn - 2, row: 1 },
        { column: maxColumn - 2, row: 2 },
        { column: maxColumn - 2, row: 3 },
        { column: maxColumn - 1, row: 0 },
        { column: maxColumn - 1, row: 1 },
        { column: maxColumn - 1, row: 2 },
      ];
      const position = shortViewportPositions[index] || {
        column: index,
        row: 0,
      };

      return {
        column: Math.min(Math.max(0, position.column), maxColumn),
        row: Math.min(Math.max(0, position.row), maxRow),
      };
    }

    function getDefaultCell(icon, grid) {
      const { maxColumn, maxRow } = grid;

      if (!icon.dataset.openApp) {
        // Links stack down the right edge and wrap into the column to its left.
        const index = getShortcutIndex(icon);
        return {
          column: Math.max(0, maxColumn - Math.floor(index / (maxRow + 1))),
          row: index % (maxRow + 1),
        };
      }

      let column = getGridIndex(
        icon.dataset.defaultCol,
        maxColumn,
        0,
        grid.centerColumn,
      );
      let row = getGridIndex(icon.dataset.defaultRow, maxRow, 0);

      if (icon.dataset.layoutGroup === "utility" && maxRow <= 6) {
        const utilityPosition = getUtilityPosition(icon, maxColumn, maxRow);
        column = utilityPosition.column;
        row = utilityPosition.row;
      } else if (icon.dataset.layoutGroup === "left-mid" && maxRow <= 6) {
        const offset = Number.parseInt(icon.dataset.layoutIndex || "0", 10);
        row = Math.max(2, maxRow - 2 + offset);
      }

      return { column, row };
    }

    // Nearest by grid steps, preferring the same column; the target cell
    // itself is returned when every cell is taken.
    function findNearestFreeCell(target, grid) {
      let nearest = target;
      let nearestDistance = Infinity;
      let nearestColumnDistance = Infinity;

      for (let row = 0; row <= grid.maxRow; row++) {
        for (let column = 0; column <= grid.maxColumn; column++) {
          if (occupiedCells.has(getCellKey({ column, row }))) continue;

          const columnDistance = Math.abs(column - target.column);
          const distance = columnDistance + Math.abs(row - target.row);
          if (
            distance < nearestDistance ||
            (distance === nearestDistance &&
              columnDistance < nearestColumnDistance)
          ) {
            nearest = { column, row };
            nearestDistance = distance;
            nearestColumnDistance = columnDistance;
          }
        }
      }

      return nearest;
    }

    function placeIcon(icon, target, grid) {
      const cell = occupiedCells.has(getCellKey(target))
        ? findNearestFreeCell(target, grid)
        : target;
      const position = getCellPosition(cell, grid);

      occupiedCells.set(getCellKey(cell), icon);
      iconCells.set(icon, cell);
      setIconPosition(icon, position.x, position.y);
      icon.dataset.desktopIconReady = "true";
    }

    function layoutDesktopIcons() {
      if (isMobileLauncherMode()) {
        allIcons.forEach(clearIconPosition);
        return;
      }
      if (!isDesktopShown()) return;

      const grid = getGrid();
      occupiedCells = new Map();
      iconCells = new Map();

      // Saved positions claim their cells first, then app defaults, then links.
      allIcons
        .filter((icon) => savedPositions.has(icon))
        .forEach((icon) =>
          placeIcon(
            icon,
            getCellFromPosition(savedPositions.get(icon), grid),
            grid,
          ),
        );
      allIcons
        .filter((icon) => !savedPositions.has(icon))
        .forEach((icon) => placeIcon(icon, getDefaultCell(icon, grid), grid));
    }

    // Snaps a dragged icon to the nearest cell. An icon already in that cell,
    // app or link, swaps into the dragged icon's previous cell.
    function dropIcon(icon, x, y) {
      const grid = getGrid();
      const cell = getCellFromPosition({ x, y }, grid);
      const occupiedIcon = occupiedCells.get(getCellKey(cell));
      const previousCell = iconCells.get(icon);
      const dropKeys = new Set([getCellKey(cell)]);
      if (previousCell) dropKeys.add(getCellKey(previousCell));

      // A saved icon displaced on this screen size would reclaim a cell of
      // this drop on the next layout; pin it where it is shown instead.
      savedPositions.forEach((position, other) => {
        if (other === icon || other === occupiedIcon) return;
        const shownCell = iconCells.get(other);
        const savedKey = getCellKey(getCellFromPosition(position, grid));
        if (
          shownCell &&
          dropKeys.has(savedKey) &&
          savedKey !== getCellKey(shownCell)
        ) {
          saveIconPosition(other, getCellPosition(shownCell, grid));
        }
      });

      if (occupiedIcon && occupiedIcon !== icon && previousCell) {
        saveIconPosition(occupiedIcon, getCellPosition(previousCell, grid));
      }
      saveIconPosition(icon, getCellPosition(cell, grid));
      layoutDesktopIcons();
    }

    window.__pepodevDesktopIconGrid = {
      move: setIconPosition,
      drop: dropIcon,
    };

    removeStaleIconPositions();
    allIcons.forEach((icon) => {
      const saved = loadIconPosition(icon);
      if (saved) savedPositions.set(icon, saved);
    });
    layoutDesktopIcons();

    document.querySelectorAll("[data-open-app]").forEach((trigger) => {
      if (trigger.dataset.launcherBound === "true") return;
      trigger.dataset.launcherBound = "true";

      const openApp = () => {
        document.dispatchEvent(
          new CustomEvent("desktop:open-app", {
            detail: { appId: trigger.dataset.openApp },
          }),
        );
      };

      if (trigger.classList.contains("desktop-icon")) {
        let pointerStartX = 0;
        let pointerStartY = 0;
        let iconStartX = 0;
        let iconStartY = 0;
        let isPointerDown = false;
        let isDragging = false;

        trigger.addEventListener("pointerdown", (event) => {
          if (isMobileLauncherMode()) return;
          if (event.button !== 0) return;

          const rect = trigger.getBoundingClientRect();
          pointerStartX = event.clientX;
          pointerStartY = event.clientY;
          iconStartX = rect.left;
          iconStartY = rect.top;
          isPointerDown = true;
          isDragging = false;
          trigger.style.zIndex = "30";
          trigger.setPointerCapture?.(event.pointerId);
        });

        trigger.addEventListener("pointermove", (event) => {
          if (isMobileLauncherMode()) return;
          if (!isPointerDown) return;

          const deltaX = event.clientX - pointerStartX;
          const deltaY = event.clientY - pointerStartY;
          if (!isDragging && Math.hypot(deltaX, deltaY) < 4) return;

          isDragging = true;
          trigger.classList.add("dragging");
          setIconPosition(trigger, iconStartX + deltaX, iconStartY + deltaY);
        });

        trigger.addEventListener("pointerup", (event) => {
          if (isMobileLauncherMode()) return;
          if (!isPointerDown) return;

          trigger.releasePointerCapture?.(event.pointerId);
          isPointerDown = false;
          trigger.style.zIndex = "5";

          if (isDragging) {
            const rect = trigger.getBoundingClientRect();
            dropIcon(trigger, rect.left, rect.top);
            trigger.classList.remove("dragging");
            isDragging = false;
            return;
          }

          openApp();
        });

        trigger.addEventListener("pointercancel", () => {
          isPointerDown = false;
          isDragging = false;
          trigger.style.zIndex = "5";
          trigger.classList.remove("dragging");
        });

        trigger.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openApp();
          }
        });

        // Pointer and key opens are handled above. A click with detail 0
        // comes from assistive tech (screen-reader activation), which
        // sends no pointer or key events.
        trigger.addEventListener("click", (event) => {
          if (!isMobileLauncherMode() && event.detail !== 0) return;
          event.preventDefault();
          openApp();
        });
      } else {
        trigger.addEventListener("click", openApp);
      }
    });

    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener("change", layoutDesktopIcons);
    } else {
      mobileQuery.addListener(layoutDesktopIcons);
    }

    window.addEventListener("resize", layoutDesktopIcons);
    document.addEventListener("site:mode-change", (event) => {
      if (event.detail?.mode === "desktop") layoutDesktopIcons();
    });
  });
</script>
