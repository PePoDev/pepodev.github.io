---
import type { SocialLink } from "@app-types/data";
import socialLinks from "@data/social-links.json";

const apps = [
  { id: "welcome", name: "Welcome", description: "Login & introduction" },
  { id: "blog", name: "Blog", description: "Read articles and posts" },
  { id: "garden", name: "Garden", description: "Browse digital garden notes" },
  { id: "project", name: "Projects", description: "Browse project showcase" },
  { id: "work", name: "Work", description: "Career timeline" },
  { id: "me", name: "About Me", description: "Learn more about me" },
  { id: "sregame", name: "SRE Game", description: "Play the chaos game" },
  { id: "snake", name: "Snake", description: "Play the classic grid game" },
  { id: "music", name: "Music", description: "Play ambient desktop music" },
  { id: "whitenoise", name: "Noise", description: "Play rainy white noise" },
  {
    id: "calculator",
    name: "Calculator",
    description: "Run quick calculations",
  },
  { id: "settings", name: "Settings", description: "Customize the desktop" },
  {
    id: "terminal",
    name: "Terminal",
    description: "Use the interactive shell",
  },
  { id: "certs", name: "Certs", description: "View certification wallet" },
  { id: "gallery", name: "Gallery", description: "Open protected pictures" },
  {
    id: "trash",
    name: "Trash",
    description: "Inspect deleted desktop nonsense",
  },
];

const commands = [
  {
    id: "reset-desktop",
    name: "Reset Desktop",
    description: "Clear all settings and state for a fresh start",
    icon: "🔄",
    // Destructive: the first Enter, click, or tap only asks for confirmation.
    confirm:
      "Press Enter or click Reset Desktop again to clear all settings and reload.",
    confirmTouch: "Tap Reset Desktop again to clear all settings and reload.",
  },
  {
    id: "toggle-theme",
    name: "Toggle Theme",
    description: "Switch between dark and light theme",
    icon: "🌓",
  },
  {
    id: "close-all-windows",
    name: "Close All Windows",
    description: "Close all open application windows",
    icon: "❌",
  },
];

const externalLinks = socialLinks.map((link) => ({
  id: `external-${link.icon}`,
  name: link.label.split(" - ")[0],
  description: `Open ${link.label}`,
  icon: "🔗",
  href: link.href,
}));
---

<div
  id="command-palette"
  class="command-palette"
  data-visible="false"
  role="dialog"
  aria-label="Command palette"
  aria-modal="true"
  inert
>
  <div class="command-palette-backdrop"></div>
  <div class="command-palette-container">
    <div class="command-palette-header">
      <svg class="search-icon" viewBox="0 0 20 20" fill="none">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
          d="M13.5 13.5L17 17"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      <input
        type="text"
        id="command-palette-input"
        class="command-palette-input"
        placeholder="Search apps and commands..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="command-palette-hint">ESC</kbd>
    </div>
    <div id="command-palette-results" class="command-palette-results">
      <div
        id="command-palette-matches"
        class="command-palette-matches"
        hidden
      ></div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">Commands</div>
        {
          commands.map((cmd, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="command"
              data-id={cmd.id}
              data-index={index}
              data-confirm={cmd.confirm}
              data-confirm-touch={cmd.confirmTouch}
            >
              <span class="command-palette-item-icon">{cmd.icon}</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{cmd.name}</div>
                <div class="command-palette-item-desc">{cmd.description}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">Apps</div>
        {
          apps.map((app, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="app"
              data-id={app.id}
              data-index={commands.length + index}
            >
              <span class="command-palette-item-icon">📦</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{app.name}</div>
                <div class="command-palette-item-desc">{app.description}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">External Links</div>
        {
          externalLinks.map((link, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="external"
              data-id={link.id}
              data-href={link.href}
              data-index={commands.length + apps.length + index}
            >
              <span class="command-palette-item-icon">{link.icon}</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{link.name}</div>
                <div class="command-palette-item-desc">{link.description}</div>
              </div>
            </button>
          ))
        }
      </div>
    </div>
    <p id="command-palette-status" class="command-palette-status" role="status"></p>
  </div>
</div>

<script>
  import {
    closeOverlay,
    getFocusedWindow,
    onOtherOverlayOpen,
    openOverlay,
  } from "@utils/overlays";
  import { rankMatch } from "@utils/search";

  function initCommandPalette() {
    const palette = document.getElementById("command-palette");
    const input = document.getElementById(
      "command-palette-input",
    ) as HTMLInputElement | null;
    const results = document.getElementById("command-palette-results");
    const backdrop = palette?.querySelector(".command-palette-backdrop");
    const status = document.getElementById("command-palette-status");
    const matchList = document.getElementById("command-palette-matches");
    const paletteButton = document.getElementById("taskbar-command-palette");

    if (!palette || !input || !results || !matchList) return;
    const dialog = palette;
    const searchInput = input;
    const resultList = results;
    const matches = matchList;

    function isDesktopSiteMode() {
      return document.documentElement.dataset.siteMode !== "website";
    }

    let selectedIndex = 0;
    let visibleItems: HTMLElement[] = [];
    // A destructive command waiting for its confirming Enter, click, or tap.
    let armedItem: HTMLElement | null = null;
    // The control that had focus before the palette opened.
    let returnFocusTo: HTMLElement | null = null;
    const coarsePointer = window.matchMedia("(pointer: coarse)");
    const sections = Array.from(
      resultList.querySelectorAll<HTMLElement>(".command-palette-section"),
    );
    // Every item with its section and the lowercase text search matches.
    const entries = Array.from(
      resultList.querySelectorAll<HTMLElement>(".command-palette-item"),
    ).map((item, order) => ({
      item,
      order,
      section: item.closest(".command-palette-section") as HTMLElement,
      name:
        item
          .querySelector(".command-palette-item-name")
          ?.textContent?.trim()
          .toLowerCase() || "",
      description:
        item
          .querySelector(".command-palette-item-desc")
          ?.textContent?.trim()
          .toLowerCase() || "",
    }));

    function isOpen() {
      return dialog.dataset.visible === "true";
    }

    function updateVisibleItems() {
      visibleItems = Array.from(
        resultList.querySelectorAll<HTMLElement>(
          '.command-palette-item:not([style*="display: none"])',
        ),
      );
    }

    function setStatus(message: string, tone = "") {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
    }

    function openPalette() {
      if (!isDesktopSiteMode() || isOpen()) return;
      // The Start menu and tray close first and hand focus back to their
      // buttons, so that is where closing the palette returns it.
      openOverlay("command-palette", dialog);
      const active = document.activeElement;
      returnFocusTo =
        active instanceof HTMLElement &&
        active !== document.body &&
        !dialog.contains(active)
          ? active
          : null;
      dialog.dataset.visible = "true";
      searchInput.value = "";
      filterItems("");
      selectedIndex = 0;
      updateSelection();
      setTimeout(() => searchInput.focus(), 10);
    }

    // Closed, the palette leaves the tab order and the accessibility tree.
    // restoreFocus hands focus back to whatever opened it, or, when that is
    // gone (Close All Windows), to the topmost window or the palette button.
    // Launching an app skips that: focus left on a control outside the new
    // window would keep app keys (Calculator, Snake) away from it.
    function closePalette({ restoreFocus = false } = {}) {
      if (!isOpen()) return;
      dialog.dataset.visible = "false";
      disarmItem();
      closeOverlay(dialog, {
        restoreFocus,
        returnTo: returnFocusTo
          ? [returnFocusTo, getFocusedWindow(), paletteButton]
          : [],
      });
      returnFocusTo = null;
    }

    document.addEventListener("desktop:open-command-palette", openPalette);
    document.addEventListener("site:mode-change", (event) => {
      if ((event as CustomEvent).detail?.mode === "website") closePalette();
    });
    onOtherOverlayOpen("command-palette", () => closePalette());

    // While searching, matches leave their sections for one flat list sorted
    // by rank (src/utils/search.ts), so "set" puts Settings above Reset
    // Desktop and "all" puts the Gallery app above Reset Desktop's
    // description. Moving the buttons keeps the visual, Tab, and arrow-key
    // order equal.
    function filterItems(query: string) {
      const lowerQuery = query.trim().toLowerCase();
      const searching = lowerQuery !== "";
      disarmItem();

      const ranked = entries
        .map((entry) => ({
          entry,
          rank: rankMatch(entry.name, entry.description, lowerQuery),
        }))
        .filter(({ rank }) => rank >= 0)
        .sort((a, b) => a.rank - b.rank || a.entry.order - b.entry.order);

      entries.forEach(({ item, section }) => {
        item.style.display = "none";
        section.append(item);
      });
      ranked.forEach(({ entry }) => {
        entry.item.style.display = "";
        if (searching) matches.append(entry.item);
      });
      matches.hidden = !searching || ranked.length === 0;
      sections.forEach((section) => {
        section.hidden = searching;
      });

      updateVisibleItems();
      setStatus(visibleItems.length ? "" : "No matching apps or commands");
      selectedIndex = 0;
      updateSelection();
    }

    function updateSelection() {
      visibleItems.forEach((item, index) => {
        item.classList.toggle("selected", index === selectedIndex);
      });

      if (armedItem && visibleItems[selectedIndex] !== armedItem) {
        disarmItem();
      }

      // Scroll selected item into view
      visibleItems[selectedIndex]?.scrollIntoView({
        block: "nearest",
        behavior: "smooth",
      });
    }

    // Selecting another item, typing, or closing the palette cancels it.
    function disarmItem() {
      if (!armedItem) return;
      armedItem.classList.remove("confirming");
      armedItem = null;
      setStatus("");
    }

    function armItem(item: HTMLElement) {
      armedItem = item;
      item.classList.add("confirming");
      const message =
        (coarsePointer.matches && item.dataset.confirmTouch) ||
        item.dataset.confirm ||
        "";
      setStatus(message, "warning");
    }

    function selectItem(item: HTMLElement) {
      const index = visibleItems.indexOf(item);
      if (index < 0 || index === selectedIndex) return;
      selectedIndex = index;
      updateSelection();
    }

    function moveSelection(delta: number) {
      const focusedItem = resultList.contains(document.activeElement);
      selectedIndex = Math.max(
        0,
        Math.min(selectedIndex + delta, visibleItems.length - 1),
      );
      updateSelection();
      // Keep keyboard focus on the highlighted item once Tab has moved it there.
      if (focusedItem) visibleItems[selectedIndex]?.focus();
    }

    function executeItem(item: HTMLElement) {
      const type = item.dataset.type;
      const id = item.dataset.id;

      if (type === "command") {
        if (item.dataset.confirm && armedItem !== item) {
          disarmItem();
          armItem(item);
          return;
        }
        if (id) executeCommand(id);
      } else if (type === "app") {
        document.dispatchEvent(
          new CustomEvent("desktop:open-app", { detail: { appId: id } }),
        );
        closePalette();
      } else if (type === "external") {
        const href = item.dataset.href;
        if (href) {
          window.open(href, "_blank", "noopener,noreferrer");
          closePalette({ restoreFocus: true });
        }
      }
    }

    function executeCommand(commandId: string) {
      if (commandId === "reset-desktop") {
        // Clear ALL desktop settings and state for a complete fresh start
        const keysToRemove: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          // Remove all pepodev-related keys
          if (key?.startsWith("pepodev.")) {
            keysToRemove.push(key);
          }
        }
        keysToRemove.forEach((key) => localStorage.removeItem(key));

        closePalette();

        // Reload the page to show default state
        setTimeout(() => window.location.reload(), 500);
      } else if (commandId === "toggle-theme") {
        // Settings owns the preferences and applies the switch.
        document.dispatchEvent(new CustomEvent("desktop:toggle-theme"));
        closePalette({ restoreFocus: true });
      } else if (commandId === "close-all-windows") {
        document.dispatchEvent(new CustomEvent("desktop:close-all-windows"));
        closePalette({ restoreFocus: true });
      }
    }

    // Keyboard shortcuts
    document.addEventListener("keydown", (e) => {
      if (!isDesktopSiteMode()) return;

      // Open palette: Ctrl+K or Cmd+K
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (isOpen()) {
          closePalette({ restoreFocus: true });
        } else {
          openPalette();
        }
        return;
      }

      // Only handle these keys when palette is open
      if (!isOpen()) return;

      // Close palette: Escape
      if (e.key === "Escape") {
        e.preventDefault();
        closePalette({ restoreFocus: true });
        return;
      }

      // The open palette is modal: Tab and Shift+Tab cycle through its input
      // and visible results.
      if (e.key === "Tab") {
        e.preventDefault();
        const stops = [searchInput, ...visibleItems];
        const at = stops.indexOf(document.activeElement as HTMLElement);
        const step = e.shiftKey ? -1 : 1;
        // From anywhere else, Tab starts at the input, Shift+Tab at the end.
        const from = at >= 0 ? at : e.shiftKey ? 0 : -1;
        stops[(from + step + stops.length) % stops.length].focus();
        return;
      }

      // Navigate: Arrow Down
      if (e.key === "ArrowDown") {
        e.preventDefault();
        moveSelection(1);
        return;
      }

      // Navigate: Arrow Up
      if (e.key === "ArrowUp") {
        e.preventDefault();
        moveSelection(-1);
        return;
      }

      // Execute: Enter
      if (e.key === "Enter") {
        // A focused item runs through its native button click instead.
        if (resultList.contains(document.activeElement) || e.isComposing)
          return;
        e.preventDefault();
        const item = visibleItems[selectedIndex];
        if (item) executeItem(item);
      }
    });

    // Search input
    searchInput.addEventListener("input", () => {
      filterItems(searchInput.value);
    });

    // Click on item (also Enter or Space on a focused item)
    resultList.addEventListener("click", (e) => {
      const item = (e.target as Element).closest<HTMLElement>(
        ".command-palette-item",
      );
      if (item) {
        selectItem(item);
        executeItem(item);
      }
    });

    // The highlight follows keyboard focus, so Enter and the highlight agree.
    resultList.addEventListener("focusin", (e) => {
      const item = (e.target as Element).closest<HTMLElement>(
        ".command-palette-item",
      );
      if (item) selectItem(item);
    });

    // Click on backdrop to close
    backdrop?.addEventListener("click", () => {
      closePalette({ restoreFocus: true });
    });

    // Initialize
    updateVisibleItems();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCommandPalette);
  } else {
    initCommandPalette();
  }
</script>

<style>
  .command-palette {
    position: fixed;
    inset: 0;
    z-index: 20000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .command-palette[data-visible="true"] {
    opacity: 1;
    pointer-events: all;
  }

  .command-palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  /* A column, so the results scroll and the status line under them always
     stays in view. */
  .command-palette-container {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 90%;
    max-width: 600px;
    max-height: calc(85vh - 24px);
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 12px;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(34, 197, 94, 0.1);
    overflow: hidden;
    transform: translateY(-20px);
    transition: transform 0.15s ease;
  }

  .command-palette[data-visible="true"] .command-palette-container {
    transform: translateY(0);
  }

  .command-palette-header {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .search-icon {
    width: 20px;
    height: 20px;
    color: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .command-palette-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 16px;
    font-family: inherit;
  }

  .command-palette-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .command-palette-hint {
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: monospace;
    font-weight: 600;
  }

  .command-palette-results {
    flex: 1 1 auto;
    min-height: 0;
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }

  .command-palette-results::-webkit-scrollbar {
    width: 8px;
  }

  .command-palette-results::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
  }

  .command-palette-results::-webkit-scrollbar-thumb {
    background: rgba(34, 197, 94, 0.3);
    border-radius: 4px;
  }

  .command-palette-results::-webkit-scrollbar-thumb:hover {
    background: rgba(34, 197, 94, 0.5);
  }

  .command-palette-section {
    margin-bottom: 12px;
  }

  .command-palette-section:last-child {
    margin-bottom: 0;
  }

  .command-palette-section-title {
    padding: 8px 12px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .command-palette-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #fff;
    text-align: left;
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .command-palette-item:hover,
  .command-palette-item.selected {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
  }

  .command-palette-item.confirming {
    background: color-mix(in srgb, var(--accent-red) 16%, transparent);
    border-color: color-mix(in srgb, var(--accent-red) 60%, transparent);
  }

  .command-palette-item-icon {
    font-size: 20px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .command-palette-item-content {
    flex: 1;
    min-width: 0;
  }

  .command-palette-item-name {
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 2px;
  }

  .command-palette-item-desc {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Always rendered, so screen readers announce new messages. */
  .command-palette-status {
    flex-shrink: 0;
    margin: 0;
    padding: 0 20px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 13px;
  }

  .command-palette-status:not(:empty) {
    padding: 12px 20px;
  }

  .command-palette-status[data-tone="warning"] {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--accent-amber);
  }

  @media (max-width: 768px) {
    .command-palette {
      align-items: flex-end;
      padding: 12px max(10px, env(safe-area-inset-right))
        calc(var(--mobile-taskbar-height, 56px) + 8px)
        max(10px, env(safe-area-inset-left));
    }

    .command-palette-container {
      width: 100%;
      max-width: none;
      max-height: calc(100dvh - var(--mobile-taskbar-height, 56px) - 24px);
      border-radius: 14px;
      transform: translateY(20px);
    }

    .command-palette-header {
      padding: 14px 16px;
    }

    .command-palette-input {
      min-height: 32px;
      font-size: 16px;
    }

    .command-palette-hint {
      display: none;
    }

    .command-palette-results {
      max-height: none;
    }

    .command-palette-item {
      min-height: 48px;
    }

    .command-palette-item-desc {
      white-space: normal;
    }
  }
</style>
