---
import socialLinks from "../../data/social-links.json";

const apps = [
  { id: "blog", name: "Blog", description: "Read articles and posts" },
  { id: "resume", name: "Resume", description: "View CV and experience" },
  { id: "project", name: "Projects", description: "Browse project showcase" },
  { id: "work", name: "Work", description: "Career timeline" },
  { id: "me", name: "About Me", description: "Learn more about me" },
  { id: "sregame", name: "SRE Game", description: "Play the chaos game" },
  { id: "arcade", name: "Arcade", description: "Play reliability mini apps" },
  { id: "music", name: "Music", description: "Play ambient desktop music" },
  {
    id: "calculator",
    name: "Calculator",
    description: "Run quick calculations",
  },
  { id: "settings", name: "Settings", description: "Customize the desktop" },
  {
    id: "terminal",
    name: "Terminal",
    description: "Use the interactive shell",
  },
  {
    id: "incidents",
    name: "Incidents",
    description: "Review incident response",
  },
  { id: "metrics", name: "Metrics", description: "Open service metrics" },
  {
    id: "architecture",
    name: "Architecture",
    description: "Inspect platform architecture",
  },
  {
    id: "runbook",
    name: "Runbook",
    description: "Search operational runbooks",
  },
  { id: "certs", name: "Certs", description: "View certification wallet" },
  {
    id: "deploysim",
    name: "Deploy Sim",
    description: "Run a CI/CD simulation",
  },
  { id: "monitor", name: "Monitor", description: "Watch live system signals" },
  { id: "gallery", name: "Gallery", description: "Open protected pictures" },
  {
    id: "trash",
    name: "Trash",
    description: "Inspect deleted desktop nonsense",
  },
];

const commands = [
  {
    id: "reset-desktop",
    name: "Reset Desktop",
    description: "Clear all settings and state for a fresh start",
    icon: "🔄",
  },
  {
    id: "toggle-theme",
    name: "Toggle Theme",
    description: "Switch between dark and light theme",
    icon: "🌓",
  },
  {
    id: "close-all-windows",
    name: "Close All Windows",
    description: "Close all open application windows",
    icon: "❌",
  },
];

const externalLinks = socialLinks.map((link) => ({
  id: `external-${link.icon}`,
  name: link.label.split(" - ")[0],
  description: `Open ${link.label}`,
  icon: "🔗",
  href: link.href,
}));
---

<div id="command-palette" class="command-palette" data-visible="false">
  <div class="command-palette-backdrop"></div>
  <div class="command-palette-container">
    <div class="command-palette-header">
      <svg class="search-icon" viewBox="0 0 20 20" fill="none">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
          d="M13.5 13.5L17 17"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      <input
        type="text"
        id="command-palette-input"
        class="command-palette-input"
        placeholder="Search apps and commands..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="command-palette-hint">ESC</kbd>
    </div>
    <div id="command-palette-results" class="command-palette-results">
      <div class="command-palette-section">
        <div class="command-palette-section-title">Commands</div>
        {
          commands.map((cmd, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="command"
              data-id={cmd.id}
              data-index={index}
            >
              <span class="command-palette-item-icon">{cmd.icon}</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{cmd.name}</div>
                <div class="command-palette-item-desc">{cmd.description}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">Apps</div>
        {
          apps.map((app, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="app"
              data-id={app.id}
              data-index={commands.length + index}
            >
              <span class="command-palette-item-icon">📦</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{app.name}</div>
                <div class="command-palette-item-desc">{app.description}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">External Links</div>
        {
          externalLinks.map((link, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="external"
              data-id={link.id}
              data-href={link.href}
              data-index={commands.length + apps.length + index}
            >
              <span class="command-palette-item-icon">{link.icon}</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{link.name}</div>
                <div class="command-palette-item-desc">{link.description}</div>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const palette = document.getElementById("command-palette");
    const input = document.getElementById("command-palette-input");
    const results = document.getElementById("command-palette-results");
    const backdrop = palette?.querySelector(".command-palette-backdrop");

    if (!palette || !input || !results) return;

    let selectedIndex = 0;
    let visibleItems = [];

    function updateVisibleItems() {
      visibleItems = Array.from(
        results.querySelectorAll(
          '.command-palette-item:not([style*="display: none"])',
        ),
      );
    }

    function openPalette() {
      palette.dataset.visible = "true";
      input.value = "";
      filterItems("");
      selectedIndex = 0;
      updateSelection();
      setTimeout(() => input.focus(), 10);
    }

    function closePalette() {
      palette.dataset.visible = "false";
      input.blur();
    }

    function filterItems(query) {
      const lowerQuery = query.toLowerCase();
      const allItems = results.querySelectorAll(".command-palette-item");
      const sections = results.querySelectorAll(".command-palette-section");

      sections.forEach((section) => {
        const items = section.querySelectorAll(".command-palette-item");
        let hasVisibleItems = false;

        items.forEach((item) => {
          const name =
            item
              .querySelector(".command-palette-item-name")
              ?.textContent?.toLowerCase() || "";
          const desc =
            item
              .querySelector(".command-palette-item-desc")
              ?.textContent?.toLowerCase() || "";
          const matches =
            name.includes(lowerQuery) || desc.includes(lowerQuery);

          item.style.display = matches ? "" : "none";
          if (matches) hasVisibleItems = true;
        });

        section.style.display = hasVisibleItems ? "" : "none";
      });

      updateVisibleItems();
      selectedIndex = 0;
      updateSelection();
    }

    function updateSelection() {
      visibleItems.forEach((item, index) => {
        item.classList.toggle("selected", index === selectedIndex);
      });

      // Scroll selected item into view
      if (visibleItems[selectedIndex]) {
        visibleItems[selectedIndex].scrollIntoView({
          block: "nearest",
          behavior: "smooth",
        });
      }
    }

    function executeItem(item) {
      const type = item.dataset.type;
      const id = item.dataset.id;

      if (type === "command") {
        executeCommand(id);
      } else if (type === "app") {
        document.dispatchEvent(
          new CustomEvent("desktop:open-app", { detail: { appId: id } }),
        );
        closePalette();
      } else if (type === "external") {
        const href = item.dataset.href;
        if (href) {
          window.open(href, "_blank", "noopener,noreferrer");
          closePalette();
        }
      }
    }

    function executeCommand(commandId) {
      if (commandId === "reset-desktop") {
        // Clear ALL desktop settings and state for a complete fresh start
        const keysToRemove = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          // Remove all pepodev-related keys
          if (key?.startsWith("pepodev.")) {
            keysToRemove.push(key);
          }
        }
        keysToRemove.forEach((key) => localStorage.removeItem(key));

        closePalette();

        // Reload the page to show default state
        setTimeout(() => window.location.reload(), 500);
      } else if (commandId === "toggle-theme") {
        // Toggle theme using the same logic as Settings app
        const prefsKey = "pepodev.desktopPrefs";
        const defaults = {
          theme: localStorage.getItem("pepodev.theme") || "dark",
          background: "network",
          accent: "green",
          radius: 12,
          glass: 72,
        };

        let prefs = { ...defaults };
        try {
          const raw = localStorage.getItem(prefsKey);
          if (raw) prefs = { ...defaults, ...JSON.parse(raw) };
        } catch {
          // Ignore corrupt settings
        }

        // Toggle the theme
        prefs.theme = prefs.theme === "dark" ? "light" : "dark";

        // Apply preferences with proper CSS variables
        const accentMap = {
          green: { primary: "#30d158", secondary: "#64d2ff" },
          cyan: { primary: "#64d2ff", secondary: "#30d158" },
          purple: { primary: "#bf5af2", secondary: "#64d2ff" },
          amber: { primary: "#ff9f0a", secondary: "#64d2ff" },
        };
        const backgroundMap = {
          network: {
            bg: "#0a0e17",
            primary: "34, 197, 94",
            secondary: "6, 182, 212",
          },
          aurora: {
            bg: "#07111f",
            primary: "20, 184, 166",
            secondary: "168, 85, 247",
          },
          midnight: {
            bg: "#101018",
            primary: "99, 102, 241",
            secondary: "14, 165, 233",
          },
          ember: {
            bg: "#170d0a",
            primary: "245, 158, 11",
            secondary: "239, 68, 68",
          },
          ocean: {
            bg: "#0a1420",
            primary: "0, 191, 255",
            secondary: "64, 224, 208",
          },
          glacier: {
            bg: "#0f1419",
            primary: "176, 224, 230",
            secondary: "127, 255, 212",
          },
          void: {
            bg: "#0d0d0f",
            primary: "147, 112, 219",
            secondary: "100, 149, 237",
          },
          neon: {
            bg: "#1a0b2e",
            primary: "255, 20, 147",
            secondary: "0, 255, 255",
          },
          plasma: {
            bg: "#0e0520",
            primary: "138, 43, 226",
            secondary: "30, 144, 255",
          },
          storm: {
            bg: "#1c1c24",
            primary: "224, 255, 255",
            secondary: "70, 130, 180",
          },
          matrix: {
            bg: "#0d0208",
            primary: "0, 255, 65",
            secondary: "50, 205, 50",
          },
          sakura: {
            bg: "#1a0f1f",
            primary: "255, 183, 197",
            secondary: "221, 160, 221",
          },
          forest: {
            bg: "#0a1409",
            primary: "34, 139, 34",
            secondary: "124, 252, 0",
          },
          sunset: {
            bg: "#1f1108",
            primary: "255, 140, 0",
            secondary: "255, 105, 180",
          },
          copper: {
            bg: "#18100d",
            primary: "184, 115, 51",
            secondary: "205, 127, 50",
          },
        };

        const root = document.documentElement;
        const accent = accentMap[prefs.accent] || accentMap.green;
        const background =
          backgroundMap[prefs.background] || backgroundMap.network;

        root.setAttribute("data-theme", prefs.theme);
        root.style.setProperty("--accent-primary", accent.primary);
        root.style.setProperty("--accent-secondary", accent.secondary);
        // Also update the main accent variables for backward compatibility
        root.style.setProperty("--accent-green", accent.primary);
        root.style.setProperty("--accent-cyan", accent.secondary);
        root.style.setProperty("--window-radius", `${prefs.radius}px`);
        root.style.setProperty(
          "--glass-bg",
          `rgba(${prefs.theme === "light" ? "255, 255, 255" : "44, 44, 46"}, ${prefs.glass / 100})`,
        );
        root.style.setProperty("--desktop-bg-color", background.bg);
        root.style.setProperty("--particle-primary-rgb", background.primary);
        root.style.setProperty(
          "--particle-secondary-rgb",
          background.secondary,
        );

        localStorage.setItem("pepodev.theme", prefs.theme);
        localStorage.setItem(prefsKey, JSON.stringify(prefs));

        document.dispatchEvent(
          new CustomEvent("desktop:preferences", { detail: prefs }),
        );

        closePalette();
      } else if (commandId === "close-all-windows") {
        // Close all open windows
        document.dispatchEvent(new CustomEvent("desktop:close-all-windows"));
        closePalette();
      }
    }

    // Keyboard shortcuts
    document.addEventListener("keydown", (e) => {
      // Open palette: Ctrl+K or Cmd+K
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (palette.dataset.visible === "true") {
          closePalette();
        } else {
          openPalette();
        }
        return;
      }

      // Only handle these keys when palette is open
      if (palette.dataset.visible !== "true") return;

      // Close palette: Escape
      if (e.key === "Escape") {
        e.preventDefault();
        closePalette();
        return;
      }

      // Navigate: Arrow Down
      if (e.key === "ArrowDown") {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, visibleItems.length - 1);
        updateSelection();
        return;
      }

      // Navigate: Arrow Up
      if (e.key === "ArrowUp") {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection();
        return;
      }

      // Execute: Enter
      if (e.key === "Enter") {
        e.preventDefault();
        if (visibleItems[selectedIndex]) {
          executeItem(visibleItems[selectedIndex]);
        }
        return;
      }
    });

    // Search input
    input?.addEventListener("input", (e) => {
      filterItems(e.target.value);
    });

    // Click on item
    results?.addEventListener("click", (e) => {
      const item = e.target.closest(".command-palette-item");
      if (item) {
        executeItem(item);
      }
    });

    // Click on backdrop to close
    backdrop?.addEventListener("click", () => {
      closePalette();
    });

    // Initialize
    updateVisibleItems();
  });
</script>

<style>
  .command-palette {
    position: fixed;
    inset: 0;
    z-index: 20000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .command-palette[data-visible="true"] {
    opacity: 1;
    pointer-events: all;
  }

  .command-palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .command-palette-container {
    position: relative;
    width: 90%;
    max-width: 600px;
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 12px;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(34, 197, 94, 0.1);
    overflow: hidden;
    transform: translateY(-20px);
    transition: transform 0.15s ease;
  }

  .command-palette[data-visible="true"] .command-palette-container {
    transform: translateY(0);
  }

  .command-palette-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .search-icon {
    width: 20px;
    height: 20px;
    color: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .command-palette-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 16px;
    font-family: inherit;
  }

  .command-palette-input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .command-palette-hint {
    padding: 4px 8px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: monospace;
    font-weight: 600;
  }

  .command-palette-results {
    max-height: 400px;
    overflow-y: auto;
    padding: 8px;
  }

  .command-palette-results::-webkit-scrollbar {
    width: 8px;
  }

  .command-palette-results::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
  }

  .command-palette-results::-webkit-scrollbar-thumb {
    background: rgba(34, 197, 94, 0.3);
    border-radius: 4px;
  }

  .command-palette-results::-webkit-scrollbar-thumb:hover {
    background: rgba(34, 197, 94, 0.5);
  }

  .command-palette-section {
    margin-bottom: 12px;
  }

  .command-palette-section:last-child {
    margin-bottom: 0;
  }

  .command-palette-section-title {
    padding: 8px 12px;
    color: rgba(255, 255, 255, 0.5);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .command-palette-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    color: #fff;
    text-align: left;
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .command-palette-item:hover,
  .command-palette-item.selected {
    background: rgba(34, 197, 94, 0.15);
    border-color: rgba(34, 197, 94, 0.3);
  }

  .command-palette-item-icon {
    font-size: 20px;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .command-palette-item-content {
    flex: 1;
    min-width: 0;
  }

  .command-palette-item-name {
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    margin-bottom: 2px;
  }

  .command-palette-item-desc {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
