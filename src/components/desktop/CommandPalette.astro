---
import type { SocialLink } from "@app-types/data";
import socialLinks from "@data/social-links.json";

const apps = [
  { id: "welcome", name: "Welcome", description: "Login & introduction" },
  { id: "blog", name: "Blog", description: "Read articles and posts" },
  { id: "project", name: "Projects", description: "Browse project showcase" },
  { id: "work", name: "Work", description: "Career timeline" },
  { id: "me", name: "About Me", description: "Learn more about me" },
  { id: "sregame", name: "SRE Game", description: "Play the chaos game" },
  { id: "snake", name: "Snake", description: "Play the classic grid game" },
  { id: "music", name: "Music", description: "Play ambient desktop music" },
  { id: "whitenoise", name: "Noise", description: "Play rainy white noise" },
  {
    id: "calculator",
    name: "Calculator",
    description: "Run quick calculations",
  },
  { id: "settings", name: "Settings", description: "Customize the desktop" },
  {
    id: "terminal",
    name: "Terminal",
    description: "Use the interactive shell",
  },
  { id: "certs", name: "Certs", description: "View certification wallet" },
  { id: "gallery", name: "Gallery", description: "Open protected pictures" },
  {
    id: "trash",
    name: "Trash",
    description: "Inspect deleted desktop nonsense",
  },
];

const commands = [
  {
    id: "reset-desktop",
    name: "Reset Desktop",
    description: "Clear all settings and state for a fresh start",
    icon: "🔄",
    // Destructive: the first Enter, click, or tap only asks for confirmation.
    confirm:
      "Press Enter or click Reset Desktop again to clear all settings and reload.",
    confirmTouch: "Tap Reset Desktop again to clear all settings and reload.",
  },
  {
    id: "toggle-theme",
    name: "Toggle Theme",
    description: "Switch between dark and light theme",
    icon: "🌓",
  },
  {
    id: "close-all-windows",
    name: "Close All Windows",
    description: "Close all open application windows",
    icon: "❌",
  },
];

const externalLinks = socialLinks.map((link) => ({
  id: `external-${link.icon}`,
  name: link.label.split(" - ")[0],
  description: `Open ${link.label}`,
  icon: "🔗",
  href: link.href,
}));
---

<div
  id="command-palette"
  class="command-palette"
  data-visible="false"
  role="dialog"
  aria-label="Command palette"
  aria-modal="true"
  inert
>
  <div class="command-palette-backdrop"></div>
  <div class="command-palette-container">
    <div class="command-palette-header">
      <svg class="search-icon" viewBox="0 0 20 20" fill="none">
        <circle cx="9" cy="9" r="6" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
          d="M13.5 13.5L17 17"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
      <input
        type="text"
        id="command-palette-input"
        class="command-palette-input"
        placeholder="Search apps and commands..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="command-palette-hint">ESC</kbd>
    </div>
    <div id="command-palette-results" class="command-palette-results">
      <div
        id="command-palette-matches"
        class="command-palette-matches"
        hidden
      ></div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">Commands</div>
        {
          commands.map((cmd, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="command"
              data-id={cmd.id}
              data-index={index}
              data-confirm={cmd.confirm}
              data-confirm-touch={cmd.confirmTouch}
            >
              <span class="command-palette-item-icon">{cmd.icon}</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{cmd.name}</div>
                <div class="command-palette-item-desc">{cmd.description}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">Apps</div>
        {
          apps.map((app, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="app"
              data-id={app.id}
              data-index={commands.length + index}
            >
              <span class="command-palette-item-icon">📦</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{app.name}</div>
                <div class="command-palette-item-desc">{app.description}</div>
              </div>
            </button>
          ))
        }
      </div>
      <div class="command-palette-section">
        <div class="command-palette-section-title">External Links</div>
        {
          externalLinks.map((link, index) => (
            <button
              type="button"
              class="command-palette-item"
              data-type="external"
              data-id={link.id}
              data-href={link.href}
              data-index={commands.length + apps.length + index}
            >
              <span class="command-palette-item-icon">{link.icon}</span>
              <div class="command-palette-item-content">
                <div class="command-palette-item-name">{link.name}</div>
                <div class="command-palette-item-desc">{link.description}</div>
              </div>
            </button>
          ))
        }
      </div>
    </div>
    <p id="command-palette-status" class="command-palette-status" role="status"></p>
  </div>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const palette = document.getElementById("command-palette");
    const input = document.getElementById("command-palette-input");
    const results = document.getElementById("command-palette-results");
    const backdrop = palette?.querySelector(".command-palette-backdrop");
    const status = document.getElementById("command-palette-status");
    const matchList = document.getElementById("command-palette-matches");

    if (!palette || !input || !results || !matchList) return;

    function isDesktopSiteMode() {
      return document.documentElement.dataset.siteMode !== "website";
    }

    let selectedIndex = 0;
    let visibleItems = [];
    // A destructive command waiting for its confirming Enter, click, or tap.
    let armedItem = null;
    // The control that had focus before the palette opened.
    let returnFocusTo = null;
    const coarsePointer = window.matchMedia("(pointer: coarse)");
    const sections = Array.from(
      results.querySelectorAll(".command-palette-section"),
    );
    // Every item with its section and the lowercase text search matches.
    const entries = Array.from(
      results.querySelectorAll(".command-palette-item"),
    ).map((item, order) => ({
      item,
      order,
      section: item.closest(".command-palette-section"),
      name:
        item
          .querySelector(".command-palette-item-name")
          ?.textContent?.trim()
          .toLowerCase() || "",
      description:
        item
          .querySelector(".command-palette-item-desc")
          ?.textContent?.trim()
          .toLowerCase() || "",
    }));

    function updateVisibleItems() {
      visibleItems = Array.from(
        results.querySelectorAll(
          '.command-palette-item:not([style*="display: none"])',
        ),
      );
    }

    function setStatus(message, tone = "") {
      if (!status) return;
      status.textContent = message;
      status.dataset.tone = tone;
    }

    // A window that is closing stays on screen for its exit animation, so it
    // counts as gone too.
    function canTakeFocus(element) {
      return (
        element instanceof HTMLElement &&
        element !== document.body &&
        element.isConnected &&
        !element.closest("[inert], [hidden], .closing") &&
        element.getClientRects().length > 0
      );
    }

    function openPalette() {
      if (!isDesktopSiteMode()) return;
      // The Start menu and tray close first and hand focus back to their
      // buttons, so that is where closing the palette returns it.
      document.dispatchEvent(new CustomEvent("desktop:command-palette-open"));
      const active = document.activeElement;
      returnFocusTo =
        active instanceof HTMLElement && !palette.contains(active)
          ? active
          : null;
      palette.inert = false;
      palette.dataset.visible = "true";
      input.value = "";
      filterItems("");
      selectedIndex = 0;
      updateSelection();
      setTimeout(() => input.focus(), 10);
    }

    // Closed, the palette leaves the tab order and the accessibility tree.
    // restoreFocus hands focus back to whatever opened it. Launching an app
    // skips that: focus left on a control outside the new window would keep
    // app keys (Calculator, Snake) away from it.
    function closePalette({ restoreFocus = false } = {}) {
      if (palette.dataset.visible !== "true") return;
      const active = document.activeElement;
      const hadFocus = palette.contains(active) || active === document.body;
      palette.dataset.visible = "false";
      disarmItem();
      if (palette.contains(active)) active.blur();
      palette.inert = true;
      if (restoreFocus && hadFocus && canTakeFocus(returnFocusTo)) {
        returnFocusTo.focus({ preventScroll: true });
      }
      returnFocusTo = null;
    }

    document.addEventListener("desktop:open-command-palette", openPalette);
    document.addEventListener("site:mode-change", (event) => {
      if (event.detail?.mode === "website") closePalette();
    });

    // Whether the query starts the text or one of its words.
    function startsWord(text, query) {
      for (
        let at = text.indexOf(query);
        at >= 0;
        at = text.indexOf(query, at + 1)
      ) {
        if (at === 0 || !/[\p{L}\p{N}]/u.test(text[at - 1])) return true;
      }
      return false;
    }

    // 0 when the query starts the name or a word in it, 1 for the rest of the
    // name, 2 for the description, -1 for no match. filterApps in
    // StartMenu.astro ranks the same way.
    function getMatchRank(name, description, query) {
      if (startsWord(name, query)) return 0;
      if (name.includes(query)) return 1;
      return description.includes(query) ? 2 : -1;
    }

    // While searching, matches leave their sections for one flat list sorted
    // by rank, so "set" puts Settings above Reset Desktop and "all" puts the
    // Gallery app above Reset Desktop's description. Moving the buttons keeps
    // the visual, Tab, and arrow-key order equal.
    function filterItems(query) {
      const lowerQuery = query.trim().toLowerCase();
      const searching = lowerQuery !== "";
      disarmItem();

      const matches = entries
        .map((entry) => ({
          entry,
          rank: getMatchRank(entry.name, entry.description, lowerQuery),
        }))
        .filter(({ rank }) => rank >= 0)
        .sort((a, b) => a.rank - b.rank || a.entry.order - b.entry.order);

      entries.forEach(({ item, section }) => {
        item.style.display = "none";
        section.append(item);
      });
      matches.forEach(({ entry }) => {
        entry.item.style.display = "";
        if (searching) matchList.append(entry.item);
      });
      matchList.hidden = !searching || matches.length === 0;
      sections.forEach((section) => {
        section.hidden = searching;
      });

      updateVisibleItems();
      setStatus(visibleItems.length ? "" : "No matching apps or commands");
      selectedIndex = 0;
      updateSelection();
    }

    function updateSelection() {
      visibleItems.forEach((item, index) => {
        item.classList.toggle("selected", index === selectedIndex);
      });

      if (armedItem && visibleItems[selectedIndex] !== armedItem) {
        disarmItem();
      }

      // Scroll selected item into view
      if (visibleItems[selectedIndex]) {
        visibleItems[selectedIndex].scrollIntoView({
          block: "nearest",
          behavior: "smooth",
        });
      }
    }

    // Selecting another item, typing, or closing the palette cancels it.
    function disarmItem() {
      if (!armedItem) return;
      armedItem.classList.remove("confirming");
      armedItem = null;
      setStatus("");
    }

    function armItem(item) {
      armedItem = item;
      item.classList.add("confirming");
      const message =
        (coarsePointer.matches && item.dataset.confirmTouch) ||
        item.dataset.confirm;
      setStatus(message, "warning");
    }

    function selectItem(item) {
      const index = visibleItems.indexOf(item);
      if (index < 0 || index === selectedIndex) return;
      selectedIndex = index;
      updateSelection();
    }

    function moveSelection(delta) {
      const focusedItem = results.contains(document.activeElement);
      selectedIndex = Math.max(
        0,
        Math.min(selectedIndex + delta, visibleItems.length - 1),
      );
      updateSelection();
      // Keep keyboard focus on the highlighted item once Tab has moved it there.
      if (focusedItem) visibleItems[selectedIndex]?.focus();
    }

    function executeItem(item) {
      const type = item.dataset.type;
      const id = item.dataset.id;

      if (type === "command") {
        if (item.dataset.confirm && armedItem !== item) {
          disarmItem();
          armItem(item);
          return;
        }
        executeCommand(id);
      } else if (type === "app") {
        document.dispatchEvent(
          new CustomEvent("desktop:open-app", { detail: { appId: id } }),
        );
        closePalette();
      } else if (type === "external") {
        const href = item.dataset.href;
        if (href) {
          window.open(href, "_blank", "noopener,noreferrer");
          closePalette({ restoreFocus: true });
        }
      }
    }

    function executeCommand(commandId) {
      if (commandId === "reset-desktop") {
        // Clear ALL desktop settings and state for a complete fresh start
        const keysToRemove = [];
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          // Remove all pepodev-related keys
          if (key?.startsWith("pepodev.")) {
            keysToRemove.push(key);
          }
        }
        keysToRemove.forEach((key) => localStorage.removeItem(key));

        closePalette();

        // Reload the page to show default state
        setTimeout(() => window.location.reload(), 500);
      } else if (commandId === "toggle-theme") {
        // Toggle theme using the same logic as Settings app
        const prefsKey = "pepodev.desktopPrefs";
        const defaults = {
          theme: localStorage.getItem("pepodev.theme") || "dark",
          background: "network",
          accent: "green",
          radius: 12,
          glass: 72,
          backgroundEffect: true,
          windowGlass: true,
        };

        let prefs = { ...defaults };
        try {
          const raw = localStorage.getItem(prefsKey);
          if (raw) prefs = { ...defaults, ...JSON.parse(raw) };
        } catch {
          // Ignore corrupt settings
        }

        // Toggle the theme
        const oldTheme = prefs.theme;
        prefs.theme = prefs.theme === "dark" ? "light" : "dark";

        // Switch to appropriate default background when theme changes
        if (oldTheme !== prefs.theme) {
          prefs.background = prefs.theme === "light" ? "cloud" : "network";
        }

        // Apply preferences with proper CSS variables
        const accentMap = {
          green: { primary: "#30d158", secondary: "#64d2ff" },
          cyan: { primary: "#64d2ff", secondary: "#30d158" },
          purple: { primary: "#bf5af2", secondary: "#64d2ff" },
          amber: { primary: "#ff9f0a", secondary: "#64d2ff" },
        };
        const backgroundMap = {
          network: {
            bg: "#0a0e17",
            primary: "34, 197, 94",
            secondary: "6, 182, 212",
          },
          aurora: {
            bg: "#07111f",
            primary: "20, 184, 166",
            secondary: "168, 85, 247",
          },
          midnight: {
            bg: "#101018",
            primary: "99, 102, 241",
            secondary: "14, 165, 233",
          },
          ember: {
            bg: "#170d0a",
            primary: "245, 158, 11",
            secondary: "239, 68, 68",
          },
          ocean: {
            bg: "#0a1420",
            primary: "0, 191, 255",
            secondary: "64, 224, 208",
          },
          glacier: {
            bg: "#0f1419",
            primary: "176, 224, 230",
            secondary: "127, 255, 212",
          },
          void: {
            bg: "#0d0d0f",
            primary: "147, 112, 219",
            secondary: "100, 149, 237",
          },
          neon: {
            bg: "#1a0b2e",
            primary: "255, 20, 147",
            secondary: "0, 255, 255",
          },
          plasma: {
            bg: "#0e0520",
            primary: "138, 43, 226",
            secondary: "30, 144, 255",
          },
          storm: {
            bg: "#1c1c24",
            primary: "224, 255, 255",
            secondary: "70, 130, 180",
          },
          matrix: {
            bg: "#0d0208",
            primary: "0, 255, 65",
            secondary: "50, 205, 50",
          },
          sakura: {
            bg: "#1a0f1f",
            primary: "255, 183, 197",
            secondary: "221, 160, 221",
          },
          forest: {
            bg: "#0a1409",
            primary: "34, 139, 34",
            secondary: "124, 252, 0",
          },
          sunset: {
            bg: "#1f1108",
            primary: "255, 140, 0",
            secondary: "255, 105, 180",
          },
          copper: {
            bg: "#18100d",
            primary: "184, 115, 51",
            secondary: "205, 127, 50",
          },
          // Light theme backgrounds
          cloud: {
            bg: "#f0f4f8",
            primary: "100, 149, 237",
            secondary: "135, 206, 235",
          },
          daylight: {
            bg: "#fef9e7",
            primary: "255, 193, 7",
            secondary: "255, 152, 0",
          },
          mint: {
            bg: "#f0fdf4",
            primary: "52, 211, 153",
            secondary: "16, 185, 129",
          },
          peach: {
            bg: "#fff5f0",
            primary: "255, 159, 64",
            secondary: "255, 127, 80",
          },
          sky: {
            bg: "#e0f2fe",
            primary: "14, 165, 233",
            secondary: "56, 189, 248",
          },
          lavender: {
            bg: "#f5f3ff",
            primary: "167, 139, 250",
            secondary: "196, 181, 253",
          },
          cream: {
            bg: "#fefce8",
            primary: "234, 179, 8",
            secondary: "250, 204, 21",
          },
          rose: {
            bg: "#fff1f2",
            primary: "251, 113, 133",
            secondary: "244, 63, 94",
          },
          sage: {
            bg: "#f0fdf4",
            primary: "74, 222, 128",
            secondary: "134, 239, 172",
          },
          coral: {
            bg: "#fff7ed",
            primary: "251, 146, 60",
            secondary: "249, 115, 22",
          },
          powder: {
            bg: "#ecfeff",
            primary: "6, 182, 212",
            secondary: "34, 211, 238",
          },
          lemon: {
            bg: "#fefce8",
            primary: "250, 204, 21",
            secondary: "253, 224, 71",
          },
          blush: {
            bg: "#fce7f3",
            primary: "236, 72, 153",
            secondary: "244, 114, 182",
          },
          seafoam: {
            bg: "#ecfdf5",
            primary: "16, 185, 129",
            secondary: "52, 211, 153",
          },
          sand: {
            bg: "#fef3c7",
            primary: "217, 119, 6",
            secondary: "245, 158, 11",
          },
        };

        const root = document.documentElement;
        const accent = accentMap[prefs.accent] || accentMap.green;
        const background =
          backgroundMap[prefs.background] || backgroundMap.network;

        root.setAttribute("data-theme", prefs.theme);
        root.style.setProperty("--accent-primary", accent.primary);
        root.style.setProperty("--accent-secondary", accent.secondary);
        // Also update the main accent variables for backward compatibility
        root.style.setProperty("--accent-green", accent.primary);
        root.style.setProperty("--accent-cyan", accent.secondary);
        root.style.setProperty("--window-radius", `${prefs.radius}px`);
        root.style.setProperty(
          "--glass-bg",
          `rgba(${prefs.theme === "light" ? "255, 255, 255" : "44, 44, 46"}, ${prefs.glass / 100})`,
        );
        root.style.setProperty("--desktop-bg-color", background.bg);
        root.style.setProperty("--particle-primary-rgb", background.primary);
        root.style.setProperty(
          "--particle-secondary-rgb",
          background.secondary,
        );
        root.setAttribute(
          "data-background-effect",
          prefs.backgroundEffect ? "on" : "off",
        );
        root.setAttribute(
          "data-window-glass",
          prefs.windowGlass ? "on" : "off",
        );

        localStorage.setItem("pepodev.theme", prefs.theme);
        localStorage.setItem(prefsKey, JSON.stringify(prefs));

        document.dispatchEvent(
          new CustomEvent("desktop:preferences", { detail: prefs }),
        );

        closePalette({ restoreFocus: true });
      } else if (commandId === "close-all-windows") {
        // Close all open windows
        document.dispatchEvent(new CustomEvent("desktop:close-all-windows"));
        closePalette({ restoreFocus: true });
      }
    }

    // Keyboard shortcuts
    document.addEventListener("keydown", (e) => {
      if (!isDesktopSiteMode()) return;

      // Open palette: Ctrl+K or Cmd+K
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (palette.dataset.visible === "true") {
          closePalette({ restoreFocus: true });
        } else {
          openPalette();
        }
        return;
      }

      // Only handle these keys when palette is open
      if (palette.dataset.visible !== "true") return;

      // Close palette: Escape
      if (e.key === "Escape") {
        e.preventDefault();
        closePalette({ restoreFocus: true });
        return;
      }

      // The open palette is modal: Tab and Shift+Tab cycle through its input
      // and visible results.
      if (e.key === "Tab") {
        e.preventDefault();
        const stops = [input, ...visibleItems];
        const at = stops.indexOf(document.activeElement);
        const step = e.shiftKey ? -1 : 1;
        // From anywhere else, Tab starts at the input, Shift+Tab at the end.
        const from = at >= 0 ? at : e.shiftKey ? 0 : -1;
        stops[(from + step + stops.length) % stops.length].focus();
        return;
      }

      // Navigate: Arrow Down
      if (e.key === "ArrowDown") {
        e.preventDefault();
        moveSelection(1);
        return;
      }

      // Navigate: Arrow Up
      if (e.key === "ArrowUp") {
        e.preventDefault();
        moveSelection(-1);
        return;
      }

      // Execute: Enter
      if (e.key === "Enter") {
        // A focused item runs through its native button click instead.
        if (results.contains(document.activeElement) || e.isComposing) return;
        e.preventDefault();
        if (visibleItems[selectedIndex]) {
          executeItem(visibleItems[selectedIndex]);
        }
        return;
      }
    });

    // Search input
    input?.addEventListener("input", (e) => {
      filterItems(e.target.value);
    });

    // Click on item (also Enter or Space on a focused item)
    results?.addEventListener("click", (e) => {
      const item = e.target.closest(".command-palette-item");
      if (item) {
        selectItem(item);
        executeItem(item);
      }
    });

    // The highlight follows keyboard focus, so Enter and the highlight agree.
    results?.addEventListener("focusin", (e) => {
      const item = e.target.closest(".command-palette-item");
      if (item) selectItem(item);
    });

    // Click on backdrop to close
    backdrop?.addEventListener("click", () => {
      closePalette({ restoreFocus: true });
    });

    // Initialize
    updateVisibleItems();
  });
</script>

<style>
  .command-palette {
    position: fixed;
    inset: 0;
    z-index: 20000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .command-palette[data-visible="true"] {
    opacity: 1;
    pointer-events: all;
  }

  .command-palette-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .command-palette-container {
    position: relative;
    width: 90%;
    max-width: 600px;
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 12px;
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(34, 197, 94, 0.1);
    overflow: hidden;
    transform: translateY(-20px);
    transition: transform 0.15s ease;
  }

  .command-palette[data-visible="true"] .command-palette-container {
    transform: translateY(0);
