<script is:inline data-cfasync="false">
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    if (window.__pepodevWindowManagerReady) return;
    window.__pepodevWindowManagerReady = true;

    const taskbarApps = document.getElementById("taskbar-apps");
    const taskbar = document.getElementById("taskbar");
    const mobileQuery = window.matchMedia("(max-width: 768px)");
    let mobileMode = mobileQuery.matches;
    let topZ = 100;
    let userOpenedWindow = false;
    let userInteracted = false;
    // Set by keydown and cleared by pointerdown, so only windows opened from
    // the keyboard take keyboard focus.
    let keyboardInteraction = false;
    // A dragged window keeps this much of its title bar on screen.
    const minVisibleTitlebar = 120;
    const focusableSelector =
      'a[href], button, input, select, textarea, summary, iframe, [contenteditable], [tabindex]:not([tabindex="-1"])';
    const windows = new Map();

    function isDesktopSiteMode() {
      return document.documentElement.dataset.siteMode !== "website";
    }

    document.querySelectorAll("[data-window]").forEach((element) => {
      const state = {
        id: element.id,
        appId: element.dataset.appId,
        title: element.dataset.title,
        width: Number(element.dataset.width),
        height: Number(element.dataset.height),
        element,
        content: element.querySelector(".window-content"),
        open: false,
        minimized: false,
        maximized: false,
        prevBounds: null,
        hasOpened: false,
        returnFocus: null,
      };
      windows.set(state.appId, state);
      setupWindowEvents(state);
    });

    document.addEventListener("desktop:open-app", (event) => {
      if (!isDesktopSiteMode()) return;
      userOpenedWindow = true;
      openWindow(event.detail.appId, keyboardInteraction);
    });

    document.addEventListener(
      "keydown",
      (event) => {
        if (!["Shift", "Control", "Alt", "Meta"].includes(event.key))
          keyboardInteraction = true;
      },
      true,
    );
    document.addEventListener(
      "pointerdown",
      () => {
        keyboardInteraction = false;
      },
      true,
    );

    ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
      document.addEventListener(
        eventName,
        () => {
          userInteracted = true;
        },
        { capture: true, once: true },
      );
    });

    document.addEventListener("desktop:close-all-windows", () => {
      windows.forEach((state) => {
        if (state.open) {
          closeWindow(state.appId);
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      if (!isDesktopSiteMode()) return;
      if (event.key !== "Escape" || event.defaultPrevented) return;
      if (isEscapeOwnedByOverlay()) return;

      const activeWindow = getActiveWindow();
      if (!activeWindow) return;

      event.preventDefault();
      closeWindow(activeWindow.appId);
    });

    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener("change", syncViewportMode);
    } else {
      mobileQuery.addListener(syncViewportMode);
    }

    window.addEventListener("resize", syncViewportMode);
    document.addEventListener("site:mode-change", (event) => {
      if (event.detail?.mode === "desktop") {
        syncViewportMode();
        scheduleWelcomeWindow();
      }
    });
    syncViewportMode();

    // moveFocus hands keyboard focus to the window. Every launch, including
    // one that restores or raises an open window, then dispatches
    // desktop:window-focus, so an app can move focus on to its own control.
    function openWindow(appId, moveFocus = false) {
      const state = windows.get(appId);
      if (!state) return;

      if (state.open && state.minimized) {
        restoreWindow(appId, moveFocus);
        return;
      }

      if (state.open) {
        activateWindow(state, moveFocus);
        return;
      }

      // Closing a window opened from the keyboard returns keyboard focus
      // here while it is shown. Start menu and palette items close with
      // their overlay.
      const active = document.activeElement;
      state.returnFocus =
        moveFocus &&
        active &&
        active !== document.body &&
        !state.element.contains(active) &&
        !active.closest("#start-menu, #command-palette, #tray-panel")
          ? active
          : null;
      state.open = true;
      state.minimized = false;
      setMaximized(state, false);
      state.prevBounds = null;
      state.element.hidden = false;
      setWindowShown(state, true);
      state.element.classList.remove("minimized", "closing");
      state.element.classList.add("opening");
      if (isMobileMode()) {
        applyMobileWindowBounds(state);
      } else {
        applyDesktopInitialBounds(state);
      }
      state.element.style.zIndex = ++topZ;

      window.setTimeout(() => state.element.classList.remove("opening"), 300);
      focusWindow(appId);
      if (moveFocus) focusWindowElement(state);
      animateSkillBars(state.element);
      syncScrollableContent(state);
      state.element.dispatchEvent(
        new CustomEvent("desktop:window-open", {
          detail: { appId, firstOpen: !state.hasOpened },
        }),
      );
      state.hasOpened = true;
      dispatchWindowFocus(state, moveFocus);
    }

    // Raises the window and gives it the keys.
    function activateWindow(state, moveFocus) {
      focusWindow(state.appId);
      if (moveFocus) focusWindowElement(state);
      dispatchWindowFocus(state, moveFocus);
    }

    // keyboard says whether DOM focus moved into the window. Apps that focus
    // their own control on desktop:window-focus skip that on touch screens
    // unless it did, so a tap does not raise the on-screen keyboard.
    function dispatchWindowFocus(state, keyboard) {
      state.element.dispatchEvent(
        new CustomEvent("desktop:window-focus", {
          detail: { appId: state.appId, keyboard },
        }),
      );
    }

    function setupWindowEvents(state) {
      const win = state.element;
      const titlebar = win.querySelector(".window-titlebar");
      const resizeHandles = win.querySelectorAll(".window-resize-handle");

      win.addEventListener("mousedown", () => {
        if (state.open && !state.minimized) focusWindow(state.appId);
      });

      // Only focusWindowElement makes the window itself focusable, until focus
      // moves on (not when the browser window loses focus). A click inside
      // leaves focus where the browser puts it, so keyboard scrolling still
      // starts from the clicked content.
      win.addEventListener("blur", () => {
        if (document.hasFocus()) win.removeAttribute("tabindex");
      });
      win.addEventListener(
        "pointerdown",
        () => win.removeAttribute("tabindex"),
        true,
      );

      // Tabbing into a window gives it the keyboard, just like clicking.
      win.addEventListener("focusin", () => {
        if (state.open && !state.minimized && !win.classList.contains("focused"))
          focusWindow(state.appId);
      });

      win
        .querySelector(".close-btn")
        ?.addEventListener("click", () => closeWindow(state.appId));
      win
        .querySelector(".min-btn")
        ?.addEventListener("click", () => minimizeWindow(state.appId));
      win
        .querySelector(".max-btn")
        ?.addEventListener("click", () => toggleMaximize(state.appId));

      // Content that grows, shrinks or changes view can start or stop
      // overflowing without the window resizing.
      if (state.content && window.ResizeObserver) {
        const observer = new ResizeObserver(() => syncScrollableContent(state));
        observer.observe(state.content);
        Array.from(state.content.children).forEach((child) =>
          observer.observe(child),
        );
      }

      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let winStartX = 0;
      let winStartY = 0;
      let wasMaximized = false;

      titlebar?.addEventListener("mousedown", (event) => {
        if (isMobileMode()) return;
        if (event.target.closest(".window-controls")) return;

        dragStartX = event.clientX;
        dragStartY = event.clientY;
        winStartX = win.offsetLeft;
        winStartY = win.offsetTop;
        wasMaximized = state.maximized;
        isDragging = true;
        document.body.style.userSelect = "none";
      });

      titlebar?.addEventListener("dblclick", (event) => {
        if (isMobileMode()) return;
        if (event.target.closest(".window-controls")) return;
        toggleMaximize(state.appId);
      });

      let isResizing = false;
      let resizeStartX = 0;
      let resizeStartY = 0;
      let resizeStartW = 0;
      let resizeStartH = 0;
      let resizeDirection = "corner";

      resizeHandles.forEach((handle) => {
        handle.addEventListener("mousedown", (event) => {
          event.stopPropagation();
          if (state.maximized || isMobileMode()) return;
          event.preventDefault();
          isResizing = true;
          resizeDirection = handle.dataset.resizeDirection || "corner";
          resizeStartX = event.clientX;
          resizeStartY = event.clientY;
          resizeStartW = win.offsetWidth;
          resizeStartH = win.offsetHeight;
          document.body.style.userSelect = "none";
        });
      });

      document.addEventListener("mousemove", (event) => {
        if ((isDragging || isResizing) && event.buttons === 0) {
          endInteraction();
          return;
        }

        if (isMobileMode()) return;

        if (isDragging) {
          const deltaX = event.clientX - dragStartX;
          const deltaY = event.clientY - dragStartY;

          if (wasMaximized && (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5)) {
            if (state.prevBounds) {
              const restoredBounds = { ...state.prevBounds };
              const clickRatioX = dragStartX / window.innerWidth;
              const newX = dragStartX - restoredBounds.width * clickRatioX;

              restoredBounds.left = Math.max(0, newX);
              restoredBounds.top = 0;
              unmaximizeWindow(state, restoredBounds);

              winStartX = parseInt(win.style.left);
              winStartY = parseInt(win.style.top);
              dragStartX = event.clientX;
              dragStartY = event.clientY;
              wasMaximized = false;
            }
          } else if (!wasMaximized) {
            const next = clampWindowOrigin(
              win,
              winStartX + deltaX,
              winStartY + deltaY,
            );
            win.style.left = next.left + "px";
            win.style.top = next.top + "px";
          }
        }

        if (isResizing) {
          if (resizeDirection === "right" || resizeDirection === "corner") {
            win.style.width =
              Math.max(320, resizeStartW + event.clientX - resizeStartX) + "px";
          }

          if (resizeDirection === "bottom" || resizeDirection === "corner") {
            win.style.height =
              Math.max(200, resizeStartH + event.clientY - resizeStartY) + "px";
          }
        }
      });

      function endInteraction() {
        if (isDragging || isResizing) {
          isDragging = false;
          isResizing = false;
          wasMaximized = false;
          document.body.style.userSelect = "";
        }
      }

      document.addEventListener("mouseup", endInteraction);
      window.addEventListener("mouseup", endInteraction);
      window.addEventListener("blur", endInteraction);
    }

    function focusWindow(appId) {
      windows.forEach((state) => {
        const isFocused =
          state.appId === appId && state.open && !state.minimized;
        state.element.classList.toggle("focused", isFocused);
        if (isFocused) state.element.style.zIndex = ++topZ;
      });
      updateTaskbar();
    }

    function closeWindow(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;

      state.element.dispatchEvent(
        new CustomEvent("desktop:window-close", { detail: { appId } }),
      );
      const wasFocused = state.element.classList.contains("focused");
      state.open = false;
      state.minimized = false;
      setMaximized(state, false);
      state.element.classList.add("closing");
      state.element.classList.remove("focused", "minimized");
      releaseWindowFocus(state, wasFocused, true);
      setWindowShown(state, false);
      window.setTimeout(() => {
        // Reopened while the closing animation ran.
        if (state.open) return;
        state.element.hidden = true;
        state.element.classList.remove("closing");
        updateTaskbar();
      }, 200);
      updateTaskbar();
    }

    function getActiveWindow() {
      const focused = Array.from(windows.values()).find(
        (state) =>
          state.open &&
          !state.minimized &&
          state.element.classList.contains("focused"),
      );
      if (focused) return focused;

      return Array.from(windows.values())
        .filter((state) => state.open && !state.minimized)
        .sort(
          (a, b) =>
            Number(b.element.style.zIndex || 0) -
            Number(a.element.style.zIndex || 0),
        )[0];
    }

    // A closed or minimized window hands window focus to the next one, so app
    // keys and Escape agree on the active window. DOM focus in it, or on its
    // launcher, is dropped after a pointer action, so the next app gets the
    // keys. From the keyboard it goes back to the launcher of a window opened
    // from the keyboard while that is still shown, else into the next
    // window, else to the control that reopens it.
    function releaseWindowFocus(state, wasFocused, closing = false) {
      const active = document.activeElement;
      const hadFocus =
        state.element.contains(active) ||
        active?.closest?.(`[data-open-app="${state.appId}"]`) ||
        // Closing removes the window's own taskbar button.
        (closing &&
          taskbarApps?.contains(active) &&
          active.dataset.appId === state.appId);
      const next = getActiveWindow();
      if (wasFocused && next) focusWindow(next.appId);
      updateTaskbar();
      if (!hadFocus) return;

      const target =
        keyboardInteraction &&
        [
          closing && state.returnFocus,
          next?.element,
          closing
            ? document.querySelector(
                `#desktop-icons [data-open-app="${state.appId}"]`,
              )
            : taskbarApps?.querySelector(`[data-app-id="${state.appId}"]`),
        ].find(canTakeFocus);
      if (!target) {
        active.blur();
      } else if (target === next?.element) {
        focusWindowElement(next);
        dispatchWindowFocus(next, true);
      } else {
        target.focus({ preventScroll: true });
      }
    }

    // The same rules as canTakeFocus in src/utils/overlays.ts, which this
    // parse-time script cannot import: closed overlays are inert, and closed
    // or minimized windows are aria-hidden.
    function canTakeFocus(element) {
      return (
        element instanceof HTMLElement &&
        element !== document.body &&
        element.isConnected &&
        !element.closest("[inert], [hidden], [aria-hidden='true'], .closing") &&
        element.getClientRects().length > 0
      );
    }

    // The window stays focusable only while it holds focus.
    function focusWindowElement(state) {
      state.element.tabIndex = -1;
      state.element.focus({ preventScroll: true });
    }

    // Closed and minimized windows leave the Tab order and the accessibility
    // tree; only an open, unminimized window is shown.
    function setWindowShown(state, shown) {
      state.element.inert = !shown;
      state.element.setAttribute("aria-hidden", String(!shown));
    }

    function isEscapeOwnedByOverlay() {
      return (
        document.getElementById("command-palette")?.dataset.visible ===
          "true" ||
        document.getElementById("start-menu")?.classList.contains("visible") ||
        document.getElementById("tray-panel")?.classList.contains("visible")
      );
    }

    function minimizeWindow(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;
      const wasFocused = state.element.classList.contains("focused");
      state.minimized = true;
      state.element.classList.add("minimized");
      state.element.classList.remove("focused");
      releaseWindowFocus(state, wasFocused);
      setWindowShown(state, false);
      updateTaskbar();
    }

    function restoreWindow(appId, moveFocus = false) {
      const state = windows.get(appId);
      if (!state || !state.open) return;
      state.minimized = false;
      state.element.hidden = false;
      state.element.classList.remove("minimized");
      setWindowShown(state, true);
      if (isMobileMode()) {
        applyMobileWindowBounds(state);
      } else if (!state.maximized) {
        clampWindowPosition(state);
      }
      focusWindow(appId);
      if (moveFocus) focusWindowElement(state);
      animateSkillBars(state.element);
      syncScrollableContent(state);
      dispatchWindowFocus(state, moveFocus);
    }

    function toggleMaximize(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;

      if (isMobileMode()) {
        applyMobileWindowBounds(state);
        focusWindow(appId);
        return;
      }

      if (!state.maximized) {
        state.prevBounds = getWindowBounds(state.element);
        state.element.style.left = "0";
        state.element.style.top = "0";
        state.element.style.width = "100vw";
        state.element.style.height = `calc(100vh - ${getTaskbarHeight()}px)`;
        state.element.style.zIndex = ++topZ;
        setMaximized(state, true);
      } else if (state.prevBounds) {
        unmaximizeWindow(state);
      } else {
        // Maximized at phone width, so there are no bounds to restore.
        applyDesktopInitialBounds(state);
      }

      focusWindow(appId);
    }

    // The Maximize button reads Restore while the window is maximized.
    function setMaximized(state, maximized) {
      state.maximized = maximized;
      state.element.classList.toggle("maximized", maximized);
      const button = state.element.querySelector(".max-btn");
      const action = maximized ? "Restore" : "Maximize";
      button?.setAttribute("title", action);
      button?.setAttribute("aria-label", `${action} ${state.title}`);
    }

    function isMobileMode() {
      return mobileMode;
    }

    function getTaskbarHeight() {
      return Math.max(48, taskbar?.offsetHeight || 56);
    }

    function updateViewportAttributes() {
      document.documentElement.dataset.viewportMode = mobileMode
        ? "mobile"
        : "desktop";
      document.documentElement.style.setProperty(
        "--mobile-taskbar-height",
        getTaskbarHeight() + "px",
      );
    }

    function getCenteredWindowBounds(state) {
      const taskbarHeight = getTaskbarHeight();
      const availableWidth = Math.max(280, window.innerWidth - 24);
      const availableHeight = Math.max(
        220,
        window.innerHeight - taskbarHeight - 24,
      );
      const width = Math.min(state.width, availableWidth);
      const height = Math.min(state.height, availableHeight);

      return {
        left: Math.max(
          12,
          (window.innerWidth - width) / 2 + (Math.random() * 40 - 20),
        ),
        top: Math.max(
          12,
          Math.min(
            (window.innerHeight - height - taskbarHeight) / 2 +
              (Math.random() * 30 - 15),
            window.innerHeight - height - taskbarHeight - 12,
          ),
        ),
        width,
        height,
      };
    }

    // Keeps a title bar reachable: above the taskbar, with at least
    // minVisibleTitlebar of it on screen to grab. Off the left edge, the
    // window controls at its right end do not count.
    function clampWindowOrigin(win, left, top) {
      const titlebar = win.querySelector(".window-titlebar");
      const controls = win.querySelector(".window-controls");
      const titlebarBottom =
        win.clientTop +
        (titlebar?.offsetTop ?? 0) +
        (titlebar?.offsetHeight ?? 40);
      const controlsWidth = controls
        ? win.offsetWidth - win.clientLeft - controls.offsetLeft
        : 0;
      const visibleWidth = Math.min(minVisibleTitlebar, win.offsetWidth);
      const visibleLeftWidth = Math.min(
        minVisibleTitlebar + controlsWidth,
        win.offsetWidth,
      );
      const maxTop = window.innerHeight - getTaskbarHeight() - titlebarBottom;

      return {
        left: Math.min(
          Math.max(left, visibleLeftWidth - win.offsetWidth),
          window.innerWidth - visibleWidth,
        ),
        top: Math.min(Math.max(0, top), Math.max(0, maxTop)),
      };
    }

    function clampWindowPosition(state) {
      const win = state.element;
      const next = clampWindowOrigin(win, win.offsetLeft, win.offsetTop);
      win.style.left = next.left + "px";
      win.style.top = next.top + "px";
    }

    function applyDesktopInitialBounds(state) {
      state.element.classList.remove("mobile-window");
      setMaximized(state, false);
      state.prevBounds = null;
      applyWindowBounds(state.element, getCenteredWindowBounds(state));
    }

    function applyMobileWindowBounds(state) {
      state.prevBounds = null;
      setMaximized(state, true);
      state.element.classList.add("mobile-window");
      state.element.style.left = "0";
      state.element.style.top = "0";
      state.element.style.width = "100vw";
      state.element.style.height =
        "calc(100dvh - var(--mobile-taskbar-height, 56px))";
    }

    function syncViewportMode() {
      if (!isDesktopSiteMode()) return;

      const wasMobile = mobileMode;
      mobileMode = mobileQuery.matches;
      updateViewportAttributes();

      windows.forEach((state) => {
        state.element.classList.toggle("mobile-window", mobileMode);
        if (!state.open || state.minimized) return;

        if (mobileMode) {
          applyMobileWindowBounds(state);
        } else if (wasMobile) {
          applyDesktopInitialBounds(state);
        } else if (!state.maximized) {
          clampWindowPosition(state);
        }
      });

      updateTaskbar();
    }

    function getWindowBounds(element) {
      const rect = element.getBoundingClientRect();
      return {
        left: rect.left,
        top: rect.top,
        width: rect.width,
        height: rect.height,
      };
    }

    function applyWindowBounds(element, bounds) {
      element.style.left = bounds.left + "px";
      element.style.top = bounds.top + "px";
      element.style.width = bounds.width + "px";
      element.style.height = bounds.height + "px";
    }

    function unmaximizeWindow(state, bounds = state.prevBounds) {
      if (!bounds) return;
      applyWindowBounds(state.element, bounds);
      state.element.style.zIndex = ++topZ;
      setMaximized(state, false);
      clampWindowPosition(state);
    }

    // A scroller with nothing focusable inside gets its own tab stop, so
    // browsers that do not focus scrollers can still scroll it by keyboard.
    // Hidden and disabled controls (the unlocked Gallery's password form)
    // cannot take focus, so they do not count.
    function syncScrollableContent(state) {
      const content = state.content;
      if (!content || !state.open) return;
      const needsTabStop =
        content.scrollHeight > content.clientHeight + 1 &&
        !Array.from(content.querySelectorAll(focusableSelector)).some(
          (element) =>
            !element.disabled &&
            !element.closest("[hidden], [inert]") &&
            element.getClientRects().length > 0,
        );
      if (needsTabStop === content.hasAttribute("tabindex")) return;

      if (needsTabStop) {
        content.tabIndex = 0;
        content.setAttribute("role", "group");
        content.setAttribute("aria-label", `${state.title} content`);
      } else {
        content.removeAttribute("tabindex");
        content.removeAttribute("role");
        content.removeAttribute("aria-label");
      }
    }

    function updateTaskbar() {
      if (!taskbarApps) return;
      // Rebuilding drops the focused button; a keyboard user keeps focus on
      // its replacement, while a click leaves the keys to the window.
      const focusedAppId =
        keyboardInteraction && taskbarApps.contains(document.activeElement)
          ? document.activeElement.dataset.appId
          : "";
      taskbarApps.innerHTML = "";

      windows.forEach((state) => {
        if (!state.open) return;

        const label = state.title.split("-")[0].trim();
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "taskbar-app active" +
          (state.element.classList.contains("focused") ? " focused" : "");
        btn.dataset.appId = state.appId;
        // The label names the button; phone widths hide it only visually,
        // and the icon is aria-hidden.
        btn.title = label;
        btn.innerHTML =
          state.element.querySelector(".window-titlebar-icon")?.innerHTML +
          "<span>" +
          label +
          "</span>";
        btn.addEventListener("click", () => {
          const moveFocus = keyboardInteraction;
          if (state.minimized) {
            restoreWindow(state.appId, moveFocus);
          } else if (
            !isMobileMode() &&
            state.element.classList.contains("focused")
          ) {
            minimizeWindow(state.appId);
          } else {
            activateWindow(state, moveFocus);
          }
        });
        taskbarApps.appendChild(btn);
      });

      if (focusedAppId) {
        taskbarApps
          .querySelector(`[data-app-id="${focusedAppId}"]`)
          ?.focus({ preventScroll: true });
      }
    }

    function animateSkillBars(win) {
      window.setTimeout(() => {
        win.querySelectorAll(".skill-bar-fill").forEach((bar) => {
          bar.style.width = bar.dataset.level + "%";
        });
      }, 300);
    }

    const firstVisitKey = "pepodev.hasVisited";
    let hasVisited = localStorage.getItem(firstVisitKey) === "true";
    let welcomeTimerId = 0;

    function markVisited() {
      hasVisited = true;
      localStorage.setItem(firstVisitKey, "true");
    }

    function scheduleWelcomeWindow() {
      if (hasVisited || welcomeTimerId || !isDesktopSiteMode()) return;
      // A ?blog= deep link opens the article instead. Its handler can run
      // after this timer when Rocket Loader defers it.
      if (new URLSearchParams(window.location.search).get("blog")?.trim()) {
        markVisited();
        return;
      }

      welcomeTimerId = window.setTimeout(() => {
        welcomeTimerId = 0;
        if (!isDesktopSiteMode()) return;

        if (userInteracted || userOpenedWindow || getActiveWindow()) {
          markVisited();
          return;
        }

        openWindow("welcome");
        markVisited();
      }, 1500);
    }

    scheduleWelcomeWindow();
  });
</script>
