---
import AppIcon from "./AppIcon.astro";

const apps = [
  { appId: "welcome", label: "Welcome", description: "Login & introduction" },
  { appId: "blog", label: "Blog", description: "Read articles & write-ups" },
  { appId: "garden", label: "Garden", description: "Browse evolving notes" },
  { appId: "project", label: "Projects", description: "Showcase of work" },
  { appId: "work", label: "Work", description: "Experience & career" },
  { appId: "me", label: "About Me", description: "Contact & personal info" },
  { appId: "sregame", label: "SRE Game", description: "Chaos simulation game" },
  { appId: "snake", label: "Snake", description: "Classic grid survival game" },
  { appId: "music", label: "Music", description: "Ambient desktop player" },
  {
    appId: "whitenoise",
    label: "Noise",
    description: "Rainy white noise loop",
  },
  {
    appId: "calculator",
    label: "Calculator",
    description: "Quick calculations",
  },
  { appId: "settings", label: "Settings", description: "Customize desktop" },
  { appId: "terminal", label: "Terminal", description: "Interactive shell" },
  { appId: "certs", label: "Certs", description: "Certification wallet" },
  {
    appId: "gallery",
    label: "Gallery",
    description: "Password protected pictures",
  },
  { appId: "trash", label: "Trash", description: "Deleted desktop nonsense" },
];
---

<div id="start-menu" role="dialog" aria-label="Start menu" tabindex="-1" inert>
  <div id="start-menu-header">
    <h3>Quick Access</h3>
    <input
      type="text"
      id="start-menu-search"
      placeholder="Search apps..."
      aria-label="Search apps"
      autocomplete="off"
    />
  </div>
  <div id="start-menu-apps">
    {
      apps.map((app) => (
        <button class="start-menu-app" type="button" data-open-app={app.appId}>
          <AppIcon name={app.appId} />
          <div class="start-menu-app-text">
            <strong>{app.label}</strong>
            <small>{app.description}</small>
          </div>
        </button>
      ))
    }
  </div>
  <p id="start-menu-empty" role="status"></p>
  <div id="start-menu-footer">
    <span>system status: nominal</span>
    <span id="start-menu-uptime">uptime: --</span>
  </div>
</div>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    const startMenu = document.getElementById("start-menu");
    const startBtn = document.getElementById("taskbar-start");
    const search = document.getElementById("start-menu-search");
    const appList = document.getElementById("start-menu-apps");
    const empty = document.getElementById("start-menu-empty");
    const apps = Array.from(document.querySelectorAll(".start-menu-app"));
    // Phones and touch tablets, where focusing the search raises the
    // on-screen keyboard over the menu.
    const touchQuery = window.matchMedia(
      "(max-width: 768px), (hover: none), (pointer: coarse)",
    );
    let startMenuOpen = false;

    // Closed, the menu leaves the tab order and the accessibility tree.
    // restoreFocus returns focus to the Start button. Launching an app skips
    // that, so app keys are not held back by a focused taskbar button.
    function setStartMenu(open, { restoreFocus = false } = {}) {
      if (!startMenu || open === startMenuOpen) return;
      startMenuOpen = open;
      startMenu.classList.toggle("visible", startMenuOpen);
      startBtn?.setAttribute("aria-expanded", String(startMenuOpen));

      if (open) {
        startMenu.inert = false;
        if (search) search.value = "";
        filterApps("");
        // Touch screens open the menu without raising the on-screen keyboard.
        (touchQuery.matches ? startMenu : search)?.focus();
        return;
      }

      const active = document.activeElement;
      const hadFocus = startMenu.contains(active) || active === document.body;
      if (startMenu.contains(active)) active.blur();
      startMenu.inert = true;
      if (restoreFocus && hadFocus) startBtn?.focus();
    }

    // Whether the query starts the text or one of its words.
    function startsWord(text, query) {
      for (
        let at = text.indexOf(query);
        at >= 0;
        at = text.indexOf(query, at + 1)
      ) {
        if (at === 0 || !/[\p{L}\p{N}]/u.test(text[at - 1])) return true;
      }
      return false;
    }

    // 0 when the query starts the label or a word in it, 1 for the rest of
    // the label, 2 for the description, -1 for no match. getMatchRank in
    // CommandPalette.astro ranks the same way.
    function getMatchRank(label, description, query) {
      if (startsWord(label, query)) return 0;
      if (label.includes(query)) return 1;
      return description.includes(query) ? 2 : -1;
    }

    // Matches are sorted by rank, so Enter opens the closest one.
    function filterApps(query) {
      const q = query.trim().toLowerCase();
      const ranked = apps
        .map((app, index) => {
          const label = app.querySelector("strong")?.textContent ?? "";
          const description = app.querySelector("small")?.textContent ?? "";
          const rank = getMatchRank(
            label.trim().toLowerCase(),
            description.trim().toLowerCase(),
            q,
          );
          return { app, index, rank };
        })
        .sort(
          (a, b) =>
            (a.rank < 0) - (b.rank < 0) || a.rank - b.rank || a.index - b.index,
        );

      ranked.forEach(({ app, rank }) => {
        app.style.display = rank < 0 ? "none" : "";
        appList?.append(app);
      });

      if (empty) {
        empty.textContent = ranked.some(({ rank }) => rank >= 0)
          ? ""
          : "No apps found";
      }
    }

    startBtn?.addEventListener("click", (event) => {
      event.stopPropagation();
      setStartMenu(!startMenuOpen, { restoreFocus: true });
    });

    startMenu?.addEventListener("click", (event) => event.stopPropagation());

    document.addEventListener("click", (event) => {
      if (!startMenuOpen) return;
      if (startMenu?.contains(event.target) || startBtn?.contains(event.target))
        return;
      setStartMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && startMenuOpen)
        setStartMenu(false, { restoreFocus: true });
    });

    document.addEventListener("desktop:open-app", () => setStartMenu(false));
    // One overlay at a time: opening the palette closes the Start menu.
    document.addEventListener("desktop:command-palette-open", () =>
      setStartMenu(false, { restoreFocus: true }),
    );

    search?.addEventListener("input", (event) => {
      filterApps(event.target.value);
    });

    // Enter in the search box opens the first match.
    search?.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" || event.isComposing) return;
      const firstMatch = Array.from(appList?.children ?? []).find(
        (app) => app.style.display !== "none",
      );
      if (!firstMatch) return;
      event.preventDefault();
      firstMatch.click();
    });
  });
</script>
