---
import AppIcon from "./AppIcon.astro";

interface Props {
  appId: string;
  label: string;
  id?: string;
  class?: string;
  "data-default-col"?: string | number;
  "data-default-row"?: string | number;
  "data-layout-group"?: string;
  "data-layout-index"?: string | number;
}

const { appId, label, id, class: className = "", ...rest } = Astro.props;
---

<button
  id={id}
  type="button"
  class:list={["desktop-icon", className]}
  data-open-app={appId}
  {...rest}
>
  <AppIcon name={appId} />
  <span>{label}</span>
</button>
