<script is:inline data-cfasync="false">
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    if (window.__pepodevExternalLinkIconsReady) return;
    window.__pepodevExternalLinkIconsReady = true;

    // DesktopIconController places link icons on the shared desktop grid
    // (window.__pepodevDesktopIconGrid); this handles dragging links.
    const linkIcons = Array.from(
      document.querySelectorAll(".desktop-link-icon"),
    );
    const mobileQuery = window.matchMedia("(max-width: 768px)");

    function isMobileShortcutMode() {
      return mobileQuery.matches;
    }

    linkIcons.forEach((icon) => {
      if (!icon.id) return;

      let pointerStartX = 0;
      let pointerStartY = 0;
      let iconStartX = 0;
      let iconStartY = 0;
      let isPointerDown = false;
      let isDragging = false;
      let wasDragging = false; // Track if we just finished dragging

      icon.addEventListener("pointerdown", (event) => {
        if (isMobileShortcutMode()) return;
        if (event.button !== 0) return;

        const rect = icon.getBoundingClientRect();
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;
        iconStartX = rect.left;
        iconStartY = rect.top;
        isPointerDown = true;
        isDragging = false;
        wasDragging = false;
        icon.style.zIndex = "30";
        icon.setPointerCapture?.(event.pointerId);
        event.preventDefault();
      });

      icon.addEventListener("pointermove", (event) => {
        if (isMobileShortcutMode()) return;
        if (!isPointerDown) return;

        const deltaX = event.clientX - pointerStartX;
        const deltaY = event.clientY - pointerStartY;
        if (!isDragging && Math.hypot(deltaX, deltaY) < 4) return;

        isDragging = true;
        icon.classList.add("dragging");
        window.__pepodevDesktopIconGrid?.move(
          icon,
          iconStartX + deltaX,
          iconStartY + deltaY,
        );
      });

      icon.addEventListener("pointerup", (event) => {
        if (isMobileShortcutMode()) return;
        if (!isPointerDown) return;

        icon.releasePointerCapture?.(event.pointerId);
        isPointerDown = false;
        icon.style.zIndex = "5";

        if (isDragging) {
          const rect = icon.getBoundingClientRect();
          window.__pepodevDesktopIconGrid?.drop(icon, rect.left, rect.top);
          icon.classList.remove("dragging");

          // Set flag to prevent click event
          wasDragging = true;
          isDragging = false;

          // Prevent link navigation after drag
          event.preventDefault();
          event.stopPropagation();
          return;
        }

        // If not dragging, allow normal link behavior
      });

      icon.addEventListener("pointercancel", () => {
        isPointerDown = false;
        isDragging = false;
        icon.style.zIndex = "5";
        icon.classList.remove("dragging");
      });

      // Prevent default link behavior if we just finished dragging
      icon.addEventListener("click", (e) => {
        if (wasDragging) {
          e.preventDefault();
          e.stopPropagation();
          wasDragging = false; // Reset flag after preventing click
        }
        // Otherwise allow normal link navigation
      });
    });
  });
</script>
