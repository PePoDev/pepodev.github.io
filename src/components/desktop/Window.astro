---
import AppIcon from "./AppIcon.astro";

interface Props {
  appId: string;
  title: string;
  width: number;
  height: number;
}

const { appId, title, width, height } = Astro.props;
---

<section
  id={`window-${appId}`}
  class="window"
  data-window
  data-app-id={appId}
  data-title={title}
  data-width={width}
  data-height={height}
  role="dialog"
  aria-labelledby={`window-${appId}-title`}
  aria-hidden="true"
  hidden
>
  <div class="window-titlebar">
    <div class="window-titlebar-icon"><AppIcon name={appId} /></div>
    <span id={`window-${appId}-title`} class="window-title">{title}</span>
    <div class="window-controls">
      <button
        class="min-btn"
        type="button"
        title="Minimize"
        aria-label={`Minimize ${title}`}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <line x1="2" y1="6" x2="10" y2="6"></line>
        </svg>
      </button>
      <button
        class="max-btn"
        type="button"
        title="Maximize"
        aria-label={`Maximize ${title}`}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="8" height="8" rx="1"></rect>
        </svg>
      </button>
      <button
        class="close-btn"
        type="button"
        title="Close"
        aria-label={`Close ${title}`}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <line x1="2" y1="2" x2="10" y2="10"></line>
          <line x1="10" y1="2" x2="2" y2="10"></line>
        </svg>
      </button>
    </div>
  </div>
  <div class="window-content">
    <slot />
  </div>
  <div
    class="window-resize-handle window-resize-handle-right"
    data-resize-direction="right"
  >
  </div>
  <div
    class="window-resize-handle window-resize-handle-bottom"
    data-resize-direction="bottom"
  >
  </div>
  <div
    class="window-resize-handle window-resize-handle-corner"
    data-resize-direction="corner"
  >
  </div>
</section>
