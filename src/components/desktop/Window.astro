---
import AppIcon from "./AppIcon.astro";

interface Props {
  appId: string;
  title: string;
  width: number;
  height: number;
}

const { appId, title, width, height } = Astro.props;
---

<section
  id={`window-${appId}`}
  class="window"
  data-window
  data-app-id={appId}
  data-title={title}
  data-width={width}
  data-height={height}
  aria-hidden="true"
  hidden
>
  <div class="window-titlebar">
    <div class="window-titlebar-icon"><AppIcon name={appId} /></div>
    <span class="window-title">{title}</span>
    <div class="window-controls">
      <button
        class="min-btn"
        type="button"
        title="Minimize"
        aria-label={`Minimize ${title}`}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <line x1="2" y1="6" x2="10" y2="6"></line>
        </svg>
      </button>
      <button
        class="max-btn"
        type="button"
        title="Maximize"
        aria-label={`Maximize ${title}`}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="8" height="8" rx="1"></rect>
        </svg>
      </button>
      <button
        class="close-btn"
        type="button"
        title="Close"
        aria-label={`Close ${title}`}
      >
        <svg
          viewBox="0 0 12 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <line x1="2" y1="2" x2="10" y2="10"></line>
          <line x1="10" y1="2" x2="2" y2="10"></line>
        </svg>
      </button>
    </div>
  </div>
  <div class="window-content">
    <slot />
  </div>
  <div
    class="window-resize-handle window-resize-handle-right"
    data-resize-direction="right"
  >
  </div>
  <div
    class="window-resize-handle window-resize-handle-bottom"
    data-resize-direction="bottom"
  >
  </div>
  <div
    class="window-resize-handle window-resize-handle-corner"
    data-resize-direction="corner"
  >
  </div>
</section>

<script is:inline>
  // @ts-nocheck
  document.addEventListener("DOMContentLoaded", () => {
    if (window.__pepodevWindowManagerReady) return;
    window.__pepodevWindowManagerReady = true;

    const taskbarApps = document.getElementById("taskbar-apps");
    const taskbar = document.getElementById("taskbar");
    const mobileQuery = window.matchMedia("(max-width: 768px)");
    let mobileMode = mobileQuery.matches;
    let topZ = 100;
    let userOpenedWindow = false;
    let userInteracted = false;
    const windows = new Map();

    document.querySelectorAll("[data-window]").forEach((element) => {
      const state = {
        id: element.id,
        appId: element.dataset.appId,
        title: element.dataset.title,
        width: Number(element.dataset.width),
        height: Number(element.dataset.height),
        element,
        open: false,
        minimized: false,
        maximized: false,
        prevBounds: null,
        hasOpened: false,
      };
      windows.set(state.appId, state);
      setupWindowEvents(state);
    });

    document.addEventListener("desktop:open-app", (event) => {
      userOpenedWindow = true;
      openWindow(event.detail.appId);
    });

    ["pointerdown", "keydown", "touchstart"].forEach((eventName) => {
      document.addEventListener(
        eventName,
        () => {
          userInteracted = true;
        },
        { capture: true, once: true },
      );
    });

    document.addEventListener("desktop:close-all-windows", () => {
      windows.forEach((state) => {
        if (state.open) {
          closeWindow(state.appId);
        }
      });
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || event.defaultPrevented) return;
      if (isEscapeOwnedByOverlay()) return;

      const activeWindow = getActiveWindow();
      if (!activeWindow) return;

      event.preventDefault();
      closeWindow(activeWindow.appId);
    });

    if (mobileQuery.addEventListener) {
      mobileQuery.addEventListener("change", syncViewportMode);
    } else {
      mobileQuery.addListener(syncViewportMode);
    }

    window.addEventListener("resize", syncViewportMode);
    syncViewportMode();

    function openWindow(appId) {
      const state = windows.get(appId);
      if (!state) return;

      if (state.open && state.minimized) {
        restoreWindow(appId);
        return;
      }

      if (state.open) {
        focusWindow(appId);
        return;
      }

      state.open = true;
      state.minimized = false;
      state.maximized = false;
      state.prevBounds = null;
      state.element.hidden = false;
      state.element.setAttribute("aria-hidden", "false");
      state.element.classList.remove("minimized", "maximized", "closing");
      state.element.classList.add("opening");
      if (isMobileMode()) {
        applyMobileWindowBounds(state);
      } else {
        applyDesktopInitialBounds(state);
      }
      state.element.style.zIndex = ++topZ;

      window.setTimeout(() => state.element.classList.remove("opening"), 300);
      focusWindow(appId);
      animateSkillBars(state.element);
      updateTaskbar();
      state.element.dispatchEvent(
        new CustomEvent("desktop:window-open", {
          detail: { appId, firstOpen: !state.hasOpened },
        }),
      );
      state.hasOpened = true;
    }

    function setupWindowEvents(state) {
      const win = state.element;
      const titlebar = win.querySelector(".window-titlebar");
      const resizeHandles = win.querySelectorAll(".window-resize-handle");

      win.addEventListener("mousedown", () => {
        if (state.open && !state.minimized) focusWindow(state.appId);
      });

      win
        .querySelector(".close-btn")
        ?.addEventListener("click", () => closeWindow(state.appId));
      win
        .querySelector(".min-btn")
        ?.addEventListener("click", () => minimizeWindow(state.appId));
      win
        .querySelector(".max-btn")
        ?.addEventListener("click", () => toggleMaximize(state.appId));

      let isDragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let winStartX = 0;
      let winStartY = 0;
      let wasMaximized = false;

      titlebar?.addEventListener("mousedown", (event) => {
        if (isMobileMode()) return;
        if (event.target.closest(".window-controls")) return;

        dragStartX = event.clientX;
        dragStartY = event.clientY;
        winStartX = win.offsetLeft;
        winStartY = win.offsetTop;
        wasMaximized = state.maximized;
        isDragging = true;
        document.body.style.userSelect = "none";
      });

      titlebar?.addEventListener("dblclick", (event) => {
        if (isMobileMode()) return;
        if (event.target.closest(".window-controls")) return;
        toggleMaximize(state.appId);
      });

      let isResizing = false;
      let resizeStartX = 0;
      let resizeStartY = 0;
      let resizeStartW = 0;
      let resizeStartH = 0;
      let resizeDirection = "corner";

      resizeHandles.forEach((handle) => {
        handle.addEventListener("mousedown", (event) => {
          event.stopPropagation();
          if (state.maximized || isMobileMode()) return;
          event.preventDefault();
          isResizing = true;
          resizeDirection = handle.dataset.resizeDirection || "corner";
          resizeStartX = event.clientX;
          resizeStartY = event.clientY;
          resizeStartW = win.offsetWidth;
          resizeStartH = win.offsetHeight;
          document.body.style.userSelect = "none";
        });
      });

      document.addEventListener("mousemove", (event) => {
        if ((isDragging || isResizing) && event.buttons === 0) {
          endInteraction();
          return;
        }

        if (isMobileMode()) return;

        if (isDragging) {
          const deltaX = event.clientX - dragStartX;
          const deltaY = event.clientY - dragStartY;

          if (wasMaximized && (Math.abs(deltaX) > 5 || Math.abs(deltaY) > 5)) {
            if (state.prevBounds) {
              const restoredBounds = { ...state.prevBounds };
              const clickRatioX = dragStartX / window.innerWidth;
              const newX = dragStartX - restoredBounds.width * clickRatioX;

              restoredBounds.left = Math.max(0, newX);
              restoredBounds.top = 0;
              unmaximizeWindow(state, restoredBounds);

              winStartX = parseInt(win.style.left);
              winStartY = 0;
              dragStartX = event.clientX;
              dragStartY = event.clientY;
              wasMaximized = false;
            }
          } else if (!wasMaximized) {
            win.style.left = winStartX + deltaX + "px";
            win.style.top = Math.max(0, winStartY + deltaY) + "px";
          }
        }

        if (isResizing) {
          if (resizeDirection === "right" || resizeDirection === "corner") {
            win.style.width =
              Math.max(320, resizeStartW + event.clientX - resizeStartX) + "px";
          }

          if (resizeDirection === "bottom" || resizeDirection === "corner") {
            win.style.height =
              Math.max(200, resizeStartH + event.clientY - resizeStartY) + "px";
          }
        }
      });

      function endInteraction() {
        if (isDragging || isResizing) {
          isDragging = false;
          isResizing = false;
          wasMaximized = false;
          document.body.style.userSelect = "";
        }
      }

      document.addEventListener("mouseup", endInteraction);
      window.addEventListener("mouseup", endInteraction);
      window.addEventListener("blur", endInteraction);
    }

    function focusWindow(appId) {
      windows.forEach((state) => {
        const isFocused =
          state.appId === appId && state.open && !state.minimized;
        state.element.classList.toggle("focused", isFocused);
        if (isFocused) state.element.style.zIndex = ++topZ;
      });
      updateTaskbar();
    }

    function closeWindow(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;

      state.element.dispatchEvent(
        new CustomEvent("desktop:window-close", { detail: { appId } }),
      );
      state.open = false;
      state.minimized = false;
      state.maximized = false;
      state.element.classList.add("closing");
      state.element.classList.remove("focused", "minimized", "maximized");
      window.setTimeout(() => {
        state.element.hidden = true;
        state.element.setAttribute("aria-hidden", "true");
        state.element.classList.remove("closing");
        updateTaskbar();
      }, 200);
      updateTaskbar();
    }

    function getActiveWindow() {
      const focused = Array.from(windows.values()).find(
        (state) =>
          state.open &&
          !state.minimized &&
          state.element.classList.contains("focused"),
      );
      if (focused) return focused;

      return Array.from(windows.values())
        .filter((state) => state.open && !state.minimized)
        .sort(
          (a, b) =>
            Number(b.element.style.zIndex || 0) -
            Number(a.element.style.zIndex || 0),
        )[0];
    }

    function isEscapeOwnedByOverlay() {
      return (
        document.getElementById("command-palette")?.dataset.visible ===
          "true" ||
        document.getElementById("start-menu")?.classList.contains("visible") ||
        document.getElementById("tray-panel")?.classList.contains("visible")
      );
    }

    function minimizeWindow(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;
      state.minimized = true;
      state.element.classList.add("minimized");
      state.element.classList.remove("focused");
      updateTaskbar();
    }

    function restoreWindow(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;
      state.minimized = false;
      state.element.hidden = false;
      state.element.classList.remove("minimized");
      if (isMobileMode()) applyMobileWindowBounds(state);
      focusWindow(appId);
      animateSkillBars(state.element);
      updateTaskbar();
    }

    function toggleMaximize(appId) {
      const state = windows.get(appId);
      if (!state || !state.open) return;

      if (isMobileMode()) {
        applyMobileWindowBounds(state);
        focusWindow(appId);
        return;
      }

      if (!state.maximized) {
        state.prevBounds = getWindowBounds(state.element);
        state.element.style.left = "0";
        state.element.style.top = "0";
        state.element.style.width = "100vw";
        state.element.style.height = "calc(100vh - 48px)";
        state.element.style.zIndex = ++topZ;
        state.maximized = true;
        state.element.classList.add("maximized");
      } else if (state.prevBounds) {
        unmaximizeWindow(state);
      }

      focusWindow(appId);
    }

    function isMobileMode() {
      return mobileMode;
    }

    function getTaskbarHeight() {
      return Math.max(48, taskbar?.offsetHeight || 56);
    }

    function updateViewportAttributes() {
      document.documentElement.dataset.viewportMode = mobileMode
        ? "mobile"
        : "desktop";
      document.documentElement.style.setProperty(
        "--mobile-taskbar-height",
        getTaskbarHeight() + "px",
      );
    }

    function getCenteredWindowBounds(state) {
      const availableWidth = Math.max(280, window.innerWidth - 24);
      const availableHeight = Math.max(220, window.innerHeight - 72);
      const width = Math.min(state.width, availableWidth);
      const height = Math.min(state.height, availableHeight);

      return {
        left: Math.max(
          12,
          (window.innerWidth - width) / 2 + (Math.random() * 40 - 20),
        ),
        top: Math.max(
          12,
          (window.innerHeight - height - 48) / 2 +
            (Math.random() * 30 - 15),
        ),
        width,
        height,
      };
    }

    function applyDesktopInitialBounds(state) {
      state.element.classList.remove("mobile-window", "maximized");
      state.maximized = false;
      state.prevBounds = null;
      applyWindowBounds(state.element, getCenteredWindowBounds(state));
    }

    function applyMobileWindowBounds(state) {
      state.prevBounds = null;
      state.maximized = true;
      state.element.classList.add("mobile-window", "maximized");
      state.element.style.left = "0";
      state.element.style.top = "0";
      state.element.style.width = "100vw";
      state.element.style.height =
        "calc(100dvh - var(--mobile-taskbar-height, 56px))";
    }

    function syncViewportMode() {
      const wasMobile = mobileMode;
      mobileMode = mobileQuery.matches;
      updateViewportAttributes();

      windows.forEach((state) => {
        state.element.classList.toggle("mobile-window", mobileMode);
        if (!state.open || state.minimized) return;

        if (mobileMode) {
          applyMobileWindowBounds(state);
        } else if (wasMobile) {
          applyDesktopInitialBounds(state);
        }
      });

      updateTaskbar();
    }

    function getWindowBounds(element) {
      const rect = element.getBoundingClientRect();
      return {
        left: rect.left,
        top: rect.top,
        width: rect.width,
        height: rect.height,
      };
    }

    function applyWindowBounds(element, bounds) {
      element.style.left = bounds.left + "px";
      element.style.top = bounds.top + "px";
      element.style.width = bounds.width + "px";
      element.style.height = bounds.height + "px";
    }

    function unmaximizeWindow(state, bounds = state.prevBounds) {
      if (!bounds) return;
      applyWindowBounds(state.element, bounds);
      state.element.style.zIndex = ++topZ;
      state.maximized = false;
      state.element.classList.remove("maximized");
    }

    function updateTaskbar() {
      if (!taskbarApps) return;
      taskbarApps.innerHTML = "";

      windows.forEach((state) => {
        if (!state.open) return;

        const btn = document.createElement("button");
        btn.type = "button";
        btn.className =
          "taskbar-app active" +
          (state.element.classList.contains("focused") ? " focused" : "");
        btn.innerHTML =
          state.element.querySelector(".window-titlebar-icon")?.innerHTML +
          "<span>" +
          state.title.split("-")[0].trim() +
          "</span>";
        btn.addEventListener("click", () => {
          if (state.minimized) {
            restoreWindow(state.appId);
          } else if (isMobileMode()) {
            focusWindow(state.appId);
          } else if (state.element.classList.contains("focused")) {
            minimizeWindow(state.appId);
          } else {
            focusWindow(state.appId);
          }
        });
        taskbarApps.appendChild(btn);
      });
    }

    function animateSkillBars(win) {
      window.setTimeout(() => {
        win.querySelectorAll(".skill-bar-fill").forEach((bar) => {
          bar.style.width = bar.dataset.level + "%";
        });
      }, 300);
    }

    // Open welcome window on first visit
    const firstVisitKey = "pepodev.hasVisited";
    const hasVisited = localStorage.getItem(firstVisitKey);

    if (!hasVisited) {
      // Delay slightly to ensure DOM is fully ready
      setTimeout(() => {
        if (userInteracted || userOpenedWindow || getActiveWindow()) {
          localStorage.setItem(firstVisitKey, "true");
          return;
        }

        openWindow("welcome");
        localStorage.setItem(firstVisitKey, "true");
      }, 1500);
    }
  });
</script>
