---
interface Props {
	date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString('en-us', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Render the same calendar day whatever the build machine's time zone.
			timeZone: 'UTC',
		})
	}
</time>
